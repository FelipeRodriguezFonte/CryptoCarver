<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="padesRoot" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cryptocarver.ui.PadesController" spacing="10" styleClass="content-container-vbox">
    <HBox alignment="CENTER_RIGHT">
        <Button text="Clear" onAction="#handleClear" styleClass="secondary-button"/>
        <Button text="Reset Defaults" onAction="#handleReset" styleClass="secondary-button"/>
    </HBox>
    <Accordion fx:id="padesAccordion" styleClass="module-accordion">
        <panes>
            <TitledPane text="PDF Advanced Electronic Signatures (PAdES)" expanded="true">
                <VBox spacing="12" styleClass="module-pane-content">
                    <Label text="PAdES laboratory — local PKCS#12 signing key" styleClass="helper-text"/>
                    <Label text="Signs PDF incrementally as Baseline-B, or Baseline-T when timestamping is explicitly enabled. It never overwrites an output file. 64 MiB limit." wrapText="true" styleClass="helper-text" style="-fx-text-fill: #9a3412;"/>

                    <GridPane hgap="10" vgap="9" styleClass="form-grid">
                        <columnConstraints>
                            <ColumnConstraints minWidth="120" prefWidth="120"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Input PDF:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                        <HBox spacing="10" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <TextField fx:id="padesInputPathField" promptText="PDF input path" HBox.hgrow="ALWAYS" styleClass="form-field"/>
                            <Button text="Choose PDF…" onAction="#handleChooseInput" styleClass="secondary-button"/>
                        </HBox>

                        <Label text="Output PDF:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                        <HBox spacing="10" GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <TextField fx:id="padesOutputPathField" promptText="New signed PDF output path" HBox.hgrow="ALWAYS" styleClass="form-field"/>
                            <Button text="Choose output…" onAction="#handleChooseOutput" styleClass="secondary-button"/>
                        </HBox>
                    </GridPane>

                    <Label text="Signing Key Source:" styleClass="form-label"/>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <RadioButton fx:id="padesSourceLocalRadio" text="Local PKCS#12" selected="true" onAction="#handleSourceChanged">
                            <toggleGroup><ToggleGroup fx:id="padesSourceToggleGroup"/></toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="padesSourcePkcs11Radio" text="PKCS#11 Token" toggleGroup="$padesSourceToggleGroup" onAction="#handleSourceChanged"/>
                    </HBox>

                    <HBox fx:id="padesLocalKeyBox" spacing="10">
                        <TextField fx:id="padesPkcs12PathField" promptText="PKCS#12 (.p12 / .pfx) path" HBox.hgrow="ALWAYS" styleClass="form-field"/>
                        <Button text="Choose key…" onAction="#handleChoosePkcs12" styleClass="secondary-button"/>
                        <PasswordField fx:id="padesPasswordField" promptText="PKCS#12 password" prefWidth="180" styleClass="form-field"/>
                    </HBox>

                    <HBox fx:id="padesPkcs11Box" spacing="10" visible="false" managed="false">
                        <ComboBox fx:id="padesPkcs11AliasCombo" promptText="Token signing alias" HBox.hgrow="ALWAYS" styleClass="form-field"/>
                        <Button text="Load Token Keys" onAction="#handleLoadTokenKeys" styleClass="secondary-button"/>
                    </HBox>

                    <Separator/>

                    <CheckBox fx:id="padesTimestampCheck" text="Add RFC 3161 signature timestamp (PAdES-T)" onAction="#handleTimestampOptionChanged"/>
                    <HBox fx:id="padesTsaBox" spacing="10" visible="false" managed="false" alignment="CENTER_LEFT">
                        <Label text="TSA URL:" styleClass="form-label"/>
                        <TextField fx:id="padesTsaUrlField" promptText="https://tsa.example.test" HBox.hgrow="ALWAYS" styleClass="form-field"/>
                    </HBox>

                    <CheckBox fx:id="padesVisibleSignatureCheck" text="Add visible signature text" onAction="#handleVisibleSignatureOptionChanged"/>
                    <VBox fx:id="padesVisibleSignatureBox" spacing="8" visible="false" managed="false" style="-fx-padding: 0 0 0 16;">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="Page" styleClass="form-label"/><TextField fx:id="padesVisiblePageField" text="1" prefWidth="45" styleClass="form-field"/>
                            <Label text="X" styleClass="form-label"/><TextField fx:id="padesVisibleXField" text="40" prefWidth="55" styleClass="form-field"/>
                            <Label text="Y" styleClass="form-label"/><TextField fx:id="padesVisibleYField" text="40" prefWidth="55" styleClass="form-field"/>
                            <Label text="Width" styleClass="form-label"/><TextField fx:id="padesVisibleWidthField" text="220" prefWidth="55" styleClass="form-field"/>
                            <Label text="Height" styleClass="form-label"/><TextField fx:id="padesVisibleHeightField" text="60" prefWidth="55" styleClass="form-field"/>
                            <Label text="(PDF points; lower-left origin)" styleClass="helper-text"/>
                        </HBox>
                        <TextField fx:id="padesVisibleTextField" text="Signed with CryptoCarver laboratory" promptText="Visible signature text" styleClass="form-field"/>
                    </VBox>

                    <Separator/>

                    <Label text="Validation Configuration (local truststore/CRL only)" styleClass="form-label"/>

                    <GridPane hgap="10" vgap="9" styleClass="form-grid">
                        <columnConstraints>
                            <ColumnConstraints minWidth="120" prefWidth="120"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Truststore:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                        <HBox spacing="10" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <TextField fx:id="padesTrustStorePathField" promptText="Truststore (.p12 / .pfx / .jks), optional" HBox.hgrow="ALWAYS" styleClass="form-field"/>
                            <Button text="Choose..." onAction="#handleChooseTrustStore" styleClass="secondary-button"/>
                            <PasswordField fx:id="padesTrustStorePasswordField" promptText="Password" prefWidth="160" styleClass="form-field"/>
                        </HBox>

                        <Label text="CRL Evidence:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                        <HBox spacing="10" GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <TextField fx:id="padesCrlEvidenceField" editable="false" promptText="No local CRL evidence selected" HBox.hgrow="ALWAYS" styleClass="form-field"/>
                            <Button text="Choose..." onAction="#handleChooseCrlEvidence" styleClass="secondary-button"/>
                        </HBox>
                    </GridPane>

                    <FlowPane prefWrapLength="900" styleClass="responsive-action-bar">
                        <Button text="Sign PDF" onAction="#handleSign" styleClass="action-button,primary-action"/>
                        <Button text="Inspect Signatures" onAction="#handleInspect" styleClass="secondary-button"/>
                        <Button text="Validate PDF" onAction="#handleValidate" styleClass="secondary-button"/>
                        <Button text="Save DSS Reports…" onAction="#handleSaveValidationReports" styleClass="secondary-button"/>
                    </FlowPane>

                    <TextArea fx:id="padesResultArea" editable="false" prefRowCount="6" wrapText="true" styleClass="result-area,monospace-field" promptText="PAdES result will appear here..."/>
                </VBox>
            </TitledPane>
        </panes>
    </Accordion>
</VBox>
