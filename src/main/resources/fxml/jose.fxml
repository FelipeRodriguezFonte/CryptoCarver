<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.TextFlow?>

<VBox fx:id="joseContainer" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cryptocarver.ui.JOSEController" managed="false" visible="false" spacing="10" styleClass="content-container-vbox,jose-module">

    <!-- JWT SECTION -->
    <VBox fx:id="jwtSection" spacing="14" managed="false" visible="false">
        <Label text="JSON Web Token (JWT)" styleClass="section-header"/>

        <Accordion styleClass="module-accordion">
            <panes>
                <!-- GENERATE PANE -->
                <TitledPane text="Generate JWT" expanded="true">
                    <VBox spacing="12" styleClass="module-pane-content">
                        <GridPane hgap="10" vgap="9" styleClass="form-grid">
                            <columnConstraints>
                                <ColumnConstraints minWidth="150" prefWidth="150"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="Algorithm:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                            <HBox spacing="10" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                <ComboBox fx:id="jwtAlgoCombo" prefWidth="150" styleClass="form-field"/>
                                <Label text="Template:" styleClass="form-label"/>
                                <ComboBox fx:id="jwtTemplateCombo" prefWidth="150" promptText="Select Template..." styleClass="form-field"/>
                            </HBox>

                            <Label text="Serialization:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                            <HBox spacing="10" GridPane.rowIndex="1" GridPane.columnIndex="1" alignment="CENTER_LEFT">
                                <ComboBox fx:id="jwsSerializationCombo" prefWidth="150" promptText="Compact" styleClass="form-field"/>
                                <CheckBox fx:id="jwsUnencodedPayloadCheck" text="Unencoded Payload (b64=false)">
                                    <tooltip><Tooltip text="WARNING: May cause interoperability issues with standard parsers"/></tooltip>
                                </CheckBox>
                            </HBox>

                            <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="2" GridPane.columnIndex="0">
                                <Label text="Signing Key 1:" styleClass="form-label"/>
                            </HBox>
                            <VBox spacing="5" GridPane.rowIndex="2" GridPane.columnIndex="1">
                                <FlowPane styleClass="responsive-action-bar">
                                    <Button text="Import from File..." onAction="#handleLoadJWTKey" styleClass="secondary-button"/>
                                    <MenuButton fx:id="jwtKeyShelfMenu" text="Use from Shelf" styleClass="secondary-button" onShowing="#handlePopulateJwtKeyShelf"/>
                                </FlowPane>
                                <TextArea fx:id="jwtKeyArea" promptText="Enter secret (for HMAC) or paste Private Key PEM (for RSA/EC)..." prefRowCount="3" styleClass="monospace-field"/>
                            </VBox>
                        </GridPane>

                        <TitledPane text="Signer 2 (Only for General JSON)" expanded="false">
                            <VBox spacing="10" styleClass="module-pane-content">
                                <GridPane hgap="10" vgap="9" styleClass="form-grid">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="150" prefWidth="150"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                    </columnConstraints>
                                    <Label text="Algorithm 2:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                                    <ComboBox fx:id="jwtAlgoCombo2" prefWidth="150" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="form-field"/>
                                    <Label text="Signing Key 2:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                                    <TextArea fx:id="jwtKeyArea2" promptText="Optional. Required if using General JSON with two signers..." prefRowCount="2" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="monospace-field"/>
                                </GridPane>
                            </VBox>
                        </TitledPane>

                        <TitledPane text="Claims Builder (Optional)" expanded="false">
                            <VBox spacing="10" styleClass="module-pane-content">
                                <GridPane hgap="10" vgap="9" styleClass="form-grid">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="120" prefWidth="120"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                    </columnConstraints>
                                    <Label text="Issuer (iss):" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                                    <TextField fx:id="jwtIssField" promptText="e.g. auth.server" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="form-field"/>

                                    <Label text="Subject (sub):" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                                    <TextField fx:id="jwtSubField" promptText="e.g. user_123" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="form-field"/>

                                    <Label text="Audience (aud):" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
                                    <TextField fx:id="jwtAudField" promptText="e.g. my-api" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="form-field"/>

                                    <Label text="Valid for:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="form-label"/>
                                    <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="3" GridPane.columnIndex="1">
                                        <TextField fx:id="jwtExpField" promptText="1" prefWidth="60" styleClass="form-field"/>
                                        <Label text="hours"/>
                                        <Button text="Apply to Payload" onAction="#handleApplyJWTClaims" styleClass="secondary-button"/>
                                    </HBox>
                                </GridPane>
                            </VBox>
                        </TitledPane>

                        <Label text="Payload (JSON):" styleClass="form-label"/>
                        <TextArea fx:id="jwtPayloadArea" promptText='{"sub":"1234567890", "name":"John Doe", "iat":1516239022}' prefRowCount="4" styleClass="monospace-field"/>

                        <Button text="Generate Signed JWT" onAction="#handleGenerateSignedJWT" styleClass="action-button,primary-action"/>

                        <Label text="Output:" styleClass="form-label"/>
                        <TextArea fx:id="jwtOutputArea" promptText="Generated JWT will appear here..." prefRowCount="3" styleClass="result-area,monospace-field" editable="false" wrapText="true"/>
                    </VBox>
                </TitledPane>

                <!-- VALIDATE PANE -->
                <TitledPane text="Validate &amp; Decode JWT">
                    <VBox spacing="12" styleClass="module-pane-content">
                        <Label text="JWT Token:" styleClass="form-label"/>
                        <TextArea fx:id="jwtValidateTokenArea" promptText="Paste JWT here..." prefRowCount="3" styleClass="monospace-field" wrapText="true"/>

                        <GridPane hgap="10" vgap="9" styleClass="form-grid">
                            <columnConstraints>
                                <ColumnConstraints minWidth="150" prefWidth="150"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>

                            <VBox spacing="5" GridPane.rowIndex="0" GridPane.columnIndex="0">
                                <Label text="Verification Key:" styleClass="form-label"/>
                            </VBox>
                            <VBox spacing="5" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                <FlowPane styleClass="responsive-action-bar">
                                    <Button text="Import from File..." onAction="#handleLoadJWTValidateKey" styleClass="secondary-button"/>
                                    <MenuButton fx:id="jwtValidateKeyShelfMenu" text="Use from Shelf" styleClass="secondary-button" onShowing="#handlePopulateJwtValidateKeyShelf"/>
                                </FlowPane>
                                <TextArea fx:id="jwtValidateKeyArea" promptText="Enter secret (for HMAC) or paste Public Key PEM (for RSA/EC)..." prefRowCount="3" styleClass="monospace-field"/>
                            </VBox>
                        </GridPane>

                        <TitledPane text="Advanced Validation Settings" expanded="false">
                            <VBox spacing="10" styleClass="module-pane-content">
                                <GridPane hgap="10" vgap="9" styleClass="form-grid">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="150" prefWidth="150"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                    </columnConstraints>

                                    <Label text="Expected Issuer (iss):" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                                    <TextField fx:id="jwtExpectedIssField" promptText="e.g. auth.server" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="form-field"/>

                                    <Label text="Expected Audience (aud):" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                                    <TextField fx:id="jwtExpectedAudField" promptText="e.g. my-api" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="form-field"/>

                                    <Label text="Clock Skew (sec):" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
                                    <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="2" GridPane.columnIndex="1">
                                        <TextField fx:id="jwtClockSkewField" text="60" prefWidth="80" styleClass="form-field"/>
                                        <CheckBox fx:id="jwtCheckExpiryCheck" text="Check Expiration (exp/nbf/iat)" selected="true"/>
                                        <CheckBox fx:id="jwtOidcStrictCheck" text="Strict OIDC Profile"/>
                                    </HBox>
                                </GridPane>
                            </VBox>
                        </TitledPane>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button text="Verify &amp; Decode" onAction="#handleValidateJWT" styleClass="action-button,primary-action"/>
                            <Label fx:id="jwtStatusLabel" text="" styleClass="helper-text"/>
                        </HBox>

                        <GridPane hgap="10" vgap="9" styleClass="form-grid">
                            <columnConstraints>
                                <ColumnConstraints minWidth="150" prefWidth="150"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <Label text="Decoded Header:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                            <TextArea fx:id="jwtDecodedHeaderArea" promptText="Header JSON..." prefRowCount="3" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="result-area,monospace-field" editable="false"/>

                            <Label text="Decoded Payload:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                            <TextArea fx:id="jwtDecodedPayloadArea" promptText="Payload JSON..." prefRowCount="5" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="result-area,monospace-field" editable="false"/>
                        </GridPane>
                    </VBox>
                </TitledPane>

                <!-- DETACHED JWS PANE -->
                <TitledPane text="JWS Detached (External Payload)">
                    <VBox spacing="12" styleClass="module-pane-content">
                        <GridPane hgap="10" vgap="9" styleClass="form-grid">
                            <columnConstraints>
                                <ColumnConstraints minWidth="150" prefWidth="150"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <Label text="Algorithm:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                            <ComboBox fx:id="detachedAlgoCombo" prefWidth="180" promptText="HS256 / RS256 / ES256" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="form-field"/>

                            <Label text="Serialization:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                            <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="1" GridPane.columnIndex="1">
                                <ComboBox fx:id="detachedSerializationCombo" prefWidth="150" promptText="Compact" styleClass="form-field"/>
                                <CheckBox fx:id="detachedUnencodedCheck" text="b64=false"/>
                            </HBox>

                            <Label text="External Payload:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
                            <TextArea fx:id="detachedPayloadArea" prefRowCount="3" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="monospace-field"/>

                            <Label text="Signing Key:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="form-label"/>
                            <TextArea fx:id="detachedSigningKeyArea" promptText="Secret or Private PEM" prefRowCount="3" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="monospace-field"/>

                            <Label text="Verification Key:" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="form-label"/>
                            <TextArea fx:id="detachedVerificationKeyArea" promptText="Same Secret or Public PEM" prefRowCount="3" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="monospace-field"/>
                        </GridPane>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button text="Generate Detached JWS" onAction="#handleGenerateDetachedJWS" styleClass="action-button,primary-action"/>
                            <Button text="Verify Detached JWS" onAction="#handleVerifyDetachedJWS" styleClass="secondary-button"/>
                        </HBox>

                        <Label text="Output / Result:" styleClass="form-label"/>
                        <TextArea fx:id="detachedTokenArea" prefRowCount="3" promptText="header..signature" styleClass="result-area,monospace-field" wrapText="true"/>
                        <Label fx:id="detachedStatusLabel" styleClass="helper-text"/>
                    </VBox>
                </TitledPane>
            </panes>
        </Accordion>
    </VBox>

    <!-- JWK SECTION -->
    <VBox fx:id="jwkSection" spacing="14" managed="false" visible="false">
        <Label text="JSON Web Keys (JWK)" styleClass="section-header"/>

        <Accordion styleClass="module-accordion">
            <panes>
                <TitledPane text="JWK Tools" expanded="true">
                    <VBox spacing="12" styleClass="module-pane-content">
                        <GridPane hgap="10" vgap="9" styleClass="form-grid">
                            <columnConstraints>
                                <ColumnConstraints minWidth="120" prefWidth="120"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="Key Type:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                            <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                <ComboBox fx:id="jwkKeyTypeCombo" prefWidth="120" styleClass="form-field"/>
                                <Label text="Key ID (kid):" styleClass="form-label"/>
                                <TextField fx:id="jwkKeyIdField" promptText="Optional / Auto" styleClass="form-field"/>
                            </HBox>

                            <Label fx:id="jwkInputLabel" text="Input:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                            <TextArea fx:id="jwkInputArea" promptText="Paste PEM Key or JWK JSON..." prefRowCount="4" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="monospace-field"/>
                        </GridPane>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button fx:id="pemToJwkBtn" text="PEM -> JWK" onAction="#handlePemToJwk" styleClass="action-button,primary-action"/>
                            <Button fx:id="jwkToPemBtn" text="JWK -> PEM" onAction="#handleJwkToPem" styleClass="secondary-button"/>
                            <Button text="Calc Thumbprint" onAction="#handleCalculateThumbprint" styleClass="secondary-button"/>
                        </HBox>

                        <Label text="Output:" styleClass="form-label"/>
                        <TextArea fx:id="jwkOutputArea" promptText="Result..." prefRowCount="6" styleClass="result-area,monospace-field" editable="false"/>
                    </VBox>
                </TitledPane>

                <TitledPane text="JWK Set (JWKS)">
                    <VBox spacing="12" styleClass="module-pane-content">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button text="New JWKS" onAction="#handleNewJWKS" styleClass="secondary-button"/>
                            <Button text="Load JWKS..." onAction="#handleLoadJWKS" styleClass="link-button"/>
                        </HBox>

                        <TextArea fx:id="jwksArea" promptText="{ &quot;keys&quot;: [] }" prefRowCount="10" styleClass="monospace-field"/>

                        <TitledPane text="Key Rotation &amp; Operations" expanded="true">
                            <VBox spacing="12" styleClass="module-pane-content">
                                <Label text="Simulate Key Rotation:" styleClass="form-label"/>
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <ComboBox fx:id="jwksRotateAlgoCombo" prefWidth="120" styleClass="form-field"/>
                                    <Button text="Add New Key to Set" onAction="#handleRotateKey" styleClass="action-button,primary-action"/>
                                </HBox>
                                <Separator/>
                                <Label text="Public Export:" styleClass="form-label"/>
                                <Button text="Show Public JWKS Only" onAction="#handleExportPublicJWKS" styleClass="secondary-button"/>
                            </VBox>
                        </TitledPane>
                    </VBox>
                </TitledPane>
            </panes>
        </Accordion>
    </VBox>

    <!-- JWE SECTION -->
    <VBox fx:id="jweSection" spacing="14" managed="false" visible="false">
        <Label text="JSON Web Encryption (JWE)" styleClass="section-header"/>

        <Accordion styleClass="module-accordion">
            <panes>
                <TitledPane text="Encrypt" expanded="true">
                    <VBox spacing="12" styleClass="module-pane-content">
                        <GridPane hgap="10" vgap="9" styleClass="form-grid">
                            <columnConstraints>
                                <ColumnConstraints minWidth="150" prefWidth="150"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="Key Management:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                            <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                <ComboBox fx:id="jweKeyAlgoCombo" prefWidth="150" styleClass="form-field"/>
                                <Label text="Content:" styleClass="form-label"/>
                                <ComboBox fx:id="jweContentAlgoCombo" prefWidth="150" styleClass="form-field"/>
                                <CheckBox fx:id="jweCompressCheck" text="Compress (DEF)"/>
                            </HBox>

                            <VBox spacing="5" GridPane.rowIndex="1" GridPane.columnIndex="0">
                                <Label text="Recipient Public Key:" styleClass="form-label"/>
                            </VBox>
                            <VBox spacing="5" GridPane.rowIndex="1" GridPane.columnIndex="1">
                                <FlowPane styleClass="responsive-action-bar">
                                    <Button text="Import from File..." onAction="#handleLoadJWEPublicKey" styleClass="secondary-button"/>
                                    <MenuButton fx:id="jwePubKeyShelfMenu" text="Use from Shelf" styleClass="secondary-button" onShowing="#handlePopulateJwePubKeyShelf"/>
                                </FlowPane>
                                <TextArea fx:id="jwePublicKeyArea" promptText="Paste RSA Public Key PEM..." prefRowCount="3" styleClass="monospace-field"/>
                            </VBox>

                            <Label text="Payload (Any String):" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
                            <TextArea fx:id="jwePayloadArea" promptText="Secret Data..." prefRowCount="3" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="monospace-field"/>
                        </GridPane>

                        <Button text="Encrypt &amp; Generate JWE" onAction="#handleGenerateJWE" styleClass="action-button,primary-action"/>

                        <Label text="Output (JWE):" styleClass="form-label"/>
                        <TextArea fx:id="jweOutputArea" promptText="Generated JWE..." prefRowCount="3" styleClass="result-area,monospace-field" editable="false" wrapText="true"/>
                    </VBox>
                </TitledPane>

                <TitledPane text="Decrypt">
                    <VBox spacing="12" styleClass="module-pane-content">
                        <Label text="JWE Token:" styleClass="form-label"/>
                        <TextArea fx:id="jweInputArea" promptText="Paste JWE here..." prefRowCount="3" styleClass="monospace-field" wrapText="true"/>

                        <GridPane hgap="10" vgap="9" styleClass="form-grid">
                            <columnConstraints>
                                <ColumnConstraints minWidth="150" prefWidth="150"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <VBox spacing="5" GridPane.rowIndex="0" GridPane.columnIndex="0">
                                <Label text="Private Key (PEM):" styleClass="form-label"/>
                            </VBox>
                            <VBox spacing="5" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                <FlowPane styleClass="responsive-action-bar">
                                    <Button text="Import from File..." onAction="#handleLoadJWEPrivateKey" styleClass="secondary-button"/>
                                    <MenuButton fx:id="jwePrivKeyShelfMenu" text="Use from Shelf" styleClass="secondary-button" onShowing="#handlePopulateJwePrivKeyShelf"/>
                                </FlowPane>
                                <TextArea fx:id="jwePrivateKeyArea" promptText="Paste RSA Private Key PEM..." prefRowCount="3" styleClass="monospace-field"/>
                            </VBox>
                        </GridPane>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button text="Decrypt JWE" onAction="#handleDecryptJWE" styleClass="action-button,primary-action"/>
                            <Label fx:id="jweStatusLabel" text="" styleClass="helper-text"/>
                        </HBox>

                        <GridPane hgap="10" vgap="9" styleClass="form-grid">
                            <columnConstraints>
                                <ColumnConstraints minWidth="150" prefWidth="150"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <Label text="Decoded Header:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                            <TextArea fx:id="jweDecodedHeaderArea" promptText="Header JSON..." prefRowCount="3" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="result-area,monospace-field" editable="false"/>

                            <Label text="Decoded Payload:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                            <TextArea fx:id="jweDecodedPayloadArea" promptText="Payload..." prefRowCount="3" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="result-area,monospace-field" editable="false"/>
                        </GridPane>

                        <TitledPane text="Visual Breakdown (Layer 6)" expanded="false">
                            <VBox spacing="8" styleClass="module-pane-content">
                                <GridPane hgap="10" vgap="9" styleClass="form-grid">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="180" prefWidth="180"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                    </columnConstraints>

                                    <Label text="Protected Header:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                                    <TextArea fx:id="jweHeaderArea" prefRowCount="2" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="monospace-field" editable="false"/>

                                    <Label text="Encrypted Key:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                                    <TextArea fx:id="jweEncryptedKeyArea" prefRowCount="2" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="monospace-field" editable="false"/>

                                    <Label text="Decrypted CEK (Hex):" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
                                    <TextArea fx:id="jweDecryptedKeyArea" prefRowCount="2" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="monospace-field" editable="false"/>

                                    <Label text="Initialization Vector (IV):" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="form-label"/>
                                    <TextArea fx:id="jweIVArea" prefRowCount="2" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="monospace-field" editable="false"/>

                                    <Label text="Ciphertext (Truncated):" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="form-label"/>
                                    <TextArea fx:id="jweCiphertextArea" prefRowCount="2" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="monospace-field" editable="false"/>

                                    <Label text="Authentication Tag:" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="form-label"/>
                                    <TextArea fx:id="jweAuthTagArea" prefRowCount="2" GridPane.rowIndex="5" GridPane.columnIndex="1" styleClass="monospace-field" editable="false"/>
                                </GridPane>
                            </VBox>
                        </TitledPane>
                    </VBox>
                </TitledPane>

                <TitledPane text="Nested (Sign + Encrypt)">
                    <VBox spacing="12" styleClass="module-pane-content">
                        <Label text="1. Inner Token (Signed):" style="-fx-font-weight: bold; -fx-text-fill: #a0aec0;"/>
                        <GridPane hgap="10" vgap="9" styleClass="form-grid">
                            <columnConstraints>
                                <ColumnConstraints minWidth="150" prefWidth="150"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <Label text="Sign Algo:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                            <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                <ComboBox fx:id="nestedSignAlgoCombo" prefWidth="120" styleClass="form-field"/>
                                <Label text="Signing Key:" styleClass="form-label"/>
                                <Button text="Import..." onAction="#handleLoadNestedSigningKey" styleClass="link-button"/>
                            </HBox>

                            <Label text="Signing Key Value:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                            <TextArea fx:id="nestedSigningKeyArea" promptText="Private Key or Secret..." prefRowCount="2" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="monospace-field"/>

                            <Label text="Payload:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
                            <TextArea fx:id="nestedPayloadArea" promptText="{ 'sub': 'user' }..." prefRowCount="2" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="monospace-field"/>
                        </GridPane>

                        <Separator/>

                        <Label text="2. Outer Token (Encrypted):" style="-fx-font-weight: bold; -fx-text-fill: #a0aec0;"/>
                        <GridPane hgap="10" vgap="9" styleClass="form-grid">
                            <columnConstraints>
                                <ColumnConstraints minWidth="150" prefWidth="150"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <Label text="Key Algo:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                            <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                <ComboBox fx:id="nestedKeyAlgoCombo" prefWidth="120" styleClass="form-field"/>
                                <Label text="Content Algo:" styleClass="form-label"/>
                                <ComboBox fx:id="nestedContentAlgoCombo" prefWidth="120" styleClass="form-field"/>
                                <CheckBox fx:id="nestedCompressCheck" text="Compress (DEF)"/>
                            </HBox>

                            <VBox spacing="5" GridPane.rowIndex="1" GridPane.columnIndex="0">
                                <Label text="Recipient Public Key:" styleClass="form-label"/>
                            </VBox>
                            <VBox spacing="5" GridPane.rowIndex="1" GridPane.columnIndex="1">
                                <Button text="Import..." onAction="#handleLoadNestedEncryptionKey" styleClass="link-button"/>
                                <TextArea fx:id="nestedEncryptionKeyArea" promptText="RSA Public Key (Encryption) / RSA Private Key (Decryption)..." prefRowCount="2" styleClass="monospace-field"/>
                            </VBox>
                        </GridPane>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button text="Generate Nested JWT" onAction="#handleGenerateNestedJWT" styleClass="action-button,primary-action"/>
                            <Button text="Decrypt &amp; Verify Nested JWT" onAction="#handleVerifyNestedJWT" styleClass="secondary-button"/>
                            <Label fx:id="nestedStatusLabel" styleClass="helper-text"/>
                        </HBox>

                        <GridPane hgap="10" vgap="9" styleClass="form-grid">
                            <columnConstraints>
                                <ColumnConstraints minWidth="150" prefWidth="150"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <Label text="Token (Input/Output):" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                            <TextArea fx:id="nestedOutputArea" promptText="Nested Token..." prefRowCount="3" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="monospace-field" wrapText="true"/>

                            <Label text="Inner Payload (Output):" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                            <TextArea fx:id="nestedPayloadOutputArea" promptText="Decrypted &amp; Verified Payload..." prefRowCount="3" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="result-area,monospace-field" editable="false"/>
                        </GridPane>
                    </VBox>
                </TitledPane>
            </panes>
        </Accordion>
    </VBox>

    <!-- JWA SECTION -->
    <VBox fx:id="jwaSection" spacing="14" managed="false" visible="false">
        <Label text="JSON Web Algorithms (JWA)" styleClass="section-header"/>
        <Label text="Supported Algorithms Registry" styleClass="helper-text"/>

        <TableView fx:id="jwaTable" styleClass="code-area" VBox.vgrow="ALWAYS" prefHeight="400">
            <columns>
                <TableColumn fx:id="jwaNameCol" text="Algorithm" prefWidth="120"/>
                <TableColumn fx:id="jwaTypeCol" text="Type" prefWidth="120"/>
                <TableColumn fx:id="jwaDescCol" text="Description" prefWidth="350"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

    <!-- INSPECTOR SECTION -->
    <VBox fx:id="inspectorSection" spacing="14" managed="false" visible="false">
        <Label text="Unified Token Inspector" styleClass="section-header"/>
        <Label text="Paste any JOSE token (JWS or JWE) to see a visual breakdown of its components." styleClass="helper-text"/>

        <FlowPane prefWrapLength="900" styleClass="responsive-action-bar">
            <Button text="Analyze Token" onAction="#handleInspectToken" styleClass="action-button,primary-action"/>
            <Button text="Expand Report" onAction="#handleOpenExpandedInspectorReport" styleClass="secondary-button"/>
            <Button text="Copy Report" onAction="#handleCopyInspectorOutput" styleClass="secondary-button"/>
            <Button text="Clear" onAction="#handleClearInspector" styleClass="secondary-button"/>
        </FlowPane>

        <TextArea fx:id="inspectorInputArea" promptText="Paste JWS (eyJ...) or JWE (ey...) here..." prefRowCount="4" styleClass="monospace-field" wrapText="true"/>

        <Separator/>
        <Label text="Visual Breakdown:" styleClass="form-label"/>

        <ScrollPane fitToWidth="true" styleClass="edge-to-edge" prefHeight="400">
             <TextFlow fx:id="inspectorOutputFlow" styleClass="code-area" style="-fx-padding: 10; -fx-background-color: #1e293b; -fx-border-color: #334155; -fx-border-radius: 4; -fx-background-radius: 4;"/>
        </ScrollPane>
    </VBox>

</VBox>
