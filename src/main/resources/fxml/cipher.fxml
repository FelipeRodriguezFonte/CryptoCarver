<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.cryptocarver.ui.ResultPanel?>

<VBox fx:id="cipherRoot" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cryptocarver.ui.CipherController"
      managed="false" visible="false" spacing="14" styleClass="content-container-vbox,cipher-module">
    <VBox spacing="4" styleClass="page-header">
        <Label text="Data Encryption &amp; Decryption" styleClass="content-title-label,page-title"/>
        <Label text="Configure an operation, review the payload, and run encryption or decryption from the active card." styleClass="helper-text,page-description" wrapText="true"/>
    </VBox>

    <!-- Keep the payload workbench above the expandable configuration panes. -->
    <VBox spacing="10" styleClass="cipher-io-card">
        <GridPane hgap="12" styleClass="cipher-io-grid">
            <columnConstraints>
                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
            </columnConstraints>
            <VBox spacing="7" styleClass="cipher-io-column" GridPane.columnIndex="0">
                <Label text="Input data" styleClass="cipher-io-label"/>
                <TextArea fx:id="cipherInputArea" prefHeight="160" wrapText="true"
                          VBox.vgrow="ALWAYS" styleClass="cipher-io-area,cipher-monospace"/>
            </VBox>
            <VBox spacing="7" styleClass="cipher-io-column" GridPane.columnIndex="1">
                <Label text="Output result" styleClass="cipher-io-label"/>
                <TextArea fx:id="cipherOutputArea" prefHeight="160" editable="false" wrapText="true"
                          VBox.vgrow="ALWAYS" styleClass="cipher-io-area,cipher-output-area,cipher-monospace"/>
            </VBox>
        </GridPane>
    </VBox>

    <ResultPanel fx:id="cipherResultPanel"/>

    <Accordion styleClass="cipher-accordion">
        <panes>
            <TitledPane text="🔒 Symmetric Cipher (AES, DES, etc.)" expanded="true">
                <VBox spacing="14" styleClass="cipher-pane-content" maxWidth="720">

                    <!-- Template Selection Bar -->
                    <FlowPane prefWrapLength="900" styleClass="template-toolbar">
                        <Label text="Apply Template:" styleClass="form-label"/>
                        <ComboBox fx:id="cipherTemplateCombo" prefWidth="360" promptText="Select a template..." styleClass="form-field"/>
                        <Button text="Apply" onAction="#handleApplyCipherTemplate" styleClass="action-button-primary ux-inline-401c00305b"/>
                        <MenuButton text="Manage Template" styleClass="secondary-button ux-inline-401c00305b">
                            <items>
                                <MenuItem text="Save Current as Personal Template..." onAction="#handleSaveCipherTemplate"/>
                                <MenuItem text="Export Selected Template..." onAction="#handleExportCipherTemplate"/>
                                <MenuItem text="Import Template File..." onAction="#handleImportCipherTemplate"/>
                                <MenuItem text="Delete Selected Personal Template" onAction="#handleDeleteCipherTemplate"/>
                            </items>
                        </MenuButton>
                        <Button text="Reset Defaults" onAction="#handleResetCipherDefaults" styleClass="secondary-button ux-inline-401c00305b"/>
                    </FlowPane>

                    <!-- Group 1: Algorithm & Mode -->
                    <VBox styleClass="form-group-box">
                        <Label text="Algorithm &amp; Mode" styleClass="form-group-title"/>
                        <GridPane hgap="12" vgap="8">
                            <columnConstraints>
                                <ColumnConstraints minWidth="130" prefWidth="130" halignment="RIGHT"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <Label text="Algorithm:" styleClass="cipher-field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <ComboBox fx:id="symmetricAlgorithmCombo" maxWidth="Infinity" styleClass="cipher-field" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            <Label text="Mode:" styleClass="cipher-field-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <ComboBox fx:id="cipherModeCombo" maxWidth="Infinity" styleClass="cipher-field" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            <Label text="Padding:" styleClass="cipher-field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <ComboBox fx:id="paddingCombo" maxWidth="Infinity" styleClass="cipher-field" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        </GridPane>
                    </VBox>

                    <!-- Group 2: Key Source -->
                    <VBox styleClass="form-group-box">
                        <Label text="Key Source" styleClass="form-group-title"/>
                        <GridPane hgap="12" vgap="8">
                            <columnConstraints>
                                <ColumnConstraints minWidth="130" prefWidth="130" halignment="RIGHT"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <Label text="Key Source *:" styleClass="cipher-field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <VBox spacing="2" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <ComboBox fx:id="symKeySourceCombo" prefWidth="150" minWidth="150" styleClass="cipher-field"/>
                                    <StackPane HBox.hgrow="ALWAYS">
                                        <TextField fx:id="symmetricKeyField" promptText="Enter key in hex (required)..." maxWidth="Infinity" styleClass="cipher-field,cipher-monospace"/>
                                        <ComboBox fx:id="symHsmKeyCombo" maxWidth="Infinity" visible="false" managed="false" styleClass="cipher-field"/>
                                    </StackPane>
                                    <Button fx:id="inspectKeyBtn" text="Inspect" onAction="#handleInspectKey" styleClass="secondary-button ux-inline-ba9ea6419e" visible="false" managed="false"/>
                                    <Button fx:id="saveToLabBtn" text="Save to Lab" onAction="#saveCurrentKeyToHsm" styleClass="secondary-button ux-inline-ba9ea6419e"/>
                                </HBox>
                                <Label fx:id="symKeyBadgeLabel" styleClass="material-field-badge" managed="false" visible="false"/>
                            </VBox>
                        </GridPane>
                        <FlowPane styleClass="responsive-action-bar ux-inline-2b55dc6342">
                            <Button text="Paste Key" onAction="#handlePasteSymKey" styleClass="secondary-button ux-inline-ba9ea6419e"/>
                            <Button text="Load Key…" onAction="#handleLoadSymKey" styleClass="secondary-button ux-inline-ba9ea6419e"/>
                            <MenuButton fx:id="symKeyShelfMenu" text="Use from Shelf" styleClass="secondary-button ux-inline-ba9ea6419e" onShowing="#handlePopulateSymKeyShelf"/>
                        </FlowPane>
                        <Label text="Note: Select 'Simulated HSM' to load keys securely from Key Lab, or enter raw hex key." styleClass="helper-text ux-inline-2b55dc6342"/>
                    </VBox>

                    <!-- Group 3: IV / Nonce & AEAD Parameters -->
                    <VBox styleClass="form-group-box">
                        <Label text="IV / Nonce &amp; AEAD parameters" styleClass="form-group-title"/>
                        <GridPane hgap="12" vgap="8">
                            <columnConstraints>
                                <ColumnConstraints minWidth="130" prefWidth="130" halignment="RIGHT"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <Label fx:id="ivLabel" text="IV / Nonce:" styleClass="cipher-field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <VBox spacing="2" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <HBox fx:id="ivContainer" spacing="8" alignment="CENTER_LEFT">
                                    <TextField fx:id="ivField" promptText="Hex IV (required for CBC/CTR/GCM modes)..." HBox.hgrow="ALWAYS" styleClass="cipher-field,cipher-monospace"/>
                                    <Button text="Generate" onAction="#generateIV" styleClass="secondary-button ux-inline-ba9ea6419e"/>
                                </HBox>
                                <Label fx:id="ivBadgeLabel" styleClass="material-field-badge" managed="false" visible="false"/>
                            </VBox>
                            <Label fx:id="gcmTagLabel" text="AEAD Auth Tag:" styleClass="cipher-field-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <VBox spacing="2" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <TextField fx:id="gcmTagField" promptText="Hex Tag (16 bytes; required for AEAD Decryption)"
                                           maxWidth="Infinity" styleClass="cipher-field,cipher-monospace"/>
                                <Label fx:id="gcmTagBadgeLabel" styleClass="material-field-badge" managed="false" visible="false"/>
                            </VBox>
                            <Label fx:id="aadLabel" text="AAD (Optional):" styleClass="cipher-field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <VBox spacing="2" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                <TextField fx:id="aadField" promptText="Hex Additional Authenticated Data (optional)"
                                           maxWidth="Infinity" styleClass="cipher-field,cipher-monospace"/>
                                <Label fx:id="aadBadgeLabel" styleClass="material-field-badge" managed="false" visible="false"/>
                            </VBox>
                        </GridPane>
                        <VBox styleClass="ux-inline-3b04901141" fx:id="ecbWarningBox" visible="false" managed="false">
                            <Label text="⚠️ ECB (Electronic Codebook) mode is insecure: identical plaintext blocks yield identical ciphertext blocks. Use CBC, CTR, or GCM instead."
                                   styleClass="helper-text ux-inline-3f0c348f84" wrapText="true"/>
                        </VBox>
                        <Label fx:id="aeadNoteLabel" text="Note: AEAD modes (GCM, ChaCha20-Poly1305, XChaCha20-Poly1305) require a nonce and produce/verify a detached auth tag." styleClass="helper-text ux-inline-2b55dc6342"/>
                    </VBox>

                    <!-- Primary actions -->
                    <FlowPane styleClass="responsive-action-bar ux-inline-2b55dc6342">
                        <Button text="Encrypt" onAction="#handleSymmetricEncrypt" styleClass="action-button-primary ux-inline-7917b49a95"/>
                        <Button text="Decrypt" onAction="#handleSymmetricDecrypt" styleClass="secondary-button ux-inline-7917b49a95"/>
                    </FlowPane>
                </VBox>
            </TitledPane>

            <TitledPane text="📁 File Cipher (Streaming)" expanded="false">
                <VBox styleClass="ux-inline-1684f00703" spacing="6">
                    <Label styleClass="ux-inline-39414733db" text="Processes the file in chunks. GCM and ChaCha20-Poly1305 use a detached 16-byte tag." wrapText="true"/>
                    <ComboBox styleClass="ux-inline-ba9ea6419e" fx:id="fileCipherAlgorithmCombo" prefWidth="250"/>
                    <HBox spacing="5">
                        <TextField styleClass="ux-inline-ba9ea6419e" fx:id="fileCipherSourceField" promptText="Source file path" HBox.hgrow="ALWAYS"/>
                        <Button text="…" accessibleText="Choose source file" onAction="#chooseFileCipherSource" styleClass="secondary-button"/>
                    </HBox>
                    <HBox spacing="5">
                        <TextField styleClass="ux-inline-ba9ea6419e" fx:id="fileCipherDestinationField" promptText="Output file path" HBox.hgrow="ALWAYS"/>
                        <Button text="…" accessibleText="Choose destination file" onAction="#chooseFileCipherDestination" styleClass="secondary-button"/>
                    </HBox>
                    <HBox spacing="5">
                        <TextField styleClass="ux-inline-ba9ea6419e" fx:id="fileCipherTagField" promptText="Detached AEAD tag path (.tag; required for GCM / ChaCha)" HBox.hgrow="ALWAYS"/>
                        <Button text="…" accessibleText="Choose authentication tag file" onAction="#chooseFileCipherTag" styleClass="secondary-button"/>
                    </HBox>
                    <TextField styleClass="ux-inline-74263851ef" fx:id="fileCipherKeyField" promptText="Key in hexadecimal"/>
                    <HBox spacing="5">
                        <TextField styleClass="ux-inline-74263851ef" fx:id="fileCipherNonceField" promptText="IV / nonce in hexadecimal (fresh value for AEAD encryption)"
                                   HBox.hgrow="ALWAYS"/>
                        <Button text="Generate" onAction="#generateFileCipherNonce" styleClass="secondary-button ux-inline-ab4da656fa"/>
                    </HBox>
                    <TextField styleClass="ux-inline-74263851ef" fx:id="fileCipherAadField" promptText="AAD in hexadecimal (optional, AEAD only)"/>
                    <CheckBox styleClass="ux-inline-ab4da656fa" fx:id="fileCipherLinesCheck"
                              text="Process each UTF-8 line independently (GCM/ChaCha: fresh nonce per line; CBC: supplied IV for all lines)"
                              wrapText="true"/>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Label styleClass="ux-inline-ab4da656fa" text="Line output:"/>
                        <ComboBox styleClass="ux-inline-ab4da656fa" fx:id="fileCipherLineEncodingCombo" prefWidth="120"/>
                        <Label styleClass="ux-inline-ab4da656fa" text="Text:"/>
                        <ComboBox styleClass="ux-inline-ab4da656fa" fx:id="fileCipherLineCharsetCombo" prefWidth="180"/>
                    </HBox>
                    <CheckBox styleClass="ux-inline-ab4da656fa" fx:id="fileCipherCompactCbcCheck" text="Write line records without header (compact format)"/>
                    <FlowPane prefWrapLength="900" styleClass="responsive-action-bar">
                        <Button fx:id="fileCipherEncryptBtn" text="Encrypt File" onAction="#handleFileCipherEncrypt" styleClass="action-button"/>
                        <Button fx:id="fileCipherDecryptBtn" text="Decrypt File" onAction="#handleFileCipherDecrypt" styleClass="action-button"/>
                        <Button fx:id="fileCipherAnalyzeBtn" text="Analyze Encrypted File" onAction="#handleAnalyzeFileCipher" styleClass="secondary-button"/>
                        <Button text="Export Recipe..." onAction="#handleExportFileCipherRecipe" styleClass="secondary-button"/>
                        <Button text="Import Recipe..." onAction="#handleImportFileCipherRecipe" styleClass="secondary-button"/>
                    </FlowPane>
                    <TextArea styleClass="ux-inline-74c2908b8c" fx:id="fileCipherResultArea" editable="false" prefHeight="100" wrapText="true"/>
                </VBox>
            </TitledPane>

            <TitledPane text="🔐 OpenPGP (GPG compatible)" expanded="false">
                <content>
                    <fx:include fx:id="openPgpContainer" source="openpgp.fxml"/>
                </content>
            </TitledPane>

            <TitledPane text="🔑 Asymmetric Cipher (RSA)" expanded="false">
                <VBox styleClass="ux-inline-31b3bfce5a" spacing="10">
                    <Label styleClass="ux-inline-3c07365239" text="RSA Operation using loaded keys (load keys from Keys tab OR enter manually below)"/>
                    <GridPane hgap="10" vgap="10">
                        <Label text="Padding:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <ComboBox fx:id="rsaPaddingCombo" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="Input Format:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <ComboBox fx:id="asymmetricInputFormatCombo" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label text="Output Format:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <ComboBox fx:id="asymmetricOutputFormatCombo" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    </GridPane>
                    <Label fx:id="rsaPaddingHelpLabel" text="OAEP uses MGF1 masks and digest hashing to prevent chosen-ciphertext attacks." styleClass="helper-text" wrapText="true"/>
                    <Label fx:id="rsaPaddingWarningLabel" text="⚠️ PKCS#1 v1.5 padding and NoPadding are vulnerable to padding oracle attacks. OAEP is recommended for RSA encryption." visible="false" managed="false" styleClass="helper-text ux-inline-a0d56c7d79" wrapText="true"/>
                    <Separator orientation="HORIZONTAL"/>
                    <VBox spacing="5">
                        <Label styleClass="ux-inline-ba9ea6419e" text="Public Key (PEM or Hex):"/>
                        <TextArea styleClass="ux-inline-74263851ef" fx:id="publicKeyArea" prefHeight="60" wrapText="true"/>
                        <FlowPane styleClass="responsive-action-bar">
                            <Button text="Paste Public Key" onAction="#handlePastePublicKey" styleClass="secondary-button ux-inline-ba9ea6419e"/>
                            <Button text="Load from File..." onAction="#handleReadPublicKeyFile" styleClass="secondary-button ux-inline-ba9ea6419e"/>
                            <MenuButton fx:id="cipherPubKeyShelfMenu" text="Use from Shelf" styleClass="secondary-button ux-inline-ba9ea6419e" onShowing="#handlePopulateCipherPubKeyShelf"/>
                        </FlowPane>
                    </VBox>
                    <VBox spacing="5">
                        <Label styleClass="ux-inline-ba9ea6419e" text="Private Key (PEM or Hex):"/>
                        <TextArea styleClass="ux-inline-74263851ef" fx:id="privateKeyArea" prefHeight="60" wrapText="true"/>
                        <FlowPane styleClass="responsive-action-bar">
                            <Button text="Paste Private Key" onAction="#handlePastePrivateKey" styleClass="secondary-button ux-inline-ba9ea6419e"/>
                            <Button text="Load from File..." onAction="#handleReadPrivateKeyFile" styleClass="secondary-button ux-inline-ba9ea6419e"/>
                            <MenuButton fx:id="cipherPrivKeyShelfMenu" text="Use from Shelf" styleClass="secondary-button ux-inline-ba9ea6419e" onShowing="#handlePopulateCipherPrivKeyShelf"/>
                        </FlowPane>
                    </VBox>
                    <Separator orientation="HORIZONTAL"/>
                    <FlowPane styleClass="responsive-action-bar">
                        <Button text="Encrypt (Public Key)" onAction="#handleAsymmetricEncrypt" styleClass="action-button-primary"/>
                        <Button text="Decrypt (Private Key)" onAction="#handleAsymmetricDecrypt" styleClass="secondary-button"/>
                    </FlowPane>
                </VBox>
            </TitledPane>
        </panes>
    </Accordion>
</VBox>
