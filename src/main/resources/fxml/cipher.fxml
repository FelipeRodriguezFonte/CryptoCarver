<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="cipherRoot" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cryptocarver.ui.CipherController"
      managed="false" visible="false" spacing="14" styleClass="content-container-vbox,cipher-module">
    <Label text="Data Encryption &amp; Decryption" styleClass="content-title-label"/>
    <Accordion styleClass="cipher-accordion">
        <panes>
            <TitledPane text="🔒 Symmetric Cipher (AES, DES, etc.)" expanded="true">
                <VBox spacing="14" styleClass="cipher-pane-content" maxWidth="720">

                    <!-- Template Selection Bar -->
                    <FlowPane prefWrapLength="900" styleClass="template-toolbar">
                        <Label text="Apply Template:" styleClass="form-label"/>
                        <ComboBox fx:id="cipherTemplateCombo" prefWidth="360" promptText="Select a template..." styleClass="form-field"/>
                        <Button text="Apply" onAction="#handleApplyCipherTemplate" styleClass="action-button-primary" style="-fx-font-size: 11px; -fx-padding: 4 10;"/>
                        <MenuButton text="Manage Template" styleClass="secondary-button" style="-fx-font-size: 11px; -fx-padding: 4 10;">
                            <items>
                                <MenuItem text="Save Current as Personal Template..." onAction="#handleSaveCipherTemplate"/>
                                <MenuItem text="Export Selected Template..." onAction="#handleExportCipherTemplate"/>
                                <MenuItem text="Import Template File..." onAction="#handleImportCipherTemplate"/>
                                <MenuItem text="Delete Selected Personal Template" onAction="#handleDeleteCipherTemplate"/>
                            </items>
                        </MenuButton>
                        <Button text="Reset Defaults" onAction="#handleResetCipherDefaults" styleClass="secondary-button" style="-fx-font-size: 11px; -fx-padding: 4 10;"/>
                    </FlowPane>

                    <!-- Group 1: Algorithm & Mode -->
                    <VBox styleClass="form-group-box">
                        <Label text="Algorithm &amp; Mode" styleClass="form-group-title"/>
                        <GridPane hgap="12" vgap="8">
                            <columnConstraints>
                                <ColumnConstraints minWidth="130" prefWidth="130" halignment="RIGHT"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <Label text="Algorithm:" styleClass="cipher-field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <ComboBox fx:id="symmetricAlgorithmCombo" maxWidth="Infinity" styleClass="cipher-field" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            <Label text="Mode:" styleClass="cipher-field-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <ComboBox fx:id="cipherModeCombo" maxWidth="Infinity" styleClass="cipher-field" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            <Label text="Padding:" styleClass="cipher-field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <ComboBox fx:id="paddingCombo" maxWidth="Infinity" styleClass="cipher-field" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        </GridPane>
                    </VBox>

                    <!-- Group 2: Key Source -->
                    <VBox styleClass="form-group-box">
                        <Label text="Key Source" styleClass="form-group-title"/>
                        <GridPane hgap="12" vgap="8">
                            <columnConstraints>
                                <ColumnConstraints minWidth="130" prefWidth="130" halignment="RIGHT"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <Label text="Key Source *:" styleClass="cipher-field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <VBox spacing="2" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <ComboBox fx:id="symKeySourceCombo" prefWidth="150" minWidth="150" styleClass="cipher-field"/>
                                    <StackPane HBox.hgrow="ALWAYS">
                                        <TextField fx:id="symmetricKeyField" promptText="Enter key in hex (required)..." maxWidth="Infinity" styleClass="cipher-field,cipher-monospace"/>
                                        <ComboBox fx:id="symHsmKeyCombo" maxWidth="Infinity" visible="false" managed="false" styleClass="cipher-field"/>
                                    </StackPane>
                                    <Button fx:id="inspectKeyBtn" text="Inspect" onAction="#handleInspectKey" styleClass="secondary-button" style="-fx-font-size: 11px;" visible="false" managed="false"/>
                                    <Button fx:id="saveToLabBtn" text="Save to Lab" onAction="#saveCurrentKeyToHsm" styleClass="secondary-button" style="-fx-font-size: 11px;"/>
                                </HBox>
                                <Label fx:id="symKeyBadgeLabel" styleClass="material-field-badge" managed="true" visible="true"/>
                            </VBox>
                        </GridPane>
                        <FlowPane styleClass="responsive-action-bar" style="-fx-padding: 4 0 0 142;">
                            <Button text="Paste Key" onAction="#handlePasteSymKey" styleClass="secondary-button" style="-fx-font-size: 11px;"/>
                            <Button text="Load Key…" onAction="#handleLoadSymKey" styleClass="secondary-button" style="-fx-font-size: 11px;"/>
                            <MenuButton fx:id="symKeyShelfMenu" text="Use from Shelf" styleClass="secondary-button" style="-fx-font-size: 11px;" onShowing="#handlePopulateSymKeyShelf"/>
                        </FlowPane>
                        <Label text="Note: Select 'Simulated HSM' to load keys securely from Key Lab, or enter raw hex key." styleClass="helper-text" style="-fx-padding: 4 0 0 142;"/>
                    </VBox>

                    <!-- Group 3: IV / Nonce & AEAD Parameters -->
                    <VBox styleClass="form-group-box">
                        <Label text="IV / Nonce &amp; AEAD parameters" styleClass="form-group-title"/>
                        <GridPane hgap="12" vgap="8">
                            <columnConstraints>
                                <ColumnConstraints minWidth="130" prefWidth="130" halignment="RIGHT"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <Label fx:id="ivLabel" text="IV / Nonce:" styleClass="cipher-field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <VBox spacing="2" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <HBox fx:id="ivContainer" spacing="8" alignment="CENTER_LEFT">
                                    <TextField fx:id="ivField" promptText="Hex IV (required for CBC/CTR/GCM modes)..." HBox.hgrow="ALWAYS" styleClass="cipher-field,cipher-monospace"/>
                                    <Button text="Generate" onAction="#generateIV" styleClass="secondary-button" style="-fx-font-size: 11px;"/>
                                </HBox>
                                <Label fx:id="ivBadgeLabel" styleClass="material-field-badge" managed="true" visible="true"/>
                            </VBox>
                            <Label fx:id="gcmTagLabel" text="AEAD Auth Tag:" styleClass="cipher-field-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <VBox spacing="2" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <TextField fx:id="gcmTagField" promptText="Hex Tag (16 bytes; required for AEAD Decryption)"
                                           maxWidth="Infinity" styleClass="cipher-field,cipher-monospace"/>
                                <Label fx:id="gcmTagBadgeLabel" styleClass="material-field-badge" managed="true" visible="true"/>
                            </VBox>
                            <Label fx:id="aadLabel" text="AAD (Optional):" styleClass="cipher-field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <VBox spacing="2" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                <TextField fx:id="aadField" promptText="Hex Additional Authenticated Data (optional)"
                                           maxWidth="Infinity" styleClass="cipher-field,cipher-monospace"/>
                                <Label fx:id="aadBadgeLabel" styleClass="material-field-badge" managed="true" visible="true"/>
                            </VBox>
                        </GridPane>
                        <VBox fx:id="ecbWarningBox" visible="false" managed="false" style="-fx-padding: 6 0 0 0;">
                            <Label text="⚠️ ECB (Electronic Codebook) mode is insecure: identical plaintext blocks yield identical ciphertext blocks. Use CBC, CTR, or GCM instead."
                                   styleClass="helper-text" style="-fx-text-fill: #c0392b; -fx-font-weight: bold;" wrapText="true"/>
                        </VBox>
                        <Label fx:id="aeadNoteLabel" text="Note: AEAD modes (GCM, ChaCha20-Poly1305, XChaCha20-Poly1305) require a nonce and produce/verify a detached auth tag." styleClass="helper-text" style="-fx-padding: 4 0 0 142;"/>
                    </VBox>

                    <!-- Primary actions -->
                    <FlowPane styleClass="responsive-action-bar" style="-fx-padding: 4 0 0 142;">
                        <Button text="Encrypt" onAction="#handleSymmetricEncrypt" styleClass="action-button-primary" style="-fx-min-width: 120;"/>
                        <Button text="Decrypt" onAction="#handleSymmetricDecrypt" styleClass="secondary-button" style="-fx-min-width: 120;"/>
                    </FlowPane>
                </VBox>
            </TitledPane>

            <TitledPane text="📁 File Cipher (Streaming)" expanded="false">
                <VBox spacing="6" style="-fx-padding: 8;">
                    <Label text="Processes the file in chunks. GCM and ChaCha20-Poly1305 use a detached 16-byte tag."
                           style="-fx-font-size: 10px; -fx-text-fill: #666;" wrapText="true"/>
                    <ComboBox fx:id="fileCipherAlgorithmCombo" prefWidth="250" style="-fx-font-size: 11px;"/>
                    <HBox spacing="5">
                        <TextField fx:id="fileCipherSourceField" promptText="Source file path" HBox.hgrow="ALWAYS" style="-fx-font-size: 11px;"/>
                        <Button text="…" onAction="#chooseFileCipherSource" styleClass="secondary-button"/>
                    </HBox>
                    <HBox spacing="5">
                        <TextField fx:id="fileCipherDestinationField" promptText="Output file path" HBox.hgrow="ALWAYS" style="-fx-font-size: 11px;"/>
                        <Button text="…" onAction="#chooseFileCipherDestination" styleClass="secondary-button"/>
                    </HBox>
                    <HBox spacing="5">
                        <TextField fx:id="fileCipherTagField" promptText="Detached AEAD tag path (.tag; required for GCM / ChaCha)" HBox.hgrow="ALWAYS" style="-fx-font-size: 11px;"/>
                        <Button text="…" onAction="#chooseFileCipherTag" styleClass="secondary-button"/>
                    </HBox>
                    <TextField fx:id="fileCipherKeyField" promptText="Key in hexadecimal" style="-fx-font-family: 'Monospaced'; -fx-font-size: 11px;"/>
                    <HBox spacing="5">
                        <TextField fx:id="fileCipherNonceField" promptText="IV / nonce in hexadecimal (fresh value for AEAD encryption)"
                                   HBox.hgrow="ALWAYS" style="-fx-font-family: 'Monospaced'; -fx-font-size: 11px;"/>
                        <Button text="Generate" onAction="#generateFileCipherNonce" styleClass="secondary-button" style="-fx-font-size: 10px;"/>
                    </HBox>
                    <TextField fx:id="fileCipherAadField" promptText="AAD in hexadecimal (optional, AEAD only)"
                               style="-fx-font-family: 'Monospaced'; -fx-font-size: 11px;"/>
                    <CheckBox fx:id="fileCipherLinesCheck"
                              text="Process each UTF-8 line independently (GCM/ChaCha: fresh nonce per line; CBC: supplied IV for all lines)"
                              wrapText="true" style="-fx-font-size: 10px;"/>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="Line output:" style="-fx-font-size: 10px;"/>
                        <ComboBox fx:id="fileCipherLineEncodingCombo" prefWidth="120" style="-fx-font-size: 10px;"/>
                        <Label text="Text:" style="-fx-font-size: 10px;"/>
                        <ComboBox fx:id="fileCipherLineCharsetCombo" prefWidth="180" style="-fx-font-size: 10px;"/>
                    </HBox>
                    <CheckBox fx:id="fileCipherCompactCbcCheck" text="Write line records without header (compact format)" style="-fx-font-size: 10px;"/>
                    <FlowPane prefWrapLength="900" styleClass="responsive-action-bar">
                        <Button fx:id="fileCipherEncryptBtn" text="Encrypt File" onAction="#handleFileCipherEncrypt" styleClass="action-button"/>
                        <Button fx:id="fileCipherDecryptBtn" text="Decrypt File" onAction="#handleFileCipherDecrypt" styleClass="action-button"/>
                        <Button text="Export Recipe..." onAction="#handleExportFileCipherRecipe" styleClass="secondary-button"/>
                        <Button text="Import Recipe..." onAction="#handleImportFileCipherRecipe" styleClass="secondary-button"/>
                    </FlowPane>
                    <TextArea fx:id="fileCipherResultArea" editable="false" prefHeight="100" wrapText="true"
                              style="-fx-font-family: 'Monospaced'; -fx-font-size: 10px;"/>
                </VBox>
            </TitledPane>

            <TitledPane text="🔐 OpenPGP (GPG compatible)" expanded="false">
                <content>
                    <fx:include fx:id="openPgpContainer" source="openpgp.fxml"/>
                </content>
            </TitledPane>

            <TitledPane text="🔑 Asymmetric Cipher (RSA)" expanded="false">
                <VBox spacing="10" style="-fx-padding: 10;">
                    <Label text="RSA Operation using loaded keys (load keys from Keys tab OR enter manually below)"
                           style="-fx-font-style: italic; -fx-text-fill: gray;"/>
                    <GridPane hgap="10" vgap="10">
                        <Label text="Padding:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <ComboBox fx:id="rsaPaddingCombo" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="Input Format:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <ComboBox fx:id="asymmetricInputFormatCombo" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label text="Output Format:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <ComboBox fx:id="asymmetricOutputFormatCombo" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    </GridPane>
                    <Label fx:id="rsaPaddingHelpLabel" text="OAEP uses MGF1 masks and digest hashing to prevent chosen-ciphertext attacks." styleClass="helper-text" wrapText="true"/>
                    <Label fx:id="rsaPaddingWarningLabel" text="⚠️ PKCS#1 v1.5 padding and NoPadding are vulnerable to padding oracle attacks. OAEP is recommended for RSA encryption." visible="false" managed="false" styleClass="helper-text" style="-fx-text-fill: #b54708; -fx-font-weight: bold;" wrapText="true"/>
                    <Separator orientation="HORIZONTAL"/>
                    <VBox spacing="5">
                        <Label text="Public Key (PEM or Hex):" style="-fx-font-size: 11px;"/>
                        <TextArea fx:id="publicKeyArea" prefHeight="60" wrapText="true"
                                  style="-fx-font-family: 'Monospaced'; -fx-font-size: 11px;"/>
                        <FlowPane styleClass="responsive-action-bar">
                            <Button text="Paste Public Key" onAction="#handlePastePublicKey" styleClass="secondary-button" style="-fx-font-size: 11px;"/>
                            <Button text="Load from File..." onAction="#handleReadPublicKeyFile" styleClass="secondary-button" style="-fx-font-size: 11px;"/>
                            <MenuButton fx:id="cipherPubKeyShelfMenu" text="Use from Shelf" styleClass="secondary-button" style="-fx-font-size: 11px;" onShowing="#handlePopulateCipherPubKeyShelf"/>
                        </FlowPane>
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Private Key (PEM or Hex):" style="-fx-font-size: 11px;"/>
                        <TextArea fx:id="privateKeyArea" prefHeight="60" wrapText="true"
                                  style="-fx-font-family: 'Monospaced'; -fx-font-size: 11px;"/>
                        <FlowPane styleClass="responsive-action-bar">
                            <Button text="Paste Private Key" onAction="#handlePastePrivateKey" styleClass="secondary-button" style="-fx-font-size: 11px;"/>
                            <Button text="Load from File..." onAction="#handleReadPrivateKeyFile" styleClass="secondary-button" style="-fx-font-size: 11px;"/>
                            <MenuButton fx:id="cipherPrivKeyShelfMenu" text="Use from Shelf" styleClass="secondary-button" style="-fx-font-size: 11px;" onShowing="#handlePopulateCipherPrivKeyShelf"/>
                        </FlowPane>
                    </VBox>
                    <Separator orientation="HORIZONTAL"/>
                    <FlowPane styleClass="responsive-action-bar">
                        <Button text="Encrypt (Public Key)" onAction="#handleAsymmetricEncrypt" styleClass="action-button-primary"/>
                        <Button text="Decrypt (Private Key)" onAction="#handleAsymmetricDecrypt" styleClass="secondary-button"/>
                    </FlowPane>
                </VBox>
            </TitledPane>
        </panes>
    </Accordion>
    <VBox spacing="9" styleClass="cipher-io-card">
        <Label text="Input data" styleClass="cipher-io-label"/>
        <TextArea fx:id="cipherInputArea" prefHeight="130" wrapText="true" styleClass="cipher-io-area,cipher-monospace"/>
        <Separator orientation="HORIZONTAL"/>
        <Label text="Output result" styleClass="cipher-io-label"/>
        <TextArea fx:id="cipherOutputArea" prefHeight="130" editable="false" wrapText="true" styleClass="cipher-io-area,cipher-monospace"/>
    </VBox>
</VBox>
