<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<TitledPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
             fx:id="processDesignerRoot" text="🧩 Process Designer" expanded="true" collapsible="false" maxHeight="Infinity" fx:controller="com.cryptocarver.ui.ProcessDesignerController">
    <VBox styleClass="ux-inline-1684f00703" spacing="6">
        <Label styleClass="ux-inline-39414733db" text="Compose safe workflows by dragging blocks and connecting them. Process files store configuration, never secret keys." wrapText="true"/>
        <FlowPane prefWrapLength="1400" styleClass="responsive-action-bar" hgap="10" vgap="6" alignment="CENTER_LEFT">
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label styleClass="ux-inline-ba9ea6419e" text="Process:"/>
                <TextField fx:id="processNameField" text="Untitled process" prefWidth="170"/>
            </HBox>
            <Separator orientation="VERTICAL"/>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Button fx:id="runProcessButton" text="Run" onAction="#handleRunProcess" styleClass="action-button"/>
                <Button fx:id="dryRunProcessButton" text="Dry Run" onAction="#handleDryRunProcess" styleClass="secondary-button"/>
                <Button fx:id="cancelProcessButton" text="Cancel" onAction="#handleCancelProcess" styleClass="secondary-button" disable="true"/>
            </HBox>
            <Separator orientation="VERTICAL"/>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Button fx:id="openProcessButton" text="Open…" onAction="#handleLoadProcess" styleClass="secondary-button"/>
                <Button fx:id="saveProcessButton" text="Save…" onAction="#handleSaveProcess" styleClass="secondary-button"/>
                <MenuButton fx:id="editMenuButton" text="Edición" styleClass="secondary-button">
                    <items>
                        <MenuItem text="Undo" onAction="#handleUndo"/>
                        <MenuItem text="Redo" onAction="#handleRedo"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="Duplicate" onAction="#handleDuplicateSelected"/>
                        <MenuItem text="Tidy layout" onAction="#handleTidyLayout"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="Clear canvas" onAction="#handleClearCanvas"/>
                        <MenuItem text="Reset Defaults" onAction="#handleResetDefaults"/>
                    </items>
                </MenuButton>
                <MenuButton fx:id="presetsMenuButton" text="Presets" styleClass="secondary-button">
                    <items>
                        <MenuItem text="SHA-256 text digest" onAction="#handleLoadSha256Preset"/>
                        <MenuItem text="Base64 text encode" onAction="#handleLoadBase64Preset"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="AES-GCM encrypt and decrypt" onAction="#handleLoadAesGcmRoundTripPreset"/>
                        <MenuItem text="AES-CMAC" onAction="#handleLoadAesCmacPreset"/>
                    </items>
                </MenuButton>
            </HBox>
            <Separator orientation="VERTICAL"/>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Button fx:id="inspectorToggleButton" text="Hide inspector" onAction="#handleToggleInspector" styleClass="secondary-button"/>
                <Button fx:id="focusModeButton" text="Focus mode" onAction="#handleToggleFocusMode" styleClass="secondary-button"/>
                <Button fx:id="expandResultsButton" text="Expand results" onAction="#handleOpenExpandedExecutionResult" styleClass="secondary-button"/>
                <Button fx:id="openWindowButton" text="Open in window" onAction="#handleOpenWindow" styleClass="secondary-button"/>
            </HBox>
        </FlowPane>
        <SplitPane fx:id="designerVerticalSplit" orientation="VERTICAL" dividerPositions="0.72" prefHeight="640" minHeight="420" VBox.vgrow="ALWAYS">
            <items>
                <SplitPane fx:id="designerSplitPane" dividerPositions="0.18, 0.76" minHeight="260">
                    <items>
                        <!-- Searchable Palette -->
                        <VBox styleClass="ux-inline-a15413a06d" fx:id="palettePanel" minWidth="200" prefWidth="250" maxWidth="340" SplitPane.resizableWithParent="false" spacing="6">
                    <Label styleClass="ux-inline-ad770fad50" text="Palette"/>
                    <TextField styleClass="ux-inline-ab4da656fa" fx:id="paletteSearchField" promptText="Search palette…"/>
                    <ScrollPane styleClass="ux-inline-062b25176d" fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS">
                        <content>
                            <VBox styleClass="ux-inline-1193ccbe1f" fx:id="paletteItemsContainer" spacing="3" minHeight="-Infinity"/>
                        </content>
                    </ScrollPane>
                </VBox>

                        <!-- Canvas Workspace: its own action bar keeps selection and zoom next to the canvas -->
                        <VBox spacing="4" minWidth="320">
                            <FlowPane styleClass="responsive-action-bar" hgap="6" vgap="4" alignment="CENTER_LEFT">
                                <Button fx:id="connectSelectedButton" text="Select 2 blocks to connect" onAction="#handleConnectSelected" styleClass="action-button,ux-inline-ab4da656fa"/>
                                <MenuButton fx:id="connectMenuButton" text="Connect to..." styleClass="action-button,ux-inline-ab4da656fa" managed="false" visible="false"/>
                                <Button fx:id="reverseConnectionToolbarButton" text="Reverse connection" onAction="#handleReverseSelectedConnection" styleClass="secondary-button,ux-inline-ab4da656fa" disable="true"/>
                                <Button fx:id="deleteSelectedButton" text="Delete selected" onAction="#handleDeleteSelected" styleClass="secondary-button,ux-inline-ab4da656fa"/>
                                <Button fx:id="clearCanvasToolbarButton" text="Clear canvas" onAction="#handleClearCanvas" styleClass="secondary-button,ux-inline-ab4da656fa"/>
                                <Separator orientation="VERTICAL"/>
                                <Button fx:id="zoomOutButton" text="Zoom out" onAction="#handleZoomOut" styleClass="secondary-button,ux-inline-ab4da656fa"/>
                                <Button fx:id="zoomInButton" text="Zoom in" onAction="#handleZoomIn" styleClass="secondary-button,ux-inline-ab4da656fa"/>
                                <Button fx:id="resetZoomButton" text="Reset zoom" onAction="#handleResetZoom" styleClass="secondary-button,ux-inline-ab4da656fa"/>
                                <Button fx:id="zoomFitButton" text="Fit to content" onAction="#handleZoomFit" styleClass="secondary-button,ux-inline-ab4da656fa"/>
                                <Label styleClass="ux-inline-7f1f518806" fx:id="zoomLevelLabel" text="100%"/>
                                <CheckBox styleClass="ux-inline-ab4da656fa" fx:id="snapToGridCheck" text="Snap to grid" onAction="#handleSnapToGridToggled" selected="true"/>
                            </FlowPane>
                            <ScrollPane styleClass="ux-inline-74b94b8ef1" fx:id="designerWorkspace" fitToWidth="false" fitToHeight="false" pannable="true" VBox.vgrow="ALWAYS">
                                <content>
                                    <Pane styleClass="ux-inline-ec0ebd6c4b" fx:id="workflowCanvas" minWidth="1200" prefWidth="1200" minHeight="800" prefHeight="800"/>
                                </content>
                            </ScrollPane>
                        </VBox>

                        <!-- Node inspector: only what describes and configures the selected block -->
                        <VBox styleClass="ux-inline-66ce195191" fx:id="nodeInspector" spacing="6" minWidth="-1" prefWidth="300" SplitPane.resizableWithParent="false">
                            <Label styleClass="ux-inline-601a4c676b" fx:id="selectedNodeLabel" wrapText="true"/>
                            <Label styleClass="ux-inline-25e6beb3a5" fx:id="inputContractLabel" managed="false" visible="false"/>
                            <Label styleClass="ux-inline-25e6beb3a5" fx:id="outputContractLabel" managed="false" visible="false"/>
                            <VBox fx:id="nodeNameFieldGroup" spacing="2">
                                <Label styleClass="ux-inline-ab4da656fa" text="Node name"/>
                                <TextField styleClass="ux-inline-ab4da656fa" fx:id="nodeNameField" promptText="Describe this step"/>
                            </VBox>
                            <ScrollPane styleClass="ux-inline-062b25176d" fitToWidth="true" VBox.vgrow="ALWAYS">
                                <content>
                                    <VBox styleClass="ux-inline-1193ccbe1f" fx:id="dynamicInspectorContainer" spacing="4"/>
                                </content>
                            </ScrollPane>
                            <Button fx:id="saveNodeSettingsButton" text="Save block settings" onAction="#handleSaveNodeSettings" styleClass="secondary-button" maxWidth="1.7976931348623157E308"/>
                        </VBox>
                    </items>
                </SplitPane>
                <SplitPane dividerPositions="0.5" minHeight="120">
                    <items>
                        <VBox styleClass="ux-inline-c7b1eebc45" spacing="4">
                    <HBox styleClass="ux-inline-8a935d4e82" spacing="8" alignment="CENTER_LEFT">
                        <Label styleClass="ux-inline-601a4c676b" text="Execution status"/>
                        <ProgressBar fx:id="processProgressBar" prefWidth="160" progress="0.0"/>
                        <Label styleClass="ux-inline-601a4c676b" fx:id="processStatusLabel" text="Ready"/>
                    </HBox>
                    <TableView styleClass="ux-inline-ab4da656fa" fx:id="executionStatusTable" prefHeight="110" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="stepCol" text="#" prefWidth="42" sortable="false"/>
                            <TableColumn fx:id="stepNameCol" text="Step" prefWidth="150" sortable="false"/>
                            <TableColumn fx:id="operationCol" text="Operation" prefWidth="130" sortable="false"/>
                            <TableColumn fx:id="inputCol" text="Input" prefWidth="115" sortable="false"/>
                            <TableColumn fx:id="outputCol" text="Output" prefWidth="115" sortable="false"/>
                            <TableColumn fx:id="statusCol" text="Status" prefWidth="90" sortable="false"/>
                            <TableColumn fx:id="durationCol" text="Duration" prefWidth="80" sortable="false"/>
                        </columns>
                    </TableView>
                </VBox>
                        <VBox styleClass="ux-inline-db8d9d3e8f" spacing="4">
                    <Label styleClass="ux-inline-601a4c676b" text="Execution results"/>
                    <TextArea styleClass="ux-inline-744623818d" fx:id="executionOutputArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS" promptText="Execution results and validation messages appear here."/>
                </VBox>
                    </items>
                </SplitPane>
            </items>
        </SplitPane>
    </VBox>
</TitledPane>
