<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<TitledPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
             fx:id="processDesignerRoot" text="🧩 Process Designer (MVP)" expanded="false" fx:controller="com.cryptocarver.ui.ProcessDesignerController">
    <VBox spacing="7" style="-fx-padding: 8;">
        <Label text="Compose safe workflows by dragging blocks and connecting them. Process files store configuration, never secret keys." wrapText="true" style="-fx-font-size: 10px; -fx-text-fill: #666;"/>
        <FlowPane prefWrapLength="980" styleClass="responsive-action-bar" hgap="10" vgap="8">
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="Process:" style="-fx-font-size: 11px;"/>
                <TextField fx:id="processNameField" text="Untitled process" prefWidth="170"/>
            </HBox>
            <Separator orientation="VERTICAL"/>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Button fx:id="runProcessButton" text="Run" onAction="#handleRunProcess" styleClass="action-button"/>
                <Button text="Dry Run" onAction="#handleDryRunProcess" styleClass="secondary-button"/>
                <Button fx:id="cancelProcessButton" text="Cancel" onAction="#handleCancelProcess" styleClass="secondary-button" disable="true"/>
            </HBox>
            <Separator orientation="VERTICAL"/>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Button text="Open…" onAction="#handleLoadProcess" styleClass="secondary-button"/>
                <Button text="Save…" onAction="#handleSaveProcess" styleClass="secondary-button"/>
            </HBox>
            <Separator orientation="VERTICAL"/>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <MenuButton text="Edición" styleClass="secondary-button">
                    <items>
                        <MenuItem text="Undo" onAction="#handleUndo"/>
                        <MenuItem text="Redo" onAction="#handleRedo"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="Duplicate" onAction="#handleDuplicateSelected"/>
                        <MenuItem text="Tidy layout" onAction="#handleTidyLayout"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="Clear canvas" onAction="#handleClearCanvas"/>
                        <MenuItem text="Reset Defaults" onAction="#handleResetDefaults"/>
                    </items>
                </MenuButton>
                <MenuButton text="Presets" styleClass="secondary-button">
                    <items>
                        <MenuItem text="SHA-256 text digest" onAction="#handleLoadSha256Preset"/>
                        <MenuItem text="Base64 text encode" onAction="#handleLoadBase64Preset"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="AES-GCM encrypt and decrypt" onAction="#handleLoadAesGcmRoundTripPreset"/>
                        <MenuItem text="AES-CMAC" onAction="#handleLoadAesCmacPreset"/>
                    </items>
                </MenuButton>
            </HBox>
            <Separator orientation="VERTICAL"/>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Button fx:id="reverseConnectionToolbarButton" text="Reverse connection" onAction="#handleReverseSelectedConnection" styleClass="secondary-button" disable="true"/>
                <Button text="Clear canvas" onAction="#handleClearCanvas" styleClass="secondary-button"/>
            </HBox>
            <Separator orientation="VERTICAL"/>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Button fx:id="inspectorToggleButton" text="Hide inspector" onAction="#handleToggleInspector" styleClass="secondary-button"/>
                <Button fx:id="focusModeButton" text="Focus mode" onAction="#handleToggleFocusMode" styleClass="secondary-button"/>
            </HBox>
            <Separator orientation="VERTICAL"/>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Button text="Expand results" onAction="#handleOpenExpandedExecutionResult" styleClass="secondary-button"/>
                <Button text="Open in window" onAction="#handleOpenWindow" styleClass="secondary-button"/>
            </HBox>
        </FlowPane>
        <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding: 2 0 2 0;">
            <ProgressBar fx:id="processProgressBar" prefWidth="250" progress="0.0" HBox.hgrow="ALWAYS"/>
            <Label fx:id="processStatusLabel" text="Ready" style="-fx-font-weight: bold; -fx-font-size: 11px;"/>
            <Separator orientation="VERTICAL"/>
            <Button text="Zoom in" onAction="#handleZoomIn" styleClass="secondary-button" style="-fx-font-size: 10px;"/>
            <Button text="Zoom out" onAction="#handleZoomOut" styleClass="secondary-button" style="-fx-font-size: 10px;"/>
            <Button text="Reset zoom" onAction="#handleResetZoom" styleClass="secondary-button" style="-fx-font-size: 10px;"/>
            <Button text="Fit to content" onAction="#handleZoomFit" styleClass="secondary-button" style="-fx-font-size: 10px;"/>
            <Label fx:id="zoomLevelLabel" text="100%" style="-fx-font-size: 10px; -fx-text-fill: #aaa; -fx-min-width: 40;"/>
            <CheckBox fx:id="snapToGridCheck" text="Snap to grid" onAction="#handleSnapToGridToggled" selected="true" style="-fx-font-size: 10px;"/>
        </HBox>
        <SplitPane fx:id="designerSplitPane" dividerPositions="0.18, 0.76" prefHeight="380">
            <items>
                <!-- Searchable Palette -->
                <VBox fx:id="palettePanel" minWidth="180" prefWidth="200" maxWidth="260" spacing="6" style="-fx-padding: 6; -fx-background-color: #1a222d;">
                    <Label text="Palette" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #ccc;"/>
                    <TextField fx:id="paletteSearchField" promptText="Search palette…" style="-fx-font-size: 10px;"/>
                    <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent;">
                        <content>
                            <VBox fx:id="paletteItemsContainer" spacing="3" style="-fx-padding: 2;"/>
                        </content>
                    </ScrollPane>
                </VBox>

                <!-- Canvas Workspace -->
                <ScrollPane fx:id="designerWorkspace" fitToWidth="false" fitToHeight="false" pannable="true" style="-fx-background: #202a33;" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                    <content>
                        <Pane fx:id="workflowCanvas" minWidth="1200" prefWidth="1200" minHeight="800" prefHeight="800" style="-fx-background-color: #202a33; -fx-background-insets: 0;"/>
                    </content>
                </ScrollPane>

                <!-- Dynamic Descriptor Inspector -->
                <VBox fx:id="nodeInspector" spacing="6" minWidth="250" prefWidth="280" style="-fx-padding: 6;">
                    <Label fx:id="selectedNodeLabel" wrapText="true" style="-fx-font-weight: bold; -fx-font-size: 11px;"/>
                    <Label fx:id="inputContractLabel" style="-fx-font-size: 9px; -fx-text-fill: #999;" managed="false" visible="false"/>
                    <Label fx:id="outputContractLabel" style="-fx-font-size: 9px; -fx-text-fill: #999;" managed="false" visible="false"/>
                    <VBox fx:id="nodeNameFieldGroup" spacing="2">
                        <Label text="Node name" style="-fx-font-size: 10px;"/>
                        <TextField fx:id="nodeNameField" promptText="Describe this step" style="-fx-font-size: 10px;"/>
                    </VBox>

                    <!-- Dynamically populated parameters -->
                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent;">
                        <content>
                            <VBox fx:id="dynamicInspectorContainer" spacing="4" style="-fx-padding: 2;"/>
                        </content>
                    </ScrollPane>

                    <!-- Fixed footer buttons -->
                    <Button text="Save block settings" onAction="#handleSaveNodeSettings" styleClass="secondary-button" maxWidth="1.7976931348623157E308"/>
                    <VBox spacing="4" maxWidth="1.7976931348623157E308">
                        <Button fx:id="connectSelectedButton" text="Select 2 blocks to connect" onAction="#handleConnectSelected" styleClass="action-button" maxWidth="1.7976931348623157E308"/>
                        <MenuButton fx:id="connectMenuButton" text="Connect to..." styleClass="action-button" maxWidth="1.7976931348623157E308" managed="false" visible="false"/>
                    </VBox>
                    <Button fx:id="reverseConnectionButton" text="Reverse selected connection" onAction="#handleReverseSelectedConnection" styleClass="secondary-button" maxWidth="1.7976931348623157E308"/>
                    <Button fx:id="deleteSelectedButton" text="Delete selected" onAction="#handleDeleteSelected" styleClass="secondary-button" maxWidth="1.7976931348623157E308"/>
                    <Button text="Clear canvas" onAction="#handleClearCanvas" styleClass="secondary-button" maxWidth="1.7976931348623157E308"/>
                </VBox>
            </items>
        </SplitPane>
        <SplitPane orientation="VERTICAL" dividerPositions="0.45" prefHeight="240" VBox.vgrow="ALWAYS">
            <items>
                <VBox spacing="4" style="-fx-padding: 2 0 0 0;">
                    <Label text="Execution status" style="-fx-font-weight: bold; -fx-font-size: 11px;"/>
                    <TableView fx:id="executionStatusTable" prefHeight="110" VBox.vgrow="ALWAYS" style="-fx-font-size: 10px;">
                        <columns>
                            <TableColumn fx:id="stepCol" text="#" prefWidth="42" sortable="false"/>
                            <TableColumn fx:id="stepNameCol" text="Step" prefWidth="150" sortable="false"/>
                            <TableColumn fx:id="operationCol" text="Operation" prefWidth="130" sortable="false"/>
                            <TableColumn fx:id="inputCol" text="Input" prefWidth="115" sortable="false"/>
                            <TableColumn fx:id="outputCol" text="Output" prefWidth="115" sortable="false"/>
                            <TableColumn fx:id="statusCol" text="Status" prefWidth="90" sortable="false"/>
                            <TableColumn fx:id="durationCol" text="Duration" prefWidth="80" sortable="false"/>
                        </columns>
                    </TableView>
                </VBox>
                <VBox spacing="4" style="-fx-padding: 4 0 0 0;">
                    <Label text="Execution results" style="-fx-font-weight: bold; -fx-font-size: 11px;"/>
                    <TextArea fx:id="executionOutputArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS" promptText="Execution results and validation messages appear here." style="-fx-font-family: monospace; -fx-font-size: 10px;"/>
                </VBox>
            </items>
        </SplitPane>
    </VBox>
</TitledPane>
