<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="emvContainer" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cryptocarver.ui.EMVController" spacing="14" styleClass="content-container-vbox,emv-module">
    <HBox alignment="CENTER_RIGHT">
        <Button text="Clear" onAction="#handleClear" styleClass="secondary-button"/>
        <Button text="Reset Defaults" onAction="#handleReset" styleClass="secondary-button"/>
    </HBox>
    <Accordion styleClass="module-accordion">
        <panes>
            <TitledPane text="🔬 EMV TLV Inspector">
                <VBox spacing="12" styleClass="module-pane-content">
                    <Label text="BER-TLV hexadecimal:" styleClass="form-label"/>
                    <TextArea fx:id="emvTlvInputArea" prefHeight="100" promptText="9F02060000000001005F2A020978" styleClass="monospace-field"/>
                    <Button text="Inspect EMV TLV" onAction="#handleInspectTlv" styleClass="action-button,primary-action" maxWidth="160"/>
                    <TextArea fx:id="emvTlvResultArea" prefHeight="180" editable="false" styleClass="result-area,monospace-field"/>
                    <Separator/>
                    <Label text="CDOL/DDOL Builder" styleClass="form-label ux-inline-689e8d50bc"/>
                    <TextField fx:id="emvDolTemplateField" promptText="DOL template, e.g. 9F02069F1A02" styleClass="monospace-field,form-field" maxWidth="Infinity"/>
                    <TextArea fx:id="emvDolValuesArea" prefHeight="70" promptText="9F02=000000000100&#10;9F1A=0978" styleClass="monospace-field"/>
                    <Button text="Build DOL Data" onAction="#handleBuildDol" styleClass="secondary-button" maxWidth="150"/>
                    <TextArea fx:id="emvDolResultArea" prefHeight="145" editable="false" wrapText="true" styleClass="result-area,monospace-field"/>
                </VBox>
            </TitledPane>

            <!-- SESSION KEY DERIVATION -->
            <TitledPane text="🔑 Session Key Derivation" expanded="true">
                <VBox spacing="12" styleClass="module-pane-content">
                    <Label text="Derive ICC Master Key (Action A)" styleClass="form-label ux-inline-689e8d50bc"/>
                    <GridPane hgap="10" vgap="9" styleClass="form-grid">
                        <columnConstraints>
                            <ColumnConstraints minWidth="120" prefWidth="120"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="IMK (Hex):" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="imkField" promptText="Issuer Master Key (16 bytes)" maxWidth="Infinity"
                                  GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>

                        <Label text="PAN:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="panFieldSession" promptText="Primary Account Number" maxWidth="Infinity"
                                  GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="form-field"/>

                        <Label text="PAN Seq:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="panSeqFieldSession" promptText="00-99" prefWidth="60"
                                  GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="form-field"/>
                    </GridPane>

                    <Separator/>

                    <Label text="Derive Session Key (SK)" styleClass="form-label ux-inline-689e8d50bc"/>
                    <GridPane hgap="10" vgap="9" styleClass="form-grid">
                         <columnConstraints>
                            <ColumnConstraints minWidth="120" prefWidth="120"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="ATC (Hex):" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="emvAtcField" promptText="Application Transaction Counter (2 bytes)" maxWidth="Infinity"
                                  GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>
                    </GridPane>

                    <Button text="Derive Keys" onAction="#handleDeriveSessionKey"
                            styleClass="action-button,primary-action" maxWidth="150"/>

                    <TextArea fx:id="sessionKeyResultArea" prefHeight="120" editable="false" wrapText="true"
                              styleClass="result-area,monospace-field" managed="false" visible="false"/>
                </VBox>
            </TitledPane>

            <!-- ARQC GENERATION -->
            <TitledPane text="💳 ARQC Generation">
                <VBox spacing="12" styleClass="module-pane-content">
                    <GridPane hgap="10" vgap="9" styleClass="form-grid">
                        <columnConstraints>
                            <ColumnConstraints minWidth="160" prefWidth="160"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Session Key (Hex):" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="skARQCField" promptText="16 bytes Session Key" maxWidth="Infinity"
                                  GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>
                    </GridPane>

                    <Label text="Terminal Data (Raw - Overrides fields below):" styleClass="form-label ux-inline-689e8d50bc"/>
                    <TextArea fx:id="arqcTerminalDataField" prefRowCount="2" wrapText="true"
                              promptText="Paste full terminal data hex string here to use it directly..." styleClass="monospace-field"/>

                    <Label text="Transaction Data (Individual Fields):" styleClass="form-label ux-inline-689e8d50bc"/>
                    <GridPane hgap="10" vgap="9" styleClass="form-grid">
                        <columnConstraints>
                            <ColumnConstraints minWidth="120" prefWidth="120"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Amount:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="amountField" promptText="000000000100" maxWidth="Infinity"
                                  GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>

                        <Label text="Amount Other:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="amountOtherField" promptText="000000000000" maxWidth="Infinity"
                                  GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>

                        <Label text="Currency:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="currencyField" promptText="0978 (EUR)" maxWidth="Infinity"
                                  GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>

                        <Label text="Country:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="countryField" promptText="0724 (ES)" maxWidth="Infinity"
                                  GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>

                        <!-- ATC Field retained for UI context but excluded from the default external tool structure unless user adds it to Raw Data -->
                        <Label text="ATC (Info):" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="atcARQCField" promptText="0001" maxWidth="Infinity"
                                  GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>

                        <Label text="TVR:" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="tvrField" promptText="0000000000" maxWidth="Infinity"
                                  GridPane.rowIndex="5" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>

                        <Label text="Date (YYMMDD):" GridPane.rowIndex="6" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="txDateField" promptText="250101" maxWidth="Infinity"
                                  GridPane.rowIndex="6" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>

                        <Label text="Type:" GridPane.rowIndex="7" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="txTypeField" promptText="00" maxWidth="Infinity"
                                  GridPane.rowIndex="7" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>

                        <Label text="UN:" GridPane.rowIndex="8" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="unField" promptText="Unpredictable Number (4 bytes)" maxWidth="Infinity"
                                  GridPane.rowIndex="8" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>

                        <Label text="ICC Data:" GridPane.rowIndex="9" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="iccDataField" promptText="Optional (Tag 9F10?)" maxWidth="Infinity"
                                  GridPane.rowIndex="9" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>

                        <Label text="Padding:" GridPane.rowIndex="10" GridPane.columnIndex="0" styleClass="form-label"/>
                        <ComboBox fx:id="arqcPaddingMethodCombo" prefWidth="250"
                                  GridPane.rowIndex="10" GridPane.columnIndex="1" styleClass="form-field"/>
                    </GridPane>

                    <Button text="Generate ARQC" onAction="#handleGenerateARQC"
                            styleClass="action-button,primary-action" maxWidth="150"/>

                    <TextArea fx:id="arqcResultArea" prefHeight="80" editable="false" wrapText="true"
                              styleClass="result-area,monospace-field" managed="false" visible="false"/>
                </VBox>
            </TitledPane>

            <!-- ARPC GENERATION -->
            <TitledPane text="🔄 ARQC Validation &amp; ARPC">
                <VBox spacing="12" styleClass="module-pane-content">
                    <GridPane hgap="10" vgap="9" styleClass="form-grid">
                        <columnConstraints>
                            <ColumnConstraints minWidth="160" prefWidth="160"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Session Key (Hex):" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="skARPCField" promptText="16 bytes Session Key" maxWidth="Infinity"
                                  GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>

                        <Label text="ARQC (from card):" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="arqcField" promptText="8 bytes ARQC" maxWidth="Infinity"
                                  GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>

                        <Label text="Response Code (ARC):" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="arcField" promptText="e.g. 3030 (Approved)" maxWidth="Infinity"
                                  GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>

                        <Label text="CSU (Optional):" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="csuField" promptText="4 bytes Card Status Update" maxWidth="Infinity"
                                  GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>

                        <Label text="Prop. Auth. Data (Opt):" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="propAuthDataField" promptText="Proprietary Authentication Data (Hex)" maxWidth="Infinity"
                                  GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>

                        <Label text="Method:" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="form-label"/>
                        <ComboBox fx:id="arpcMethodCombo" prefWidth="250"
                                  GridPane.rowIndex="5" GridPane.columnIndex="1" styleClass="form-field"/>
                    </GridPane>

                    <HBox spacing="8">
                        <Button text="Generate ARPC" onAction="#handleGenerateARPC"
                                styleClass="action-button,primary-action" maxWidth="150"/>
                        <Button text="Verify ARQC (Sim)" onAction="#handleVerifyARQC"
                                styleClass="secondary-button" maxWidth="150"/>
                    </HBox>

                    <TextArea fx:id="arpcResultArea" prefHeight="80" editable="false" wrapText="true"
                              styleClass="result-area,monospace-field" managed="false" visible="false"/>
                </VBox>
            </TitledPane>

            <!-- ISSUER SCRIPT SECURE MESSAGING -->
            <TitledPane text="🔐 Secure Messaging (Issuer Script)">
                <VBox spacing="12" styleClass="module-pane-content">
                    <Label text="Session keys, the enciphered PIN of a PIN change command and the command MAC, Mastercard or Visa. Each step fills the fields of the next; all of them stay editable." wrapText="true" styleClass="form-label"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Scheme:" styleClass="form-label"/>
                        <ComboBox fx:id="smSchemeCombo" prefWidth="180" styleClass="form-field"/>
                        <Button text="Load Example" onAction="#handleSmLoadExample" styleClass="secondary-button" maxWidth="140"/>
                    </HBox>

                    <Label text="1. Card and session keys" styleClass="form-label ux-inline-689e8d50bc"/>
                    <GridPane hgap="10" vgap="9" styleClass="form-grid">
                        <columnConstraints>
                            <ColumnConstraints minWidth="170" prefWidth="170"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="MK-SMI (Mastercard):" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="smMkSmiField" promptText="Issuer MAC master key, 16 bytes" maxWidth="Infinity"
                                   GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>
                        <Label text="MK-SMC (Mastercard):" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="smMkSmcField" promptText="Issuer encryption master key, 16 bytes" maxWidth="Infinity"
                                   GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>
                        <Label text="PAN/SqNr (Mastercard):" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="smPanSeqField" promptText="16 digits of PAN and sequence number" maxWidth="Infinity"
                                   GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>
                        <Label text="UDK MAC (SMI):" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="smUdkSmiField" promptText="Card MAC key, 16 bytes" maxWidth="Infinity"
                                   GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>
                        <Label text="UDK ENC (SMC):" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="smUdkSmcField" promptText="Card encryption key, 16 bytes" maxWidth="Infinity"
                                   GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>
                        <Label text="AC:" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="smAcField" promptText="Application cryptogram, 8 bytes" maxWidth="Infinity"
                                   GridPane.rowIndex="5" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>
                        <Label text="Command nr (Mastercard):" GridPane.rowIndex="6" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="smCommandNumberField" promptText="0" maxWidth="Infinity"
                                   GridPane.rowIndex="6" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>
                        <Label text="ATC:" GridPane.rowIndex="7" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="smAtcField" promptText="2 bytes" maxWidth="Infinity"
                                   GridPane.rowIndex="7" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>
                        <Label text="SK MAC:" GridPane.rowIndex="8" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="smSkMacField" promptText="Filled by Derive Session Keys" maxWidth="Infinity"
                                   GridPane.rowIndex="8" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>
                        <Label text="SK ENC:" GridPane.rowIndex="9" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="smSkEncField" promptText="Filled by Derive Session Keys" maxWidth="Infinity"
                                   GridPane.rowIndex="9" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>
                    </GridPane>
                    <Button text="Derive Session Keys" onAction="#handleSmDeriveSessionKeys" styleClass="action-button,primary-action" maxWidth="190"/>

                    <Label text="2. PIN change data" styleClass="form-label ux-inline-689e8d50bc"/>
                    <GridPane hgap="10" vgap="9" styleClass="form-grid">
                        <columnConstraints>
                            <ColumnConstraints minWidth="170" prefWidth="170"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="New PIN:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                        <PasswordField fx:id="smPinField" promptText="4 to 12 digits" maxWidth="Infinity"
                                       GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>
                        <Label text="UDK A (Visa):" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="smUdkAField" promptText="Card key the Visa PIN block is bound to, 16 bytes" maxWidth="Infinity"
                                   GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>
                    </GridPane>
                    <Button text="Encipher PIN" onAction="#handleSmEncipherPin" styleClass="action-button,primary-action" maxWidth="190"/>

                    <Label text="3. Command MAC" styleClass="form-label ux-inline-689e8d50bc"/>
                    <GridPane hgap="10" vgap="9" styleClass="form-grid">
                        <columnConstraints>
                            <ColumnConstraints minWidth="170" prefWidth="170"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="CLA INS P1 P2 Lc:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="smHeaderField" promptText="5 bytes, e.g. 8424000210" maxWidth="Infinity"
                                   GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>
                        <Label text="Command data:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="smDataField" promptText="Filled by Encipher PIN" maxWidth="Infinity"
                                   GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>
                    </GridPane>
                    <Button text="Generate MAC" onAction="#handleSmGenerateMac" styleClass="action-button,primary-action" maxWidth="190"/>

                    <TextArea fx:id="smResultArea" prefHeight="150" editable="false" wrapText="true"
                              styleClass="result-area,monospace-field" managed="false" visible="false"/>
                </VBox>
            </TitledPane>

            <!-- TRACK 2 DATA -->
            <TitledPane text="🎞 Track 2 Data">
                <VBox spacing="12" styleClass="module-pane-content">
                    <TabPane tabClosingPolicy="UNAVAILABLE">
                        <Tab text="Encode">
                            <VBox spacing="12" styleClass="module-pane-content">
                                <GridPane hgap="10" vgap="9" styleClass="form-grid">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="140" prefWidth="140"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                    </columnConstraints>
                                    <Label text="PAN:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                                    <TextField fx:id="panTrack2Field" promptText="Primary Account Number" maxWidth="Infinity"
                                              GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="form-field"/>

                                    <Label text="Expiry (YYMM):" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                                    <TextField fx:id="expiryTrack2Field" promptText="2512" maxWidth="Infinity"
                                              GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="form-field"/>

                                    <Label text="Service Code:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
                                    <TextField fx:id="serviceCodeFieldTrack2" promptText="201" maxWidth="Infinity"
                                              GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="form-field"/>

                                    <Label text="Discretionary Data:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="form-label"/>
                                    <TextField fx:id="discretionaryDataField" promptText="Optional" maxWidth="Infinity"
                                              GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="form-field"/>
                                </GridPane>

                                <Button text="Encode Track 2" onAction="#handleEncodeTrack2"
                                        styleClass="action-button,primary-action" maxWidth="150"/>
                            </VBox>
                        </Tab>
                        <Tab text="Decode">
                            <VBox spacing="12" styleClass="module-pane-content">
                                <Label text="Track 2 Hex / String:" styleClass="form-label"/>
                                <TextField fx:id="track2InputField" promptText="Paste Track 2 data" maxWidth="Infinity" styleClass="monospace-field,form-field"/>

                                <Button text="Decode Track 2" onAction="#handleDecodeTrack2"
                                        styleClass="action-button,primary-action" maxWidth="150"/>
                            </VBox>
                        </Tab>
                    </TabPane>

                    <TextArea fx:id="track2ResultArea" prefHeight="100" editable="false" wrapText="true"
                              styleClass="result-area,monospace-field" managed="false" visible="false"/>
                </VBox>
            </TitledPane>
            <!-- OFFLINE DATA AUTHENTICATION -->
            <TitledPane text="🧾 Offline Data Authentication (SDA/DDA/CDA)">
                <VBox spacing="12" styleClass="module-pane-content">
                    <Label text="Each key is recovered from the certificate above it: the CA key opens tag 90, the issuer key it yields opens tag 9F46, and the ICC key that yields checks the dynamic signature. The static data is part of the ICC certificate's own hash, so an AFL assembled wrongly fails while recovering the key, not where anyone looks for it. SDA proves an issuer signed this data once and nothing about the card in front of you."
                           wrapText="true" styleClass="form-label"/>

                    <HBox spacing="8">
                        <Button text="Issue Test Card" onAction="#handleOdaIssueTestCard"
                                styleClass="secondary-button" maxWidth="160"/>
                        <Button text="Clear ODA" onAction="#handleOdaClear" styleClass="secondary-button" maxWidth="120"/>
                    </HBox>

                    <Separator/>
                    <Label text="Certificate chain" styleClass="form-label ux-inline-689e8d50bc"/>
                    <GridPane hgap="10" vgap="9" styleClass="form-grid">
                        <columnConstraints>
                            <ColumnConstraints minWidth="210" prefWidth="210"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="CA public key modulus:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextArea fx:id="odaCaModulusArea" prefHeight="48" wrapText="true" promptText="Terminal CA key for this RID and index (8F)"
                                  GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="monospace-field"/>

                        <Label text="CA public key exponent:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="odaCaExponentField" promptText="03 or 010001" maxWidth="Infinity"
                                   GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>

                        <Label text="Issuer certificate (90):" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextArea fx:id="odaIssuerCertificateArea" prefHeight="48" wrapText="true" promptText="As long as the CA modulus"
                                  GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="monospace-field"/>

                        <Label text="Issuer key remainder (92):" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="odaIssuerRemainderField" promptText="Only when the key did not fit" maxWidth="Infinity"
                                   GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>

                        <Label text="Issuer key exponent (9F32):" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="odaIssuerExponentField" promptText="03 or 010001" maxWidth="Infinity"
                                   GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>

                        <Label text="ICC certificate (9F46):" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextArea fx:id="odaIccCertificateArea" prefHeight="48" wrapText="true" promptText="As long as the issuer modulus"
                                  GridPane.rowIndex="5" GridPane.columnIndex="1" styleClass="monospace-field"/>

                        <Label text="ICC key remainder (9F48):" GridPane.rowIndex="6" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="odaIccRemainderField" promptText="Only when the key did not fit" maxWidth="Infinity"
                                   GridPane.rowIndex="6" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>

                        <Label text="ICC key exponent (9F47):" GridPane.rowIndex="7" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="odaIccExponentField" promptText="03 or 010001" maxWidth="Infinity"
                                   GridPane.rowIndex="7" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>

                        <Label text="Static data to be authenticated:" GridPane.rowIndex="8" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextArea fx:id="odaStaticDataArea" prefHeight="48" wrapText="true" promptText="AFL records in the order they were read, then the AIP if tag 9F4A asks for it"
                                  GridPane.rowIndex="8" GridPane.columnIndex="1" styleClass="monospace-field"/>

                        <Label text="Application PAN (optional):" GridPane.rowIndex="9" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="odaPanField" promptText="Checked against the issuer identifier and the ICC certificate" maxWidth="Infinity"
                                   GridPane.rowIndex="9" GridPane.columnIndex="1" styleClass="form-field"/>
                    </GridPane>

                    <Separator/>
                    <Label text="Signatures" styleClass="form-label ux-inline-689e8d50bc"/>
                    <GridPane hgap="10" vgap="9" styleClass="form-grid">
                        <columnConstraints>
                            <ColumnConstraints minWidth="210" prefWidth="210"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Signed static data (93):" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextArea fx:id="odaSsadArea" prefHeight="48" wrapText="true" promptText="As long as the issuer modulus"
                                  GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="monospace-field"/>

                        <Label text="Signed dynamic data (9F4B):" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextArea fx:id="odaSdadArea" prefHeight="48" wrapText="true" promptText="As long as the ICC modulus"
                                  GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="monospace-field"/>

                        <Label text="DDOL data, or the Unpredictable Number for CDA:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="odaTerminalDataField" promptText="DDA hashes the whole DDOL; CDA hashes only tag 9F37" maxWidth="Infinity"
                                   GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>

                        <Label text="Cryptogram Information Data (9F27):" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="odaCidField" promptText="From the GENERATE AC response, for the CDA cross-check" maxWidth="Infinity"
                                   GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="monospace-field,form-field"/>

                        <Label text="Transaction data for the CDA hash:" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextArea fx:id="odaTransactionDataArea" prefHeight="48" wrapText="true" promptText="PDOL values, CDOL1 values, then the tags, lengths and values the card returned except 9F4B"
                                  GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="monospace-field"/>
                    </GridPane>

                    <FlowPane hgap="10.0" vgap="8.0" alignment="CENTER_LEFT" styleClass="responsive-action-bar">
                        <Button text="Recover Keys" onAction="#handleOdaRecoverKeys"
                                styleClass="action-button,primary-action" maxWidth="150"/>
                        <Button text="Verify SDA" onAction="#handleOdaVerifySda" styleClass="secondary-button" maxWidth="130"/>
                        <Button text="Verify DDA" onAction="#handleOdaVerifyDda" styleClass="secondary-button" maxWidth="130"/>
                        <Button text="Verify CDA" onAction="#handleOdaVerifyCda" styleClass="secondary-button" maxWidth="130"/>
                    </FlowPane>

                    <TextArea fx:id="odaResultArea" prefHeight="240" editable="false"
                              styleClass="result-area,monospace-field"/>
                </VBox>
            </TitledPane>
        </panes>
    </Accordion>
</VBox>
