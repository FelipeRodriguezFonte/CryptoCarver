<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Note: Button text below uses "COSE__Sign1" etc. (double underscore) deliberately — Button
     defaults mnemonicParsing=true and silently swallows a single "_" as a shortcut-underline
     marker (confirmed empirically: "Sign (COSE_Sign1)" rendered as "Sign (COSESign1)"). "__" is
     JavaFX's own escape for a literal underscore. Label defaults mnemonicParsing=false, so plain
     Labels below correctly keep a single underscore. -->
<VBox fx:id="coseContainer" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cryptocarver.ui.COSEController" managed="false" visible="false" spacing="10" styleClass="content-container-vbox,cose-module">
    <HBox alignment="CENTER_RIGHT">
        <Button text="Clear" onAction="#handleClear" styleClass="secondary-button"/>
        <Button text="Reset Defaults" onAction="#handleReset" styleClass="secondary-button"/>
    </HBox>

    <Label text="COSE (RFC 9052/9053) — CBOR-binary sibling of JOSE" styleClass="helper-text"/>
    <Label text="COSE_Sign1/COSE_Mac0/COSE_Encrypt0 (single-signer/single-key profile, same shape JOSE Compact covers). EdDSA is not offered: the underlying library has no code path for Ed25519 keys and hardcodes a JCA provider this app does not register."
           wrapText="true" styleClass="helper-text" style="-fx-text-fill: #9a3412;"/>

    <!-- SIGN1 SECTION -->
    <VBox fx:id="sign1Section" spacing="14" managed="false" visible="false">
        <Label text="COSE_Sign1" styleClass="section-header"/>
        <Accordion styleClass="module-accordion">
            <panes>
                <TitledPane text="Sign" expanded="true">
                    <VBox spacing="8" styleClass="module-pane-content">
                        <Label text="Algorithm:" styleClass="form-label"/>
                        <ComboBox fx:id="sign1AlgoCombo" prefWidth="220" styleClass="form-field"/>
                        <Label text="Private Key (PEM, EC or RSA):" styleClass="form-label"/>
                        <TextArea fx:id="sign1PrivateKeyArea" prefHeight="80" wrapText="true" promptText="-----BEGIN PRIVATE KEY-----"
                                  style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 11px;"/>
                        <Label text="Public Key (PEM, optional but recommended):" styleClass="form-label"/>
                        <TextArea fx:id="sign1PublicKeyArea" prefHeight="80" wrapText="true" promptText="-----BEGIN PUBLIC KEY-----"
                                  style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 11px;"/>
                        <Label text="Payload:" styleClass="form-label"/>
                        <TextArea fx:id="sign1PayloadArea" prefHeight="70" wrapText="true" promptText="Text to sign"/>
                        <Button text="Sign (COSE__Sign1)" onAction="#handleSign1" styleClass="action-button" maxWidth="220"/>
                        <TextArea fx:id="sign1OutputArea" prefHeight="90" editable="false" wrapText="true"
                                  style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 11px;"
                                  promptText="COSE_Sign1 message (hex) will appear here"/>
                    </VBox>
                </TitledPane>
                <TitledPane text="Verify">
                    <VBox spacing="8" styleClass="module-pane-content">
                        <Label text="Public Key (PEM):" styleClass="form-label"/>
                        <TextArea fx:id="verify1PublicKeyArea" prefHeight="80" wrapText="true" promptText="-----BEGIN PUBLIC KEY-----"
                                  style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 11px;"/>
                        <Label text="COSE_Sign1 Message (hex):" styleClass="form-label"/>
                        <TextArea fx:id="verify1MessageArea" prefHeight="90" wrapText="true" promptText="Paste the hex-encoded COSE_Sign1 message"
                                  style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 11px;"/>
                        <Button text="Verify (COSE__Sign1)" onAction="#handleVerify1" styleClass="action-button" maxWidth="220"/>
                        <TextArea fx:id="verify1ResultArea" prefHeight="90" editable="false" wrapText="true"
                                  promptText="Verification result will appear here"/>
                    </VBox>
                </TitledPane>
            </panes>
        </Accordion>
    </VBox>

    <!-- MAC0 SECTION -->
    <VBox fx:id="mac0Section" spacing="14" managed="false" visible="false">
        <Label text="COSE_Mac0" styleClass="section-header"/>
        <Accordion styleClass="module-accordion">
            <panes>
                <TitledPane text="Create MAC" expanded="true">
                    <VBox spacing="8" styleClass="module-pane-content">
                        <Label text="Algorithm:" styleClass="form-label"/>
                        <ComboBox fx:id="mac0AlgoCombo" prefWidth="220" styleClass="form-field"/>
                        <Label text="Key (hex):" styleClass="form-label"/>
                        <HBox spacing="6">
                            <TextField fx:id="mac0KeyField" HBox.hgrow="ALWAYS" promptText="Symmetric MAC key in hex"
                                       style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 11px;"/>
                            <Button text="Generate Key" onAction="#handleGenerateMac0Key" styleClass="secondary-button"/>
                        </HBox>
                        <Label text="Payload:" styleClass="form-label"/>
                        <TextArea fx:id="mac0PayloadArea" prefHeight="70" wrapText="true" promptText="Text to MAC"/>
                        <Button text="Create (COSE__Mac0)" onAction="#handleMac0" styleClass="action-button" maxWidth="220"/>
                        <TextArea fx:id="mac0OutputArea" prefHeight="90" editable="false" wrapText="true"
                                  style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 11px;"
                                  promptText="COSE_Mac0 message (hex) will appear here"/>
                    </VBox>
                </TitledPane>
                <TitledPane text="Verify MAC">
                    <VBox spacing="8" styleClass="module-pane-content">
                        <Label text="Key (hex):" styleClass="form-label"/>
                        <TextField fx:id="verifyMac0KeyField" promptText="Symmetric MAC key in hex"
                                   style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 11px;"/>
                        <Label text="COSE_Mac0 Message (hex):" styleClass="form-label"/>
                        <TextArea fx:id="verifyMac0MessageArea" prefHeight="90" wrapText="true" promptText="Paste the hex-encoded COSE_Mac0 message"
                                  style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 11px;"/>
                        <Button text="Verify (COSE__Mac0)" onAction="#handleVerifyMac0" styleClass="action-button" maxWidth="220"/>
                        <TextArea fx:id="verifyMac0ResultArea" prefHeight="90" editable="false" wrapText="true"
                                  promptText="Verification result will appear here"/>
                    </VBox>
                </TitledPane>
            </panes>
        </Accordion>
    </VBox>

    <!-- ENCRYPT0 SECTION -->
    <VBox fx:id="encrypt0Section" spacing="14" managed="false" visible="false">
        <Label text="COSE_Encrypt0" styleClass="section-header"/>
        <Accordion styleClass="module-accordion">
            <panes>
                <TitledPane text="Encrypt" expanded="true">
                    <VBox spacing="8" styleClass="module-pane-content">
                        <Label text="Algorithm:" styleClass="form-label"/>
                        <ComboBox fx:id="encrypt0AlgoCombo" prefWidth="220" styleClass="form-field"/>
                        <Label text="Key (hex):" styleClass="form-label"/>
                        <HBox spacing="6">
                            <TextField fx:id="encrypt0KeyField" HBox.hgrow="ALWAYS" promptText="Symmetric key in hex"
                                       style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 11px;"/>
                            <Button text="Generate Key" onAction="#handleGenerateEncrypt0Key" styleClass="secondary-button"/>
                        </HBox>
                        <Label text="Payload:" styleClass="form-label"/>
                        <TextArea fx:id="encrypt0PayloadArea" prefHeight="70" wrapText="true" promptText="Text to encrypt"/>
                        <Button text="Encrypt (COSE__Encrypt0)" onAction="#handleEncrypt0" styleClass="action-button" maxWidth="220"/>
                        <TextArea fx:id="encrypt0OutputArea" prefHeight="90" editable="false" wrapText="true"
                                  style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 11px;"
                                  promptText="COSE_Encrypt0 message (hex) will appear here"/>
                    </VBox>
                </TitledPane>
                <TitledPane text="Decrypt">
                    <VBox spacing="8" styleClass="module-pane-content">
                        <Label text="Key (hex):" styleClass="form-label"/>
                        <TextField fx:id="decrypt0KeyField" promptText="Symmetric key in hex"
                                   style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 11px;"/>
                        <Label text="COSE_Encrypt0 Message (hex):" styleClass="form-label"/>
                        <TextArea fx:id="decrypt0MessageArea" prefHeight="90" wrapText="true" promptText="Paste the hex-encoded COSE_Encrypt0 message"
                                  style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 11px;"/>
                        <Button text="Decrypt (COSE__Encrypt0)" onAction="#handleDecrypt0" styleClass="action-button" maxWidth="220"/>
                        <TextArea fx:id="decrypt0ResultArea" prefHeight="90" editable="false" wrapText="true"
                                  promptText="Decrypted payload will appear here"/>
                    </VBox>
                </TitledPane>
            </panes>
        </Accordion>
    </VBox>
</VBox>
