<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="xmlSecurityContainer" managed="false" visible="false" spacing="14" styleClass="content-container-vbox,xml-module" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cryptocarver.ui.XMLSignatureController">
    <HBox alignment="CENTER_RIGHT">
        <Button text="Clear" onAction="#handleClear" styleClass="secondary-button"/>
        <Button text="Reset Defaults" onAction="#handleReset" styleClass="secondary-button"/>
    </HBox>
    <Accordion fx:id="xmlAccordion" styleClass="module-accordion">
        <panes>
            <TitledPane text="📝 Sign XML (XAdES)" expanded="true">
                <VBox spacing="12" styleClass="module-pane-content">
                    <GridPane hgap="10" vgap="9" styleClass="form-grid">
                        <columnConstraints>
                            <ColumnConstraints minWidth="160" prefWidth="160"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="XML File to Sign:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                        <HBox spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <TextField fx:id="xmlSignInputPathField" HBox.hgrow="ALWAYS" styleClass="form-field"/>
                            <Button text="..." onAction="#handleBrowseXMLSignInput" style="-fx-min-width: 25px;"/>
                        </HBox>

                        <Label text="Signature Source:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                        <HBox spacing="8" GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <fx:define>
                                <ToggleGroup fx:id="xmlSignSourceToggleGroup"/>
                            </fx:define>
                            <RadioButton fx:id="xmlSignSourceLocalRadio" text="Local KeyStore / PEM" toggleGroup="$xmlSignSourceToggleGroup" selected="true" onAction="#handleXMLSignSourceChanged"/>
                            <RadioButton fx:id="xmlSignSourcePkcs11Radio" text="Connected PKCS#11 Token" toggleGroup="$xmlSignSourceToggleGroup" onAction="#handleXMLSignSourceChanged"/>
                        </HBox>
                    </GridPane>

                    <VBox fx:id="xmlSignLocalKeyBox" spacing="12" styleClass="module-pane-content">
                        <GridPane hgap="10" vgap="9" styleClass="form-grid">
                            <columnConstraints>
                                <ColumnConstraints minWidth="160" prefWidth="160"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <Label fx:id="xmlSignKeyPathLabel" text="PKCS#12 / JKS / PEM KeyStore:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                            <HBox spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                <TextField fx:id="xmlSignKeyPathField" HBox.hgrow="ALWAYS" styleClass="form-field"/>
                                <Button text="..." onAction="#handleBrowseXMLKey" style="-fx-min-width: 25px;"/>
                            </HBox>

                            <Label fx:id="xmlSignKeyPasswordLabel" text="KeyStore Password:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                            <PasswordField fx:id="xmlSignKeyPasswordField" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="form-field"/>
                        </GridPane>
                    </VBox>

                    <GridPane hgap="10" vgap="9" styleClass="form-grid">
                        <columnConstraints>
                            <ColumnConstraints minWidth="160" prefWidth="160"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Key Alias (Select Key):" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                        <HBox spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <ComboBox fx:id="xmlSignKeyAliasCombo" prefWidth="250" HBox.hgrow="ALWAYS" styleClass="form-field"/>
                            <Button text="Load Keys" onAction="#handleLoadXMLKeys" styleClass="secondary-button"/>
                        </HBox>

                        <Label text="Signature Level:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                        <ComboBox fx:id="xmlSignLevelCombo" prefWidth="250" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="form-field"/>

                        <Label text="Signature Packaging:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
                        <ComboBox fx:id="xmlSignPackagingCombo" prefWidth="250" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="form-field"/>
                    </GridPane>

                    <Separator/>

                    <GridPane hgap="10" vgap="9" styleClass="form-grid">
                        <columnConstraints>
                            <ColumnConstraints minWidth="160" prefWidth="160"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="TSA (required for T/LT/LTA):" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                        <HBox spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <ComboBox fx:id="xmlSignTsaUrlCombo" editable="true" promptText="Select a preset or enter your corporate TSA URL" HBox.hgrow="ALWAYS" styleClass="form-field"/>
                            <Button text="Save TSA" onAction="#handleSaveTSA" styleClass="secondary-button"/>
                            <Button text="Test TSA" onAction="#handleTestTSA" styleClass="secondary-button"/>
                        </HBox>

                        <Label text="TSA Auth:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                        <HBox spacing="8" GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <ComboBox fx:id="xmlSignTsaAuthTypeCombo" promptText="Auth Type" prefWidth="100" styleClass="form-field"/>
                            <TextField fx:id="xmlSignTsaUserField" promptText="User" prefWidth="100" styleClass="form-field"/>
                            <PasswordField fx:id="xmlSignTsaPasswordField" promptText="Password/Token (Ephemeral)" HBox.hgrow="ALWAYS" styleClass="form-field"/>
                        </HBox>

                        <Label text="TSA Profile:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
                        <HBox spacing="8" GridPane.rowIndex="2" GridPane.columnIndex="1">
                            <ComboBox fx:id="xmlSignTsaProfileCombo" promptText="Saved TSA profile" HBox.hgrow="ALWAYS" styleClass="form-field"/>
                            <Button text="Load" onAction="#handleLoadTSASavedProfile" styleClass="secondary-button"/>
                            <Button text="Delete" onAction="#handleDeleteTSASavedProfile" styleClass="secondary-button"/>
                        </HBox>

                        <Label text="Save New Profile:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="form-label"/>
                        <HBox spacing="8" GridPane.rowIndex="3" GridPane.columnIndex="1">
                            <TextField fx:id="xmlSignTsaProfileNameField" promptText="Profile name" HBox.hgrow="ALWAYS" styleClass="form-field"/>
                            <Button text="Save Profile" onAction="#handleSaveTSASavedProfile" styleClass="secondary-button"/>
                        </HBox>
                    </GridPane>

                    <Button text="Sign XML" onAction="#handleSignXML" styleClass="action-button,primary-action" maxWidth="180"/>

                    <Label text="Signed XML Output:" styleClass="form-label"/>
                    <TextArea fx:id="xmlSignOutputArea" prefHeight="200" styleClass="result-area,monospace-field"/>
                    <Button text="Save Signed XML..." onAction="#handleSaveSignedXML" styleClass="secondary-button" maxWidth="180"/>
                </VBox>
            </TitledPane>

            <TitledPane text="🔬 Inspect Signed XML">
                <VBox spacing="12" styleClass="module-pane-content">
                    <Label text="Signed XML to inspect (local structural analysis, no validation):" styleClass="form-label"/>
                    <TextArea fx:id="xmlInspectInputArea" prefHeight="180" styleClass="monospace-field"/>
                    <HBox spacing="8">
                        <Button text="Open XML..." onAction="#handleBrowseXMLInspectorInput" styleClass="secondary-button"/>
                        <Button text="Inspect Signed XML" onAction="#handleInspectSignedXML" styleClass="action-button,primary-action"/>
                    </HBox>
                    <Label text="Signature structure report:" styleClass="form-label"/>
                    <TextArea fx:id="xmlInspectReportArea" prefHeight="280" editable="false" styleClass="result-area,monospace-field"/>
                </VBox>
            </TitledPane>

            <TitledPane text="⏱ RFC 3161 Timestamp">
                <VBox spacing="12" styleClass="module-pane-content">
                    <GridPane hgap="10" vgap="9" styleClass="form-grid">
                        <columnConstraints>
                            <ColumnConstraints minWidth="160" prefWidth="160"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="File to timestamp:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                        <HBox spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <TextField fx:id="xmlTimestampFileField" HBox.hgrow="ALWAYS" styleClass="form-field"/>
                            <Button text="Open..." onAction="#handleBrowseTimestampFile" style="-fx-min-width: 25px;"/>
                        </HBox>

                        <Label text="Imprint hash:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                        <ComboBox fx:id="xmlTimestampHashCombo" prefWidth="180" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="form-field"/>

                        <Label text="TSA URL:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="xmlTimestampUrlField" promptText="https://your-tsa.example/" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="form-field"/>
                    </GridPane>

                    <HBox spacing="8">
                        <Button text="Request Timestamp" onAction="#handleRequestTimestamp" styleClass="action-button,primary-action"/>
                        <Button text="Save Token..." onAction="#handleSaveTimestampToken" styleClass="secondary-button"/>
                    </HBox>

                    <Separator/>

                    <GridPane hgap="10" vgap="9" styleClass="form-grid">
                        <columnConstraints>
                            <ColumnConstraints minWidth="160" prefWidth="160"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Saved token to inspect (opt):" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                        <HBox spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <TextField fx:id="xmlTimestampTokenField" promptText="Path to .tsq/.tst" HBox.hgrow="ALWAYS" styleClass="form-field"/>
                            <Button text="Open..." onAction="#handleBrowseTimestampToken" style="-fx-min-width: 25px;"/>
                        </HBox>

                        <Label text="TrustStore (optional):" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                        <HBox spacing="8" GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <TextField fx:id="xmlTimestampTrustStoreField" promptText="Truststore path" HBox.hgrow="ALWAYS" styleClass="form-field"/>
                            <Button text="..." onAction="#handleBrowseTimestampTrustStore" style="-fx-min-width: 25px;"/>
                            <PasswordField fx:id="xmlTimestampTrustStorePasswordField" promptText="Password" styleClass="form-field"/>
                        </HBox>
                    </GridPane>

                    <HBox spacing="8">
                        <Button text="Inspect Token" onAction="#handleInspectTimestampToken" styleClass="secondary-button"/>
                        <Button text="Validate Token" onAction="#handleValidateTimestampToken" styleClass="action-button,primary-action"/>
                    </HBox>
                    <Label text="RFC 3161 token report:" styleClass="form-label"/>
                    <TextArea fx:id="xmlTimestampReportArea" prefHeight="220" editable="false" styleClass="result-area,monospace-field"/>
                </VBox>
            </TitledPane>

            <TitledPane text="🔍 Verify XML (XAdES)">
                <VBox spacing="12" styleClass="module-pane-content">
                    <Label text="Paste Signed XML Content:" styleClass="form-label"/>
                    <TextArea fx:id="xmlVerifyInputArea" prefHeight="200" styleClass="monospace-field"/>

                    <GridPane hgap="10" vgap="9" styleClass="form-grid">
                        <columnConstraints>
                            <ColumnConstraints minWidth="160" prefWidth="160"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="TrustStore Profile (opt):" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                        <HBox spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <ComboBox fx:id="xmlVerifyTrustStoreProfileCombo" promptText="Saved KeyStore profile" HBox.hgrow="ALWAYS" styleClass="form-field"/>
                            <Button text="Load" onAction="#handleLoadXMLTrustStoreProfile" styleClass="secondary-button"/>
                        </HBox>

                        <Label text="TrustStore Path:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                        <HBox spacing="8" GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <TextField fx:id="xmlVerifyTrustStorePathField" HBox.hgrow="ALWAYS" styleClass="form-field"/>
                            <Button text="..." onAction="#handleBrowseXMLTrustStore" style="-fx-min-width: 25px;"/>
                        </HBox>

                        <Label text="TrustStore Password:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
                        <PasswordField fx:id="xmlVerifyTrustStorePasswordField" promptText="TrustStore password" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="form-field"/>
                    </GridPane>

                    <Button text="Verify XML" onAction="#handleVerifyXML" styleClass="action-button,primary-action" maxWidth="180"/>

                    <Label text="Verification Report:" styleClass="form-label"/>
                    <TextArea fx:id="xmlVerifyReportArea" prefHeight="150" editable="false" styleClass="result-area,monospace-field"/>
                </VBox>
            </TitledPane>
        </panes>
    </Accordion>
</VBox>
