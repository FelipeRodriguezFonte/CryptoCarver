                                    <Label text="Usage:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-size: 11px;"/>
                                    <ComboBox fx:id="tr31UsageCombo" GridPane.rowIndex="1" GridPane.columnIndex="1"
                                             prefWidth="150" style="-fx-font-size: 11px;"/>

                                    <Label text="Algorithm:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-size: 11px;"/>
                                    <ComboBox fx:id="tr31AlgorithmCombo" GridPane.rowIndex="2" GridPane.columnIndex="1"
                                             prefWidth="150" style="-fx-font-size: 11px;"/>

                                    <Label text="Mode:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-size: 11px;"/>
                                    <ComboBox fx:id="tr31ModeCombo" GridPane.rowIndex="3" GridPane.columnIndex="1"
                                             prefWidth="150" style="-fx-font-size: 11px;"/>

                                    <Label text="Exportability:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-size: 11px;"/>
                                    <ComboBox fx:id="tr31ExportabilityCombo" GridPane.rowIndex="4" GridPane.columnIndex="1"
                                             prefWidth="150" style="-fx-font-size: 11px;"/>
                                </GridPane>
                                <Label text="Optional blocks (compact, optional):" style="-fx-font-size: 11px;"/>
                                <TextField fx:id="tr31OptionalBlocksField" promptText="0100KS02ABCD  (count, reserved, ID, length, data)"
                                          style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 11px;"/>

                                <Button text="Wrap Key (Export)" onAction="#handleTR31Export"
                                        styleClass="action-button" maxWidth="180" style="-fx-font-size: 11px;"/>
                                <HBox spacing="6">
                                    <Button text="Clear" onAction="#handleTR31Clear" styleClass="secondary-button"/>
                                    <Button text="Reset Defaults" onAction="#handleTR31Reset" styleClass="secondary-button"/>
                                </HBox>

                                <TextArea fx:id="tr31ExportResultArea" prefHeight="120" editable="false" wrapText="true"
                                          style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 11px;"
                                          promptText="Export results will appear here..."/>
                            </VBox>
                        </Tab>

                        <Tab text="Import (Unwrap)">
                            <VBox spacing="6" style="-fx-padding: 8;">
                                <Label text="KBPK:" style="-fx-font-size: 11px;"/>
                                <TextField fx:id="tr31KbpkImportField" promptText="Key Block Protection Key (hex)"
                                          style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 11px;"/>

                                <Label text="TR-31 Key Block:" style="-fx-font-size: 11px;"/>
                                <TextArea fx:id="tr31KeyBlockField" prefHeight="60" wrapText="true"
                                          style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 11px;"
                                          promptText="Paste TR-31 key block here..."/>

                                <HBox spacing="4" alignment="CENTER_LEFT">
                                    <Label text="Expected Length:" style="-fx-font-size: 11px;"/>
                                    <TextField fx:id="tr31KeyLengthField" promptText="bytes (optional)"
                                              prefWidth="120" style="-fx-font-size: 11px;"/>
                                </HBox>

                                <HBox spacing="6">
                                    <Button text="Unwrap Key" onAction="#handleTR31Import"
                                            styleClass="action-button" HBox.hgrow="ALWAYS" style="-fx-font-size: 11px;"/>
