                                <Label text="Generated RSA Key Pair Summary" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                                <Label fx:id="rsaSummarySavedStatusLabel" text="" style="-fx-font-size: 11px; -fx-text-fill: #10b981; -fx-font-weight: bold;"/>
                            </HBox>
                            <GridPane hgap="12" vgap="4">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="130" prefWidth="140"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>
                                <Label text="Algorithm / Size:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                                <Label fx:id="rsaSummaryAlgoLabel" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                <Label text="Public Fingerprint (SHA-256):" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                                <Label fx:id="rsaSummaryFingerprintLabel" styleClass="monospace-field" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                <Label text="Public Key Size:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
                                <Label fx:id="rsaSummaryPubLenLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                <Label text="Private Key Size:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="form-label"/>
                                <Label fx:id="rsaSummaryPrivLenLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                                <Label text="Creation Time:" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="form-label"/>
                                <Label fx:id="rsaSummaryCreatedLabel" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                                <Label text="Origin:" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="form-label"/>
