                        <!-- Block 3: Generated Key Pair Summary -->
                        <VBox fx:id="rsaSummaryCard" visible="false" managed="false" spacing="6" styleClass="summary-card,info-card" style="-fx-padding: 10; -fx-background-color: rgba(59, 130, 246, 0.08); -fx-background-radius: 6; -fx-border-color: rgba(59, 130, 246, 0.3); -fx-border-radius: 6; -fx-border-width: 1;">
