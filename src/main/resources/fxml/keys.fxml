                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="Generated ECDSA Key Pair Summary" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                                <Label fx:id="ecdsaSummarySavedStatusLabel" text="" style="-fx-font-size: 11px; -fx-text-fill: #10b981; -fx-font-weight: bold;"/>
                            </HBox>
                            <GridPane hgap="12" vgap="4">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="130" prefWidth="140"/>
