                                </GridPane>
                                <Label text="Ignored when the pasted data is already a Crypto Envelope — its own header is used instead." wrapText="true" styleClass="helper-text" style="-fx-font-size: 10px;"/>
                                <Button text="Unwrap Key" onAction="#handleRsaKexImport" styleClass="action-button" maxWidth="180" style="-fx-font-size: 11px;"/>
                                <TextArea fx:id="rsaKexImportResultArea" prefHeight="120" editable="false" wrapText="true"
                                          style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 11px;"
                                          promptText="Import results will appear here..."/>
                            </VBox>
                        </Tab>
                    </TabPane>
                </VBox>
            </TitledPane>
            </panes>
        </Accordion>
        <fx:include fx:id="pkcs11Profiles" source="pkcs11_profiles.fxml"/>
    </VBox>

    <!-- Asymmetric Keys Accordion -->
    <VBox fx:id="asymmetricKeysContainer" managed="false" visible="false" spacing="0">
        <Accordion>
            <panes>
                <!-- RSA KEY GENERATION -->
                <TitledPane text="🔐 RSA Key Generation" expanded="true">
                    <VBox spacing="10" styleClass="module-pane-content">
                        <!-- Compact Header -->
                        <VBox spacing="4" style="-fx-padding: 6 10; -fx-background-color: rgba(59, 130, 246, 0.05); -fx-background-radius: 4;">
                            <Label text="RSA (Rivest-Shamir-Adleman) Workbench" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                            <Label text="Suitable for asymmetric encryption, digital signatures, and X.509 certificates. Minimum recommended size: 2048 bits." wrapText="true" styleClass="helper-text"/>
                        </VBox>

                        <!-- Block 1: Configure & Block 2: Generate -->
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="Key Size:" styleClass="form-label"/>
                            <ComboBox fx:id="rsaKeySizeCombo" prefWidth="120" styleClass="form-field"/>
                            <Button fx:id="rsaGenerateBtn" text="Generate RSA Key Pair" onAction="#handleGenerateRSA" styleClass="action-button,primary-action"/>
                            <Label text="⚠️ Keys &gt; 4096 bits may take several seconds" style="-fx-text-fill: #e67e22; -fx-font-style: italic; -fx-font-size: 10px;"/>
