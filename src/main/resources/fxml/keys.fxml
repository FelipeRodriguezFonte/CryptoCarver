                                            styleClass="action-button" HBox.hgrow="ALWAYS" style="-fx-font-size: 11px;"/>
                                </HBox>

                                <TextArea fx:id="tr31ImportResultArea" prefHeight="120" editable="false" wrapText="true"
                                          style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 11px;"
                                          promptText="Import results will appear here..."
                                          managed="false" visible="false"/>
                            </VBox>
                        </Tab>
                    </TabPane>
                </VBox>
