                            </VBox>
                        </Tab>
                        <Tab text="Import (Unwrap)">
                            <VBox spacing="6" style="-fx-padding: 8;">
                                <Label text="Recipient Private Key (PEM):" style="-fx-font-size: 11px;"/>
