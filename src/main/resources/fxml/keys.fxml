                            <Button fx:id="rsaUseSignaturesBtn" text="Use in Digital Signatures" onAction="#handleUseRsaInSignatures" styleClass="secondary-button" style="-fx-font-size: 11px;"/>
                            <Button fx:id="rsaUseCertificatesBtn" text="Use for Certificate / CSR" onAction="#handleUseRsaInCertificates" styleClass="secondary-button" style="-fx-font-size: 11px;"/>
                            <Button fx:id="rsaClearBtn" text="Clear Pair" onAction="#handleClearRsa" styleClass="btn-danger" style="-fx-font-size: 11px;"/>
                        </FlowPane>
                    </VBox>
                </TitledPane>

                <!-- ECDSA KEY GENERATION -->
                <TitledPane text="📈 ECDSA Key Generation">
                    <VBox spacing="10" styleClass="module-pane-content">
