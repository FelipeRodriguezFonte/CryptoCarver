                            <Tab text="Private Key (PEM)" userData="PRIVATE">
                                <TextArea fx:id="rsaPrivateKeyArea" wrapText="true" editable="false" styleClass="result-area,monospace-field" promptText="Private key will appear here..."/>
                            </Tab>
                        </TabPane>

