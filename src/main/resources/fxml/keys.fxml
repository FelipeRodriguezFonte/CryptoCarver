<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="keysRoot" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cryptocarver.ui.KeysController" spacing="14" styleClass="content-container-vbox,keys-module">
    <VBox fx:id="symmetricKeysContainer" managed="true" visible="true">
        <Accordion styleClass="module-accordion">
            <panes>
                <!-- KEY LAB -->
                <TitledPane text="🎛 Key Lab" fx:id="keyLabPane" expanded="true">
                    <VBox spacing="10" styleClass="module-pane-content">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Search:" styleClass="form-label"/>
                            <TextField fx:id="keyLabSearchField" promptText="Search keys by name or algorithm..." HBox.hgrow="ALWAYS"/>
                            <ComboBox fx:id="keyLabStatusFilter" prefWidth="120"/>
                            <Button text="Import Metadata" onAction="#handleImportKeyLabMetadata" styleClass="secondary-button"/>
                            <Button text="Export Metadata" onAction="#handleExportKeyLabMetadata" styleClass="secondary-button"/>
                        </HBox>
                        <SplitPane dividerPositions="0.6" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                            <!-- Left Side: Table & Creation Toolbar -->
                            <VBox spacing="10">
                                <TableView fx:id="keyLabTable" VBox.vgrow="ALWAYS" prefHeight="250">
                                    <placeholder>
                                        <Label text="No keys in Lab. Generate or import one below!"/>
                                    </placeholder>
                                </TableView>
                                <TitledPane text="Add New Key" expanded="false" styleClass="sub-accordion">
                                    <VBox spacing="8">
                                        <GridPane hgap="8" vgap="8">
                                            <columnConstraints>
                                                <ColumnConstraints minWidth="80" prefWidth="80"/>
                                                <ColumnConstraints minWidth="150" prefWidth="180" hgrow="ALWAYS"/>
                                            </columnConstraints>
                                            <rowConstraints>
                                                <RowConstraints minHeight="25"/>
                                                <RowConstraints minHeight="25"/>
                                                <RowConstraints minHeight="25"/>
                                            </rowConstraints>
                                            <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                                            <TextField fx:id="keyLabNewNameField" promptText="Enter key alias/name..." GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                            <Label text="Algorithm:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                                            <ComboBox fx:id="keyLabNewAlgoCombo" GridPane.rowIndex="1" GridPane.columnIndex="1" maxWidth="Infinity"/>

                                            <Label text="Key Size:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
                                            <ComboBox fx:id="keyLabNewSizeCombo" GridPane.rowIndex="2" GridPane.columnIndex="1" maxWidth="Infinity"/>
                                        </GridPane>
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <Button text="Generate Key" onAction="#handleKeyLabGenerate" styleClass="action-button-primary"/>
                                            <Separator orientation="VERTICAL"/>
                                            <PasswordField fx:id="keyLabImportBytesField" promptText="Or paste raw key bytes in hex..." HBox.hgrow="ALWAYS" styleClass="monospace-field"/>
                                            <Button fx:id="keyLabImportBtn" text="Import Key" onAction="#handleKeyLabImport" styleClass="secondary-button"/>
                                        </HBox>
                                    </VBox>
                                </TitledPane>
                            </VBox>
                            <!-- Right Side: Detail Panel -->
                            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                                <VBox spacing="8" style="-fx-padding: 0 0 0 10;">
                                    <Label text="Key Details" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                                    <GridPane hgap="8" vgap="6">
                                        <columnConstraints>
                                            <ColumnConstraints minWidth="90" prefWidth="90"/>
                                            <ColumnConstraints hgrow="ALWAYS"/>
                                        </columnConstraints>
                                        <Label text="ID/Alias:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                                        <TextField fx:id="keyLabDetailIdField" editable="false" styleClass="monospace-field" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                        <Label text="Name:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                                        <TextField fx:id="keyLabDetailNameField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                        <Label text="Algorithm:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
                                        <Label fx:id="keyLabDetailAlgoLabel" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                        <Label text="Bits:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="form-label"/>
                                        <Label fx:id="keyLabDetailBitsLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                                        <Label text="KCV:" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="form-label"/>
                                        <Label fx:id="keyLabDetailKcvLabel" styleClass="monospace-field" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                                        <Label text="Fingerprint:" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="form-label"/>
                                        <Label fx:id="keyLabDetailFingerprintLabel" styleClass="monospace-field" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                                        <Label text="Origin:" GridPane.rowIndex="6" GridPane.columnIndex="0" styleClass="form-label"/>
                                        <Label fx:id="keyLabDetailOriginLabel" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                                        <Label text="Created:" GridPane.rowIndex="7" GridPane.columnIndex="0" styleClass="form-label"/>
                                        <Label fx:id="keyLabDetailCreatedLabel" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                                        <Label text="Modified:" GridPane.rowIndex="8" GridPane.columnIndex="0" styleClass="form-label"/>
                                        <Label fx:id="keyLabDetailModifiedLabel" GridPane.rowIndex="8" GridPane.columnIndex="1"/>

                                        <Label text="Status:" GridPane.rowIndex="9" GridPane.columnIndex="0" styleClass="form-label"/>
                                        <Label fx:id="keyLabDetailStatusLabel" GridPane.rowIndex="9" GridPane.columnIndex="1"/>

                                        <Label text="Key Value:" GridPane.rowIndex="10" GridPane.columnIndex="0" styleClass="form-label"/>
                                        <VBox spacing="4" GridPane.rowIndex="10" GridPane.columnIndex="1">
                                            <TextField fx:id="keyLabDetailValueField" editable="false" styleClass="monospace-field"/>
                                            <HBox spacing="6">
                                                <Button fx:id="keyLabRevealBtn" text="Reveal Value" onAction="#handleKeyLabReveal" styleClass="secondary-button" style="-fx-font-size: 10px;"/>
                                                <Button text="Copy ID" onAction="#handleKeyLabCopyId" styleClass="secondary-button" style="-fx-font-size: 10px;"/>
                                            </HBox>
                                        </VBox>
                                    </GridPane>
                                    <Separator style="-fx-padding: 8 0;"/>
                                    <FlowPane prefWrapLength="900" styleClass="responsive-action-bar">
                                        <Button text="Save Metadata" onAction="#handleKeyLabSaveMetadata" styleClass="action-button-primary"/>
                                        <Button fx:id="keyLabArchiveBtn" text="Archive" onAction="#handleKeyLabArchive" styleClass="secondary-button"/>
                                        <Button text="Delete Key" onAction="#handleKeyLabDelete" styleClass="btn-danger"/>
                                    </FlowPane>
                                </VBox>
                            </ScrollPane>
                        </SplitPane>
                    </VBox>
                </TitledPane>

                <!-- KEY GENERATION -->
                <TitledPane text="🔑 Key Generation" expanded="true">
                <VBox spacing="12" styleClass="module-pane-content">
                    <GridPane hgap="10" vgap="9" styleClass="form-grid">
                        <columnConstraints>
                            <ColumnConstraints minWidth="70" prefWidth="70"/>
                            <ColumnConstraints minWidth="180" prefWidth="220"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Type:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                        <ComboBox fx:id="keyTypeCombo" GridPane.rowIndex="0" GridPane.columnIndex="1" maxWidth="Infinity" styleClass="form-field"/>

                        <CheckBox fx:id="forceOddParityCheck" text="Force Odd Parity (DES/3DES)"
                                  selected="true" GridPane.rowIndex="0" GridPane.columnIndex="2" style="-fx-font-size: 10px;"/>
                    </GridPane>

                    <FlowPane prefWrapLength="900" styleClass="responsive-action-bar">
                        <Button text="Generate Key" onAction="#handleGenerateKey"
                                styleClass="action-button,primary-action"/>
                        <Button fx:id="saveGeneratedKeyButton" text="Save to Simulated HSM / Key Lab…" onAction="#handleSaveGeneratedKeyToLab"
                                disable="true" styleClass="action-button,secondary-action"/>
                    </FlowPane>

                    <VBox fx:id="generatedKeySummaryCard" visible="false" managed="false" spacing="8" styleClass="summary-card,info-card" style="-fx-padding: 10; -fx-background-color: rgba(59, 130, 246, 0.08); -fx-background-radius: 6; -fx-border-color: rgba(59, 130, 246, 0.3); -fx-border-radius: 6; -fx-border-width: 1;">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Generated Key Summary" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                            <Label fx:id="summarySavedStatusLabel" text="" style="-fx-font-size: 11px; -fx-text-fill: #10b981; -fx-font-weight: bold;"/>
                        </HBox>
                        <GridPane hgap="12" vgap="6">
                            <columnConstraints>
                                <ColumnConstraints minWidth="130" prefWidth="140"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="Algorithm / Type:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                            <Label fx:id="summaryAlgoLabel" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Label text="Length:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                            <Label fx:id="summaryLengthLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="Key Check Value (KCV):" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
                            <Label fx:id="summaryKcvLabel" styleClass="monospace-field" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                            <Label text="Fingerprint (SHA-256):" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="form-label"/>
                            <Label fx:id="summaryFingerprintLabel" styleClass="monospace-field" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                            <Label text="Odd Parity:" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="form-label"/>
                            <Label fx:id="summaryParityLabel" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                            <Label text="Origin:" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="form-label"/>
                            <Label fx:id="summaryOriginLabel" text="Generated locally" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                        </GridPane>

                        <FlowPane prefWrapLength="900" styleClass="responsive-action-bar">
                            <Button fx:id="copyGeneratedKeyButton" text="Copy Key" onAction="#handleCopyGeneratedKey" styleClass="secondary-button" style="-fx-font-size: 11px;"/>
                            <Button fx:id="copyGeneratedKcvButton" text="Copy KCV" onAction="#handleCopyGeneratedKcv" styleClass="secondary-button" style="-fx-font-size: 11px;"/>
                            <Button fx:id="copyGeneratedSummaryButton" text="Copy Summary" onAction="#handleCopyGeneratedSummary" styleClass="secondary-button" style="-fx-font-size: 11px;"/>
                            <Button fx:id="saveGeneratedSummaryButton" text="Save to Key Lab…" onAction="#handleSaveGeneratedKeyToLab" styleClass="secondary-button" style="-fx-font-size: 11px;"/>
                            <Button fx:id="openValidationButton" text="Validate / Open Validation &amp; KCV" onAction="#handleOpenValidationAndKcv" styleClass="secondary-button" style="-fx-font-size: 11px;"/>
                        </FlowPane>
                    </VBox>

                    <Label text="After generating, register the key in the Simulated HSM with a name, allowed usages and exportability."
                           styleClass="helper-text" wrapText="true"/>

                    <TextArea fx:id="generatedKeyField" prefHeight="280" editable="false" wrapText="true"
                              styleClass="result-area,monospace-field"
                              promptText="Generated key will appear here..."/>
                </VBox>
            </TitledPane>

            <!-- KEY VALIDATION -->
            <TitledPane fx:id="validationPane" text="✓ Validation &amp; KCV">
                <VBox spacing="12" styleClass="module-pane-content">
                    <TextField fx:id="keyInputField" promptText="Enter key in hexadecimal..."
                              styleClass="form-field,monospace-field"/>

                    <Button text="Validate &amp; Calculate KCVs" onAction="#handleValidateKey"
                            styleClass="action-button,primary-action"/>

                    <TextArea fx:id="validationResultArea" prefHeight="260" editable="false" wrapText="true"
                              styleClass="result-area,monospace-field"
                              promptText="Validation results will appear here..."
                              managed="false" visible="false"/>
                </VBox>
            </TitledPane>

            <!-- KEY MATERIAL INSPECTOR -->
            <TitledPane text="🔎 Key Material Inspector">
                <VBox spacing="12" styleClass="module-pane-content">
                    <Label text="Paste a PEM public/private key or an X.509 certificate to inspect its fingerprint, size and security hints." wrapText="true" styleClass="helper-text"/>
                    <TextArea fx:id="keyMaterialInputArea" prefHeight="110" wrapText="true" promptText="-----BEGIN PUBLIC KEY----- / -----BEGIN PRIVATE KEY----- / -----BEGIN CERTIFICATE-----"
                              styleClass="monospace-field"/>
                    <Button text="Inspect Material" onAction="#handleInspectKeyMaterial" styleClass="action-button,primary-action"/>
                    <TextArea fx:id="keyMaterialReportArea" prefHeight="210" editable="false" wrapText="true"
                              styleClass="result-area,monospace-field"/>
                </VBox>
            </TitledPane>


            <!-- KEYSTORE INSPECTOR -->
            <TitledPane text="🗄 KeyStore Inspector">
                <VBox spacing="5" style="-fx-padding: 6;">
                    <Label text="Lists metadata only; it never exports private or secret keys." style="-fx-font-size: 10px; -fx-text-fill: #666;"/>
                    <HBox spacing="5">
                        <ComboBox fx:id="keyStoreProfileCombo" promptText="Saved profile" HBox.hgrow="ALWAYS"/>
                        <Button text="Load" onAction="#handleLoadKeyStoreProfile" styleClass="secondary-button"/>
                    </HBox>
                    <HBox spacing="6">
                        <ComboBox fx:id="keyStoreTypeCombo" prefWidth="110"/>
                        <PasswordField fx:id="keyStorePasswordField" promptText="Store password" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <CheckBox fx:id="keyStoreUnsafeExtractCheck" text="Unsafe extraction: show exportable private/secret keys in clear (laboratory only)" style="-fx-font-size: 10px; -fx-text-fill: #b54708;" wrapText="true"/>
                    <HBox spacing="5">
                        <TextField fx:id="keyStorePathField" promptText="PKCS#12, JKS or JCEKS file path" HBox.hgrow="ALWAYS" style="-fx-font-size: 11px;"/>
                        <Button text="Browse…" onAction="#handleChooseKeyStore" styleClass="secondary-button"/>
                    </HBox>
                    <HBox spacing="5">
                        <TextField fx:id="keyStoreProfileNameField" promptText="Profile name (path/type only; no password)" HBox.hgrow="ALWAYS"/>
                        <Button text="Save Profile" onAction="#handleSaveKeyStoreProfile" styleClass="secondary-button"/>
                    </HBox>
                    <Button text="Inspect KeyStore" onAction="#handleInspectKeyStore" styleClass="action-button" maxWidth="160" style="-fx-font-size: 11px;"/>
                    <TextArea fx:id="keyStoreReportArea" prefHeight="190" editable="false" wrapText="true"
                              style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 10px;"/>
                </VBox>
            </TitledPane>

            <!-- PKCS#11 TOKEN (laboratory integration) -->
            <TitledPane text="🔐 PKCS#11 Token">
                <VBox spacing="5" style="-fx-padding: 6;">
                    <Label text="Connect a real laboratory token through the JVM SunPKCS11 provider. The PIN is used only for this session and is never saved." wrapText="true" style="-fx-font-size: 10px; -fx-text-fill: #666;"/>
                    <HBox spacing="6">
                        <TextField fx:id="pkcs11NameField" promptText="Token profile name" prefWidth="180"/>
                        <TextField fx:id="pkcs11SlotField" promptText="Slot index" prefWidth="90"/>
                        <PasswordField fx:id="pkcs11PinField" promptText="User PIN (not stored)" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox spacing="5">
                        <TextField fx:id="pkcs11LibraryField" promptText="Native PKCS#11 library (.dylib, .so or .dll)" HBox.hgrow="ALWAYS" style="-fx-font-size: 11px;"/>
                        <Button text="Browse…" onAction="#handleChoosePkcs11Library" styleClass="secondary-button"/>
                    </HBox>
                    <FlowPane prefWrapLength="900" styleClass="responsive-action-bar">
                        <ComboBox fx:id="pkcs11ProfileCombo" promptText="Saved Profiles" prefWidth="200"/>
                        <Button text="Save Profile" onAction="#handleSavePkcs11Profile" styleClass="secondary-button"/>
                        <Button text="Delete" onAction="#handleDeletePkcs11Profile" styleClass="btn-danger"/>
                    </FlowPane>
                    <HBox spacing="6">
                        <Button text="Connect &amp; Inspect" onAction="#handleConnectPkcs11" styleClass="action-button"/>
                        <Button text="Disconnect" onAction="#handleDisconnectPkcs11" styleClass="secondary-button"/>
                    </HBox>
                    <TextArea fx:id="pkcs11ReportArea" prefHeight="190" editable="false" wrapText="true"
                              promptText="Token provider and public object metadata will appear here; keys are never exported."
                              style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 10px;"/>
                    <Separator/>
                    <Label text="Token signature test (hex data)" style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
                    <Label text="Uses the selected private-key object inside the token. It does not read or export the private key." wrapText="true" style="-fx-font-size: 10px; -fx-text-fill: #666;"/>
                    <HBox spacing="6">
                        <ComboBox fx:id="pkcs11SigningKeyCombo" promptText="Private key alias" HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="pkcs11SignatureAlgorithmCombo" prefWidth="175"/>
                    </HBox>
                    <TextArea fx:id="pkcs11DataArea" prefHeight="55" promptText="Data to sign (hexadecimal)" wrapText="true" style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 10px;"/>
                    <HBox spacing="6">
                        <Button text="Sign Data" onAction="#handlePkcs11Sign" styleClass="action-button"/>
                        <Button text="Verify Signature" onAction="#handlePkcs11Verify" styleClass="secondary-button"/>
                    </HBox>
                    <TextArea fx:id="pkcs11SignatureArea" prefHeight="55" promptText="Signature (hexadecimal)" wrapText="true" style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 10px;"/>
                    <Separator/>
                    <Label text="Public certificate chain" style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
                    <FlowPane prefWrapLength="900" styleClass="responsive-action-bar">
                        <ComboBox fx:id="pkcs11CertificateAliasCombo" promptText="Certificate alias" HBox.hgrow="ALWAYS"/>
                        <Button text="Show PEM Chain" onAction="#handleShowPkcs11Certificate" styleClass="secondary-button"/>
                        <Button text="Update Chain" onAction="#handleUpdatePkcs11CertificateChain" styleClass="action-button-primary"/>
                    </FlowPane>
                    <TextArea fx:id="pkcs11CertificateArea" prefHeight="90" editable="true" promptText="Paste PEM chain here to update, or use Show PEM Chain to view." wrapText="true" style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 10px;"/>
                    <Separator/>
                    <Label text="JWT / JWS using token key" style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
                    <Label text="Creates a compact JWS with the same selected token private-key alias. Claims must be a JSON object." wrapText="true" style="-fx-font-size: 10px; -fx-text-fill: #666;"/>
                    <ComboBox fx:id="pkcs11JwtAlgorithmCombo" prefWidth="150"/>
                    <TextArea fx:id="pkcs11JwtPayloadArea" prefHeight="65" promptText='JWT claims JSON, e.g. {&quot;sub&quot;:&quot;lab&quot;}' wrapText="true" style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 10px;"/>
                    <Button text="Create Signed JWT" onAction="#handleGeneratePkcs11Jwt" styleClass="action-button"/>
                    <TextArea fx:id="pkcs11JwtOutputArea" prefHeight="75" editable="false" promptText="Compact JWS will appear here" wrapText="true" style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 10px;"/>
                    <Separator/>
                    <Label text="CMS / PKCS#7 SignedData" style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
                    <Label text="Creates CMS with the selected token private-key and its public X.509 certificate. Output is Base64." wrapText="true" style="-fx-font-size: 10px; -fx-text-fill: #666;"/>
                    <TextArea fx:id="pkcs11CmsDataArea" prefHeight="55" promptText="Content to sign (hexadecimal)" wrapText="true" style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 10px;"/>
                    <CheckBox fx:id="pkcs11CmsDetachedCheck" text="Detached CMS (do not embed content)" style="-fx-font-size: 10px;"/>
                    <Button text="Create CMS SignedData" onAction="#handleGeneratePkcs11Cms" styleClass="action-button"/>
                    <TextArea fx:id="pkcs11CmsOutputArea" prefHeight="75" editable="false" promptText="Base64 CMS/PKCS#7 will appear here" wrapText="true" style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 10px;"/>
                </VBox>
            </TitledPane>

            <!-- KEY PAIR COMPARISON -->
            <TitledPane text="🔗 Compare Public / Private Key">
                <VBox spacing="5" style="-fx-padding: 6;">
                    <Label text="Checks the pair cryptographically with a temporary signing challenge; it does not compare PEM text." wrapText="true" style="-fx-font-size: 10px; -fx-text-fill: #666;"/>
                    <TextArea fx:id="keyComparePublicArea" prefHeight="90" wrapText="true" promptText="Public key PEM or X.509 certificate PEM"
                              style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 10px;"/>
                    <TextArea fx:id="keyComparePrivateArea" prefHeight="90" wrapText="true" promptText="Private key PEM"
                              style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 10px;"/>
                    <Button text="Compare Pair" onAction="#handleCompareKeyPair" styleClass="action-button" maxWidth="150" style="-fx-font-size: 11px;"/>
                    <TextArea fx:id="keyCompareResultArea" prefHeight="100" editable="false" wrapText="true"
                              style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 10px;"/>
                </VBox>
            </TitledPane>

            <!-- KEY SHARING -->
            <TitledPane text="🔀 Key Sharing (XOR Split/Combine)">
                <VBox spacing="6" style="-fx-padding: 8;">
                    <TabPane tabClosingPolicy="UNAVAILABLE">
                        <Tab text="Split Key">
                            <VBox spacing="6" style="-fx-padding: 8;">
                                <TextArea fx:id="keyToSplitField" prefHeight="35" wrapText="true"
                                          style="-fx-font-family: 'Courier New', monospace;"
                                          promptText="Enter key to split..."/>

                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="Parts:"/>
                                    <ComboBox fx:id="numComponentsCombo" prefWidth="80"/>
                                    <Button text="Split Key" onAction="#handleSplitKey"
                                            styleClass="action-button"/>
                                </HBox>
                            </VBox>
                        </Tab>

                        <Tab text="Combine Components">
                            <VBox spacing="6" style="-fx-padding: 8;">
                                <GridPane hgap="8" vgap="4">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="90" prefWidth="90"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                    </columnConstraints>

                                    <Label text="Component 1:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                    <TextField fx:id="component1Field" promptText="Required"
                                              style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 11px;"
                                              GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                    <Label text="Component 2:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                    <TextField fx:id="component2Field" promptText="Required"
                                              style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 11px;"
                                              GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                    <Label text="Component 3:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                    <TextField fx:id="component3Field" promptText="Optional"
                                              style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 11px;"
                                              GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                    <Label text="Component 4:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                    <TextField fx:id="component4Field" promptText="Optional"
                                              style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 11px;"
                                              GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                                    <Label text="Component 5:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                                    <TextField fx:id="component5Field" promptText="Optional"
                                              style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 11px;"
                                              GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                                </GridPane>

                                <Button text="Combine Components" onAction="#handleCombineComponents"
                                        styleClass="action-button" maxWidth="200"/>
                            </VBox>
                        </Tab>
                    </TabPane>

                    <TextArea fx:id="componentResultsArea" prefHeight="100" editable="false" wrapText="true"
                              style="-fx-font-family: 'Courier New', monospace;"
                              promptText="Results will appear here..."
                              managed="false" visible="false"/>
