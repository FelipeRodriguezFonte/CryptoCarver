                                </GridPane>
                                <CheckBox fx:id="rsaKexIncludeEnvelopeCheck" text="Wrap result as Crypto Envelope (adds algorithm/kid/kcv/timestamp header)" onAction="#handleRsaKexEnvelopeToggle" style="-fx-font-size: 11px;"/>
