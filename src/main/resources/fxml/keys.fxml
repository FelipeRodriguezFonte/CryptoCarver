            <!-- RSA KEY EXCHANGE -->
            <TitledPane text="🔁 RSA Key Exchange">
                <VBox spacing="6" style="-fx-padding: 8;">
                    <TabPane tabClosingPolicy="UNAVAILABLE">
                        <Tab text="Export (Wrap)">
                            <VBox spacing="6" style="-fx-padding: 8;">
                                <Label text="Recipient Public Key or Certificate (PEM):" style="-fx-font-size: 11px;"/>
