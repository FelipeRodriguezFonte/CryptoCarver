<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<TitledPane fx:id="compressedHexPane" text="↔️ Compressed Hex (2-row)"
             xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
             fx:controller="com.cryptocarver.ui.CompressedHexController" expanded="false">
    <content>
        <VBox styleClass="ux-inline-1684f00703" spacing="6">
            <Label styleClass="ux-inline-39414733db" text="Interleave or split the two hexadecimal rows shown by some host tools. Example: AFD12 + CA123 → ACFAD11223."
                   wrapText="true"/>
            <Label styleClass="ux-inline-ba9ea6419e" text="Input:"/>
            <TextArea styleClass="ux-inline-f94e00865e" fx:id="compressedHexInputArea" prefRowCount="3" wrapText="false"
                      promptText="Two rows:&#10;AFD12&#10;CA123&#10;&#10;or a normal hexadecimal value: ACFAD11223"/>
            <FlowPane prefWrapLength="900" styleClass="responsive-action-bar">
                <Button text="Two rows → Hex" onAction="#handleExpandCompressedHex" styleClass="action-button"/>
                <Button text="Hex → Two rows" onAction="#handleCompressHex" styleClass="secondary-button"/>
                <Button text="Clear" onAction="#handleClearCompressedHex" styleClass="secondary-button"/>
            </FlowPane>
            <Label styleClass="ux-inline-ba9ea6419e" text="Output:"/>
            <TextArea styleClass="ux-inline-f94e00865e" fx:id="compressedHexOutputArea" prefRowCount="3" editable="false" wrapText="false"/>
        </VBox>
    </content>
</TitledPane>
