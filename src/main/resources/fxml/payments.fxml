<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cryptocarver.ui.PaymentsController"
      managed="false" visible="false" spacing="14" styleClass="content-container-vbox,payments-module">
    <Accordion styleClass="module-accordion">
        <panes>
            <TitledPane text="💳 CVV Operations (CVV/CVV2/iCVV)" expanded="true">
                <VBox spacing="12" styleClass="module-pane-content">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Type:" styleClass="form-label"/>
                        <ComboBox fx:id="cvvTypeCombo" prefWidth="250" styleClass="form-field"/>
                    </HBox>
                    <Separator/>
                    <GridPane hgap="10" vgap="9" styleClass="form-grid">
                        <columnConstraints>
                            <ColumnConstraints minWidth="120" prefWidth="120"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="CVK A (Hex):" GridPane.rowIndex="0" styleClass="form-label"/>
                        <TextField fx:id="cvkAField" promptText="16 hex chars (8 bytes)" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="monospace-field,form-field" maxWidth="Infinity"/>
                        <Label text="CVK B (Hex):" GridPane.rowIndex="1" styleClass="form-label"/>
                        <TextField fx:id="cvkBField" promptText="16 hex chars (8 bytes)" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="monospace-field,form-field" maxWidth="Infinity"/>
                        <Label text="PAN:" GridPane.rowIndex="2" styleClass="form-label"/>
                        <TextField fx:id="panFieldCvv" promptText="Primary Account Number" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="form-field" maxWidth="Infinity"/>
                        <Label text="Expiry (YYMM):" GridPane.rowIndex="3" styleClass="form-label"/>
                        <TextField fx:id="expiryDateField" promptText="e.g. 2512" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="form-field" maxWidth="Infinity"/>
                        <Label text="Service Code:" GridPane.rowIndex="4" styleClass="form-label"/>
                        <TextField fx:id="serviceCodeField" promptText="e.g. 000" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="form-field" maxWidth="Infinity"/>
                        <Label text="ATC/Tracker:" GridPane.rowIndex="5" styleClass="form-label"/>
                        <TextField fx:id="atcField" promptText="e.g. 0001 (for dCVV)" GridPane.rowIndex="5" GridPane.columnIndex="1" styleClass="form-field" maxWidth="Infinity"/>
                    </GridPane>
                    <HBox spacing="8">
                        <Button text="Generate CVV" onAction="#handleGenerateCvv" styleClass="action-button,primary-action"/>
                        <Button text="Verify CVV" onAction="#handleVerifyCvv" styleClass="secondary-button"/>
                    </HBox>
                    <TextArea fx:id="cvvResultArea" prefHeight="100" editable="false" wrapText="true" promptText="Result will appear here..." styleClass="result-area,monospace-field"/>
                </VBox>
            </TitledPane>

            <TitledPane text="🔢 Clear PIN Blocks" expanded="true">
                <VBox spacing="12" styleClass="module-pane-content">
                    <GridPane hgap="10" vgap="9" styleClass="form-grid">
                        <columnConstraints>
                            <ColumnConstraints minWidth="120" prefWidth="120"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Encode PIN Block" styleClass="form-label" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2"/>
                        <Label text="PIN (4-12 digits):" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <TextField fx:id="pinField" promptText="Enter PIN" styleClass="form-field" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label text="PAN:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <TextField fx:id="panFieldEncode" promptText="13-19 digits" styleClass="form-field" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        <Label text="Format:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                        <ComboBox fx:id="pinBlockFormatCombo" styleClass="form-field" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                        <Button text="Encode PIN Block" onAction="#handleEncodePinBlock" styleClass="action-button,primary-action" maxWidth="180" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                        <Separator GridPane.columnIndex="0" GridPane.rowIndex="5" GridPane.columnSpan="2"/>

                        <Label text="Decode PIN Block" styleClass="form-label" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="6" GridPane.columnSpan="2"/>
                        <Label text="PIN Block (Hex):" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                        <TextField fx:id="pinBlockField" promptText="16 or 32 hex chars" styleClass="monospace-field,form-field" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="7"/>
                        <Label text="PAN:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
                        <TextField fx:id="panFieldDecode" promptText="13-19 digits" styleClass="form-field" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="8"/>
                        <Label text="Format:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="9"/>
                        <ComboBox fx:id="pinBlockFormatDecodeCombo" styleClass="form-field" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="9"/>
                        <Button text="Decode PIN Block" onAction="#handleDecodePinBlock" styleClass="action-button,primary-action" maxWidth="180" GridPane.columnIndex="1" GridPane.rowIndex="10"/>
                    </GridPane>
                    <TextArea fx:id="pinBlockResultArea" prefHeight="80" editable="false" wrapText="true" managed="false" visible="false" styleClass="result-area,monospace-field"/>
                </VBox>
            </TitledPane>

            <TitledPane text="🔐 Encrypted PIN Blocks (ISO)">
                <VBox spacing="12" styleClass="module-pane-content">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Format:" styleClass="form-label" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="encPinBlockFormatCombo" styleClass="form-field" prefWidth="250"/>
                    </HBox>
                    <Separator/>
                    <GridPane hgap="10" vgap="9" styleClass="form-grid">
                        <columnConstraints>
                            <ColumnConstraints minWidth="160" prefWidth="160"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Encode" styleClass="form-label" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2"/>
                        <Label text="PIN:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <TextField fx:id="encPinField" promptText="4-12 digits" styleClass="form-field" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label text="PAN:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <TextField fx:id="encPanFieldEncode" promptText="13-19 digits" styleClass="form-field" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        <Label text="Encryption Key (Hex):" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                        <TextField fx:id="encPinBlockKeyField" promptText="16/32/48 hex (TDES)" styleClass="monospace-field,form-field" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                        <Button text="Encode" onAction="#handleEncodeEncryptedPinBlock" styleClass="action-button,primary-action" maxWidth="150" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                        <Separator GridPane.columnIndex="0" GridPane.rowIndex="5" GridPane.columnSpan="2"/>

                        <Label text="Decode" styleClass="form-label" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="6" GridPane.columnSpan="2"/>
                        <Label text="Encrypted PIN Block (Hex):" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                        <TextField fx:id="encPinBlockFieldDecode" promptText="16 hex chars" styleClass="monospace-field,form-field" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="7"/>
                        <Label text="PAN:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
                        <TextField fx:id="encPanFieldDecode" promptText="13-19 digits" styleClass="form-field" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="8"/>
                        <Label text="Decryption Key (Hex):" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="9"/>
                        <TextField fx:id="encPinBlockKeyFieldDecode" promptText="16/32/48 hex (TDES)" styleClass="monospace-field,form-field" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="9"/>
                        <Button text="Decode" onAction="#handleDecodeEncryptedPinBlock" styleClass="action-button,primary-action" maxWidth="150" GridPane.columnIndex="1" GridPane.rowIndex="10"/>
                    </GridPane>
                    <TextArea fx:id="encResultArea" prefHeight="80" editable="false" wrapText="true" managed="false" visible="false" styleClass="result-area,monospace-field"/>
                </VBox>
            </TitledPane>

            <TitledPane text="🔑 PIN Generation (IBM 3624)">
                <VBox spacing="12" styleClass="module-pane-content">
                    <GridPane hgap="10" vgap="9" styleClass="form-grid">
                        <columnConstraints>
                            <ColumnConstraints minWidth="160" prefWidth="160"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Generate PIN from Offset" styleClass="form-label" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2"/>
                        <Label text="PVK (Hex):" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <TextField fx:id="ibm3624PvkField" promptText="16/32/48 hex (TDES)" styleClass="monospace-field,form-field" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label text="Conversion Table:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <TextField fx:id="ibm3624ConvTableField" promptText="e.g. 0123456789012345" styleClass="form-field" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        <Label text="Offset (4-16 digits):" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                        <TextField fx:id="ibm3624OffsetField" promptText="e.g. 1234" styleClass="form-field" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                        <Label text="PAN:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                        <TextField fx:id="ibm3624PanField" promptText="Up to 19 digits" styleClass="form-field" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                        <Label text="Validation Data Config" styleClass="form-label" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="5" GridPane.columnSpan="2"/>
                        <HBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="6" GridPane.columnSpan="2">
                            <Label text="Start Pos:" styleClass="form-label"/><TextField fx:id="ibm3624StartField" text="0" styleClass="form-field" prefWidth="50"/>
                            <Label text="Length:" styleClass="form-label"/><TextField fx:id="ibm3624LengthField" text="16" styleClass="form-field" prefWidth="50"/>
                            <Label text="Pad Char:" styleClass="form-label"/><TextField fx:id="ibm3624PadField" text="F" styleClass="form-field" prefWidth="50"/>
                        </HBox>

                        <Button text="Generate PIN" onAction="#handleGenerateIbm3624Pin" styleClass="action-button,primary-action" maxWidth="150" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

                        <Separator GridPane.columnIndex="0" GridPane.rowIndex="8" GridPane.columnSpan="2"/>

                        <Label text="Verify PIN" styleClass="form-label" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="9" GridPane.columnSpan="2"/>
                        <Label text="PIN to Verify:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="10"/>
                        <TextField fx:id="ibm3624PinVerifyField" promptText="4-12 digits" styleClass="form-field" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="10"/>
                        <Button text="Verify PIN" onAction="#handleVerifyIbm3624Pin" styleClass="action-button,primary-action" maxWidth="150" GridPane.columnIndex="1" GridPane.rowIndex="11"/>
                    </GridPane>
                    <TextArea fx:id="ibm3624ResultArea" prefHeight="100" editable="false" wrapText="true" managed="false" visible="false" styleClass="result-area,monospace-field"/>
                </VBox>
            </TitledPane>

            <TitledPane text="🔑 PIN Utilities (Offset &amp; PVV)">
                <VBox spacing="12" styleClass="module-pane-content">
                    <GridPane hgap="10" vgap="9" styleClass="form-grid">
                        <columnConstraints>
                            <ColumnConstraints minWidth="160" prefWidth="160"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Generate Offset (IBM 3624)" styleClass="form-label" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2"/>
                        <Label text="PVK (Hex):" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <TextField fx:id="genOffsetPvkField" promptText="16/32 hex chars" styleClass="monospace-field,form-field" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label text="Dec Table (16 digits):" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <TextField fx:id="genOffsetDecTableField" text="0123456789012345" styleClass="form-field" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        <Label text="PAN:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                        <TextField fx:id="genOffsetPanField" promptText="13-19 digits" styleClass="form-field" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                        <Label text="Desired PIN:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                        <TextField fx:id="genOffsetPinField" promptText="4-12 digits" styleClass="form-field" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                        <HBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="5" GridPane.columnSpan="2">
                            <Label text="Start Pos:" styleClass="form-label"/><TextField fx:id="genOffsetStartField" text="0" styleClass="form-field" prefWidth="50"/>
                            <Label text="Length:" styleClass="form-label"/><TextField fx:id="genOffsetLengthField" text="16" styleClass="form-field" prefWidth="50"/>
                            <Label text="Pad Char:" styleClass="form-label"/><TextField fx:id="genOffsetPadField" text="F" styleClass="form-field" prefWidth="50"/>
                        </HBox>
                        <Button text="Generate Offset" onAction="#handleGenerateOffsetUtility" styleClass="action-button,primary-action" maxWidth="150" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                        <TextArea fx:id="genOffsetResultArea" prefHeight="60" editable="false" wrapText="true" managed="false" visible="false" styleClass="result-area,monospace-field" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

                        <Separator GridPane.columnIndex="0" GridPane.rowIndex="8" GridPane.columnSpan="2"/>

                        <Label text="Generate PVV (VISA)" styleClass="form-label" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="9" GridPane.columnSpan="2"/>
                        <Label text="PVK (Hex):" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="10"/>
                        <TextField fx:id="genPvvPvkField" promptText="16/32 hex chars" styleClass="monospace-field,form-field" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="10"/>
                        <Label text="PAN:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="11"/>
                        <TextField fx:id="genPvvPanField" promptText="13-19 digits" styleClass="form-field" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="11"/>
                        <Label text="PIN:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="12"/>
                        <TextField fx:id="genPvvPinField" promptText="4 digits" styleClass="form-field" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="12"/>
                        <Label text="PVK Index:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="13"/>
                        <TextField fx:id="genPvvKeyIndexField" promptText="0-9 (Optional)" styleClass="form-field" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="13"/>
                        <Button text="Generate PVV" onAction="#handleGeneratePVVUtility" styleClass="action-button,primary-action" maxWidth="150" GridPane.columnIndex="1" GridPane.rowIndex="14"/>
                        <TextArea fx:id="genPvvResultArea" prefHeight="60" editable="false" wrapText="true" managed="false" visible="false" styleClass="result-area,monospace-field" GridPane.columnIndex="1" GridPane.rowIndex="15"/>

                        <Separator GridPane.columnIndex="0" GridPane.rowIndex="16" GridPane.columnSpan="2"/>

                        <Label text="Derive PIN from PVV (VISA)" styleClass="form-label" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="17" GridPane.columnSpan="2"/>
                        <Label text="PVK (Hex):" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="18"/>
                        <TextField fx:id="derivePvvPvkField" promptText="16/32 hex chars" styleClass="monospace-field,form-field" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="18"/>
                        <Label text="PAN:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="19"/>
                        <TextField fx:id="derivePvvPanField" promptText="13-19 digits" styleClass="form-field" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="19"/>
                        <Label text="Target PVV:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="20"/>
                        <TextField fx:id="derivePvvTargetPvvField" promptText="4 digits" styleClass="form-field" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="20"/>
                        <Label text="PVK Index:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="21"/>
                        <TextField fx:id="derivePvvKeyIndexField" promptText="0-9 (Optional)" styleClass="form-field" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="21"/>
                        <Button text="Find PIN" onAction="#handleDerivePinFromPvvUtility" styleClass="action-button,primary-action" maxWidth="150" GridPane.columnIndex="1" GridPane.rowIndex="22"/>
                        <TextArea fx:id="derivePvvResultArea" prefHeight="60" editable="false" wrapText="true" managed="false" visible="false" styleClass="result-area,monospace-field" GridPane.columnIndex="1" GridPane.rowIndex="23"/>
                    </GridPane>
                </VBox>
            </TitledPane>

            <TitledPane text="🔐 DUKPT KSN, TDES &amp; AES">
                <VBox spacing="12" styleClass="module-pane-content">
                    <ComboBox fx:id="dukptSchemeCombo" prefWidth="260" styleClass="form-field"/>
                    <GridPane hgap="10" vgap="9" styleClass="form-grid">
                        <columnConstraints>
                            <ColumnConstraints minWidth="120" prefWidth="120"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="BDK (hex):" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="dukptBdkField" promptText="Optional for KSN inspection" styleClass="monospace-field,form-field" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="KSN (hex):" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <TextField fx:id="dukptKsnField" promptText="TDES FFFF9876543210E00008 · AES 123456789012345600000005" styleClass="monospace-field,form-field" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    </GridPane>

                    <HBox fx:id="dukptTdesOptionsBox" spacing="8" alignment="CENTER_LEFT">
                        <Label text="TDES key purpose:" styleClass="form-label"/>
                        <ComboBox fx:id="dukptTdesUsageCombo" prefWidth="190" styleClass="form-field"/>
                    </HBox>
                    <HBox fx:id="dukptAesOptionsBox" spacing="8" alignment="CENTER_LEFT">
                        <Label text="AES key usage:" styleClass="form-label"/>
                        <ComboBox fx:id="dukptAesUsageCombo" prefWidth="205" styleClass="form-field"/>
                        <ComboBox fx:id="dukptAesKeyTypeCombo" prefWidth="100" styleClass="form-field"/>
                    </HBox>
                    <Button text="Inspect KSN / Derive Key" onAction="#handleInspectDukpt" styleClass="action-button,primary-action" maxWidth="200"/>

                    <VBox fx:id="dukptAesPinBox" spacing="12" styleClass="module-pane-content">
                        <Separator/>
                        <Label text="AES DUKPT PIN block (ISO 9564-4, 16 bytes; lab):" styleClass="form-label"/>
                        <TextField fx:id="dukptAesPinBlockField" promptText="04124389999AAAABAAAAAAAAAAAAAAAA" styleClass="monospace-field,form-field" maxWidth="Infinity"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <ComboBox fx:id="dukptAesPinOperationCombo" prefWidth="205" styleClass="form-field"/>
                            <Button text="Process AES PIN block" onAction="#handleAesDukptPinBlock" styleClass="action-button,primary-action"/>
                        </HBox>
                    </VBox>
                    <TextArea fx:id="dukptResultArea" prefHeight="230" editable="false" wrapText="true" styleClass="result-area,monospace-field"/>
                </VBox>
            </TitledPane>
        </panes>
    </Accordion>
</VBox>
