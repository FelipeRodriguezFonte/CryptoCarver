<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="certificatesContainer" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cryptocarver.ui.CertificatesController" spacing="14" styleClass="content-container-vbox,certificates-module">
    <Accordion styleClass="module-accordion">
        <panes>
            <!-- GENERATE CERTIFICATE -->
            <TitledPane text="📜 Generate Certificate" expanded="true">
                <VBox spacing="12" styleClass="module-pane-content">
                    <GridPane hgap="10" vgap="9" styleClass="form-grid">
                        <columnConstraints>
                            <ColumnConstraints minWidth="90" prefWidth="90"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="CN:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="certCNField" promptText="localhost" maxWidth="Infinity"
                                  GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="form-field"/>

                        <Label text="Organization:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="certOrgField" promptText="Crypto Org" maxWidth="Infinity"
                                  GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="form-field"/>

                        <Label text="Org. Unit:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="certOUField" promptText="IT Security" maxWidth="Infinity"
                                  GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="form-field"/>

                        <Label text="Country:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="certCountryField" promptText="ES" prefWidth="60"
                                  GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="form-field"/>

                        <Label text="State:" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="certStateField" promptText="State/Province" maxWidth="Infinity"
                                  GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="form-field"/>

                        <Label text="Locality:" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="certLocalityField" promptText="City" maxWidth="Infinity"
                                  GridPane.rowIndex="5" GridPane.columnIndex="1" styleClass="form-field"/>

                        <Label text="Email:" GridPane.rowIndex="6" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="certEmailField" promptText="Optional" maxWidth="Infinity"
                                  GridPane.rowIndex="6" GridPane.columnIndex="1" styleClass="form-field"/>

                        <Label text="Validity (days):" GridPane.rowIndex="7" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="certValidityField" text="365" prefWidth="80"
                                  GridPane.rowIndex="7" GridPane.columnIndex="1" styleClass="form-field"/>

                        <Label text="Key Type:" GridPane.rowIndex="8" GridPane.columnIndex="0" styleClass="form-label"/>
                        <ComboBox fx:id="certKeyTypeCombo" prefWidth="150"
                                  GridPane.rowIndex="8" GridPane.columnIndex="1" styleClass="form-field"/>

                        <Label text="Sign Algorithm:" GridPane.rowIndex="9" GridPane.columnIndex="0" styleClass="form-label"/>
                        <ComboBox fx:id="certSignAlgoCombo" prefWidth="200"
                                  GridPane.rowIndex="9" GridPane.columnIndex="1" styleClass="form-field"/>

                        <Label text="SAN DNS:" GridPane.rowIndex="10" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="certSanDnsField" promptText="Comma-separated (e.g. api.example.test)" maxWidth="Infinity" GridPane.rowIndex="10" GridPane.columnIndex="1" styleClass="form-field"/>

                        <Label text="SAN IP:" GridPane.rowIndex="11" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="certSanIpField" promptText="Comma-separated (e.g. 127.0.0.1)" maxWidth="Infinity" GridPane.rowIndex="11" GridPane.columnIndex="1" styleClass="form-field"/>
                    </GridPane>

                    <HBox spacing="8">
                        <Button text="Generate Certificate" onAction="#handleGenerateCertificate" styleClass="action-button,primary-action"/>
                        <Button text="Generate CSR" onAction="#handleGenerateCSR" styleClass="secondary-button"/>
                    </HBox>
                    <CheckBox fx:id="certRootCaCheck" text="Generate as laboratory Root CA (CA:TRUE, keyCertSign)" styleClass="helper-text"/>

                    <TextArea fx:id="certOutputArea" prefHeight="200" editable="false" wrapText="true"
                              styleClass="result-area,monospace-field"
                              promptText="Certificate will appear here..."
                              managed="false" visible="false"/>
                </VBox>
            </TitledPane>

            <!-- ISSUE FROM CSR -->
            <TitledPane text="🏛 Issue Certificate from CSR (Laboratory CA)">
                <VBox spacing="12" styleClass="module-pane-content">
                    <Label text="Validates the CSR signature before issuing. Use only a laboratory CA key." wrapText="true" styleClass="helper-text"/>
                    <TextArea fx:id="certIssueCsrArea" prefHeight="80" wrapText="true" promptText="PKCS#10 CSR PEM"
                              styleClass="monospace-field"/>
                    <TextArea fx:id="certIssueCaCertArea" prefHeight="80" wrapText="true" promptText="Issuer Root CA certificate PEM"
                              styleClass="monospace-field"/>
                    <TextArea fx:id="certIssueCaKeyArea" prefHeight="80" wrapText="true" promptText="Issuer Root CA private key PEM"
                              styleClass="monospace-field"/>
                    <HBox spacing="8">
                        <TextField fx:id="certIssueValidityField" text="90" prefWidth="80" promptText="Days" styleClass="form-field"/>
                        <TextField fx:id="certIssueSignatureField" text="Automatic" promptText="Automatic or issuer signature algorithm" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="form-field"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Profile:" styleClass="form-label"/>
                        <ComboBox fx:id="certIssueProfileCombo" promptText="Select Profile" styleClass="form-field"/>
                        <Label text="Path length (CA):" styleClass="form-label"/>
                        <TextField fx:id="certIssuePathLengthField" text="0" prefWidth="45" styleClass="form-field"/>
                    </HBox>
                    <Button text="Issue Laboratory Certificate" onAction="#handleIssueCertificateFromCsr" styleClass="action-button,primary-action" maxWidth="250"/>
                    <TextArea fx:id="certIssueResultArea" prefHeight="180" editable="false" wrapText="true"
                              styleClass="result-area,monospace-field"/>
                </VBox>
            </TitledPane>

            <!-- PARSE CERTIFICATE -->
            <TitledPane text="🔍 Parse Certificate">
                <VBox spacing="12" styleClass="module-pane-content">
                    <HBox spacing="8" alignment="CENTER_LEFT" styleClass="form-group-box" style="-fx-margin: 0 0 10 0;">
                        <Label text="Apply Template:" styleClass="form-label"/>
                        <ComboBox fx:id="certTemplateCombo" promptText="Select a template..." HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="form-field"/>
                        <Button text="Apply" onAction="#handleApplyCertTemplate" styleClass="action-button-primary" style="-fx-font-size: 11px; -fx-padding: 4 10;"/>
                        <MenuButton text="Manage Template" styleClass="secondary-button" style="-fx-font-size: 11px; -fx-padding: 4 10;">
                            <items>
                                <MenuItem text="Save Current as Personal Template..." onAction="#handleSaveCertTemplate"/>
                                <MenuItem text="Export Selected Template..." onAction="#handleExportCertTemplate"/>
                                <MenuItem text="Import Template File..." onAction="#handleImportCertTemplate"/>
                                <MenuItem text="Delete Selected Personal Template" onAction="#handleDeleteCertTemplate"/>
                            </items>
                        </MenuButton>
                        <Button text="Reset Defaults" onAction="#handleResetCertDefaults" styleClass="secondary-button" style="-fx-font-size: 11px; -fx-padding: 4 10;"/>
                    </HBox>

                    <Label text="Paste PEM Certificate:" styleClass="form-label"/>
                    <TextArea fx:id="certInputArea" prefHeight="100" wrapText="true"
                              styleClass="monospace-field"
                              promptText="Paste certificate in PEM format..."/>

                    <Button text="Parse Certificate" onAction="#handleParseCertificate"
                            styleClass="action-button,primary-action" maxWidth="180"/>

                    <TextArea fx:id="certParseResultArea" prefHeight="200" editable="false" wrapText="true"
                              styleClass="result-area,monospace-field"
                              promptText="Parse results will appear here..."
                              managed="false" visible="false"/>
                </VBox>
            </TitledPane>

            <!-- COMPARE CERTIFICATES -->
            <TitledPane text="⚖ Compare Certificates">
                <VBox spacing="12" styleClass="module-pane-content">
                    <TextArea fx:id="certCompareLeftArea" prefHeight="85" wrapText="true" promptText="Left X.509 certificate PEM"
                              styleClass="monospace-field"/>
                    <TextArea fx:id="certCompareRightArea" prefHeight="85" wrapText="true" promptText="Right X.509 certificate PEM"
                              styleClass="monospace-field"/>
                    <Button text="Compare Certificates" onAction="#handleCompareCertificates" styleClass="action-button,primary-action" maxWidth="200"/>
                    <TextArea fx:id="certCompareResultArea" prefHeight="180" editable="false" wrapText="true"
                              styleClass="result-area,monospace-field"/>
                </VBox>
            </TitledPane>

            <!-- VALIDATE CERTIFICATE -->
            <TitledPane text="🛡 Validate Certificate">
                <content>
                    <VBox spacing="12" styleClass="module-pane-content">
                        <Label text="Certificate (PEM)" styleClass="form-label"/>
                        <TextArea fx:id="valCertInput" promptText="Paste X.509 Certificate..." prefRowCount="5" wrapText="true" styleClass="monospace-field"/>

                        <Label text="Issuer Certificate (Optional)" styleClass="form-label"/>
                        <TextArea fx:id="valIssuerInput" promptText="Paste Issuer Certificate (for signature verification)..." prefRowCount="5" wrapText="true" styleClass="monospace-field"/>

                        <Button text="Validate Certificate" onAction="#handleValidateCertificate" styleClass="action-button,primary-action" maxWidth="200"/>

                        <Label text="Validation Report" styleClass="form-label"/>
                        <TextArea fx:id="valResultArea" editable="false" prefRowCount="5" wrapText="true" styleClass="result-area,monospace-field"/>
                    </VBox>
                </content>
            </TitledPane>

            <!-- VALIDATE CHAIN -->
            <TitledPane text="🔗 Validate Chain">
                <VBox spacing="12" styleClass="module-pane-content">
                    <Label text="Paste Certificate Chain (PEM sequence - End Entity first):" styleClass="form-label"/>
                    <TextArea fx:id="chainInputArea" prefHeight="100" wrapText="true"
                              styleClass="monospace-field"
                              promptText="-----BEGIN CERTIFICATE-----..."/>
                    <Label text="Optional CRLs (PEM sequence):" styleClass="form-label"/>
                    <TextArea fx:id="chainCrlInputArea" prefHeight="70" wrapText="true"
                              styleClass="monospace-field"
                              promptText="-----BEGIN X509 CRL-----..."/>

                    <Button text="Validate Chain" onAction="#handleValidateCertificateChain"
                            styleClass="action-button,primary-action" maxWidth="180"/>

                    <TextArea fx:id="chainResultArea" prefHeight="150" editable="false" wrapText="true"
                              styleClass="result-area,monospace-field"
                              promptText="Validation results will appear here..."
                              managed="false" visible="false"/>
                </VBox>
            </TitledPane>

            <!-- CRL MANAGEMENT -->
            <TitledPane text="🚫 CRL Management">
                <VBox spacing="12" styleClass="module-pane-content">
                    <Label text="Generate or update an offline CRL." styleClass="helper-text"/>
                    <TextArea fx:id="crlIssuerCertArea" prefHeight="70" wrapText="true" promptText="Issuer Root CA certificate PEM" styleClass="monospace-field"/>
                    <TextArea fx:id="crlIssuerKeyArea" prefHeight="70" wrapText="true" promptText="Issuer Root CA private key PEM" styleClass="monospace-field"/>
                    <TextArea fx:id="crlExistingCrlArea" prefHeight="70" wrapText="true" promptText="Existing CRL PEM (optional)" styleClass="monospace-field"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <TextField fx:id="crlRevokeSerialField" promptText="Serial Number to Revoke (Hex)" styleClass="form-field" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <ComboBox fx:id="crlRevokeReasonCombo" promptText="Reason" styleClass="form-field"/>
                    </HBox>
                    <HBox spacing="8">
                        <Button text="Generate Empty CRL" onAction="#handleGenerateCrl" styleClass="secondary-button"/>
                        <Button text="Revoke &amp; Update CRL" onAction="#handleRevokeCrl" styleClass="action-button,primary-action"/>
                    </HBox>
                    <TextArea fx:id="crlResultArea" prefHeight="150" editable="false" wrapText="true" styleClass="result-area,monospace-field"/>
                </VBox>
            </TitledPane>

            <!-- PADES -->
            <TitledPane text="📄 PAdES PDF Signatures">
                <content>
                    <fx:include fx:id="padesContainer" source="pades.fxml"/>
                </content>
            </TitledPane>

            <!-- ASICS -->
            <TitledPane text="📦 ASiC-S Containers">
                <content>
                    <fx:include fx:id="asicContainer" source="asic.fxml"/>
                </content>
            </TitledPane>

            <!-- CMS OPERATIONS -->
            <TitledPane text="📦 CMS Operations">
                <VBox spacing="12" styleClass="module-pane-content">
                    <Label text="PKCS#7 Cryptographic Message Syntax operations" styleClass="helper-text"/>

                    <Label text="Input Data / Content:" styleClass="form-label"/>
                    <TextArea fx:id="cmsInputArea" promptText="Enter raw data to Sign/Encrypt, or PKCS#7 PEM to Verify/Decrypt..." prefHeight="80" styleClass="monospace-field"/>

                    <TabPane tabClosingPolicy="UNAVAILABLE">
                        <tabs>
                            <Tab text="Signature (Sign/Verify)">
                                <content>
                                    <VBox spacing="12" styleClass="module-pane-content">
                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                            <Label text="Signing Source: " styleClass="form-label"/>
                                            <fx:define>
                                                <ToggleGroup fx:id="cmsSignSourceToggleGroup"/>
                                            </fx:define>
                                            <RadioButton fx:id="cmsSignSourceLocalRadio" text="Local PEM" toggleGroup="$cmsSignSourceToggleGroup" selected="true" onAction="#handleCMSourceChanged"/>
                                            <RadioButton fx:id="cmsSignSourcePkcs11Radio" text="PKCS#11 Token" toggleGroup="$cmsSignSourceToggleGroup" onAction="#handleCMSourceChanged"/>
                                        </HBox>

                                        <GridPane fx:id="cmsSignLocalGrid" hgap="10" vgap="10" styleClass="form-grid">
                                            <Label text="Signer Certificate (PEM):" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="form-label"/>
                                            <TextArea fx:id="cmsSignCertArea" promptText="-----BEGIN CERTIFICATE-----..." prefHeight="80" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.hgrow="ALWAYS" maxWidth="Infinity" styleClass="monospace-field"/>

                                            <Label text="Signer Private Key (PEM):" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="form-label"/>
                                            <TextArea fx:id="cmsSignKeyArea" promptText="-----BEGIN PRIVATE KEY-----..." prefHeight="80" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.hgrow="ALWAYS" maxWidth="Infinity" styleClass="monospace-field"/>
                                            <columnConstraints>
                                                <ColumnConstraints percentWidth="50"/>
                                                <ColumnConstraints percentWidth="50"/>
                                            </columnConstraints>
                                        </GridPane>

                                        <HBox fx:id="cmsSignPkcs11Box" spacing="10" alignment="CENTER_LEFT" managed="false" visible="false">
                                            <Label text="Key Alias:" styleClass="form-label"/>
                                            <ComboBox fx:id="cmsSignKeyAliasCombo" prefWidth="250" styleClass="form-field"/>
                                            <Button text="Load Token Keys" onAction="#handleLoadCMSKeys" styleClass="secondary-button"/>
                                        </HBox>

                                        <Label text="Detached Data (for verification only):" styleClass="form-label"/>
                                        <TextArea fx:id="cmsVerifyDataArea" promptText="Enter original raw data here if verifying a detached signature..." prefHeight="50" styleClass="monospace-field"/>

                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                             <CheckBox fx:id="cmsDetachedCheck" text="Detached Signature (Sign)"/>
                                             <CheckBox fx:id="cmsCadesBesCheck" text="CAdES-BES">
                                                 <tooltip><Tooltip text="Adds the ETSI CAdES-BES signingCertificateV2 signed attribute. This is not a timestamped or long-term profile."/></tooltip>
                                             </CheckBox>
                                             <CheckBox fx:id="cmsCadesTCheck" text="CAdES-T (RFC 3161)" onAction="#handleCadesTimestampOptionChanged">
                                                 <tooltip><Tooltip text="Requests a RFC 3161 timestamp over the CAdES signature. Requires a reachable TSA URL."/></tooltip>
                                             </CheckBox>
                                             <Region HBox.hgrow="ALWAYS"/>
                                             <Button text="Sign" onAction="#handleCMSSign" styleClass="action-button,primary-action"/>
                                             <Button text="Add LT Evidence..." onAction="#handleUpgradeCadesLt" styleClass="secondary-button">
                                                 <tooltip><Tooltip text="Embed locally selected CRL files into an existing CAdES-T signature. No CRL is downloaded automatically."/></tooltip>
                                             </Button>
                                             <Button text="Verify" onAction="#handleCMSVerify" styleClass="secondary-button"/>
                                        </HBox>
                                        <HBox fx:id="cmsCadesTsaBox" spacing="8" alignment="CENTER_LEFT" visible="false" managed="false">
                                            <Label text="CAdES-T TSA URL:" styleClass="form-label"/>
                                            <TextField fx:id="cmsCadesTsaUrlField" promptText="https://your-tsa.example/" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="form-field"/>
                                        </HBox>
                                    </VBox>
                                </content>
                            </Tab>
                            <Tab text="Encryption (EnvelopedData)">
                                <content>
                                    <VBox spacing="12" styleClass="module-pane-content">
                                        <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 0 0 5 0;">
                                            <Label text="Source:" styleClass="form-label"/>
                                            <fx:define>
                                                <ToggleGroup fx:id="cmsEncryptSourceToggleGroup"/>
                                            </fx:define>
                                            <RadioButton fx:id="cmsEncryptSourceLocalRadio" text="Local PEM (Cert/Key)" toggleGroup="$cmsEncryptSourceToggleGroup" selected="true" onAction="#handleCMSEncryptSourceChanged"/>
                                            <RadioButton fx:id="cmsEncryptSourcePkcs11Radio" text="PKCS#11 Token" toggleGroup="$cmsEncryptSourceToggleGroup" onAction="#handleCMSEncryptSourceChanged"/>
                                        </HBox>

                                        <GridPane fx:id="cmsEncryptLocalGrid" hgap="10" vgap="10" styleClass="form-grid">
                                            <Label text="Recipient Certificate (for Encrypt):" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="form-label"/>
                                            <TextArea fx:id="cmsEncryptCertArea" promptText="-----BEGIN CERTIFICATE-----..." prefHeight="80" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.hgrow="ALWAYS" maxWidth="Infinity" styleClass="monospace-field"/>

                                            <Label text="Recipient Private Key (for Decrypt):" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="form-label"/>
                                            <TextArea fx:id="cmsDecryptKeyArea" promptText="-----BEGIN PRIVATE KEY-----..." prefHeight="80" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.hgrow="ALWAYS" maxWidth="Infinity" styleClass="monospace-field"/>
                                            <columnConstraints>
                                                <ColumnConstraints percentWidth="50"/>
                                                <ColumnConstraints percentWidth="50"/>
                                            </columnConstraints>
                                        </GridPane>

                                        <HBox fx:id="cmsEncryptPkcs11Box" spacing="10" alignment="CENTER_LEFT" visible="false" managed="false">
                                            <Label text="Token Key Alias:" styleClass="form-label"/>
                                            <ComboBox fx:id="cmsEncryptKeyAliasCombo" prefWidth="250" styleClass="form-field"/>
                                            <Button text="Load Token Keys" onAction="#handleLoadCMSEncryptKeys" styleClass="secondary-button"/>
                                        </HBox>

                                        <HBox spacing="10" alignment="CENTER_RIGHT">
                                             <Button text="Encrypt" onAction="#handleCMSEncrypt" styleClass="action-button,primary-action"/>
                                             <Button text="Decrypt" onAction="#handleCMSDecrypt" styleClass="secondary-button"/>
                                        </HBox>
                                    </VBox>
                                </content>
                            </Tab>
                        </tabs>
                    </TabPane>

                    <Label text="Output / Result:" styleClass="form-label"/>
                    <TextArea fx:id="cmsOutputArea" editable="false" prefHeight="100" styleClass="result-area,monospace-field"/>
                </VBox>
            </TitledPane>

            <!-- CMS INSPECTOR -->
            <fx:include fx:id="cmsInspector" source="cms_inspector.fxml" />

            <!-- ASN.1 DECODER -->
            <fx:include fx:id="asn1" source="asn1.fxml" />
        </panes>
    </Accordion>
</VBox>
