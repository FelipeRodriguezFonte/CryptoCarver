<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox styleClass="ux-inline-31b3bfce5a" spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cryptocarver.ui.KeyCertificateWorkbenchController">

    <Label styleClass="ux-inline-4524890664" text="Input (Paste PEM/JWK/Hex or load file)"/>

    <HBox spacing="10">
        <Button text="Load from File..." onAction="#handleLoadFile" styleClass="secondary-button ux-inline-ba9ea6419e"/>
        <Button text="Load from Clipboard Shelf" onAction="#handleLoadFromShelf" styleClass="secondary-button ux-inline-ba9ea6419e"/>
        <ComboBox styleClass="ux-inline-ba9ea6419e" fx:id="storeTypeCombo"/>
        <PasswordField styleClass="ux-inline-ba9ea6419e" fx:id="workbenchPasswordField" promptText="Password (optional)"/>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Detect &amp; Parse" onAction="#handleParse" styleClass="action-button ux-inline-ba9ea6419e" />
    </HBox>

    <TextArea styleClass="ux-inline-ea21460dc9" fx:id="workbenchInputArea" prefHeight="120" wrapText="true"
              promptText="-----BEGIN CERTIFICATE-----... or {...} or Base64/Hex DER"/>

    <Label styleClass="ux-inline-4524890664" text="Detection &amp; Validation Results"/>

    <GridPane styleClass="ux-inline-c8be9b1739" fx:id="singleItemGrid" hgap="10" vgap="5">
        <columnConstraints>
            <ColumnConstraints minWidth="100" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>

        <Label styleClass="ux-inline-f875af32c4" text="Format Detected:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <Label styleClass="ux-inline-0ed0fa4650" fx:id="lblFormat" text="Unknown" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label styleClass="ux-inline-f875af32c4" text="Algorithm:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <Label styleClass="ux-inline-ba9ea6419e" fx:id="lblAlgorithm" text="N/A" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label styleClass="ux-inline-f875af32c4" text="Contains Private Key:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <Label styleClass="ux-inline-ba9ea6419e" fx:id="lblHasPrivate" text="No" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label styleClass="ux-inline-f875af32c4" text="Subject / Info:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <Label styleClass="ux-inline-ba9ea6419e" fx:id="lblSubject" text="N/A" GridPane.columnIndex="1" GridPane.rowIndex="3" wrapText="true"/>

        <Label styleClass="ux-inline-f875af32c4" text="Key Size:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <Label styleClass="ux-inline-ba9ea6419e" fx:id="lblKeySize" text="N/A" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

        <Label styleClass="ux-inline-f875af32c4" text="SHA-256 Fingerprint:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <Label styleClass="ux-inline-ba9ea6419e" fx:id="lblFingerprint" text="N/A" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

        <Label styleClass="ux-inline-f875af32c4" text="Validity (Cert):" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
        <Label styleClass="ux-inline-ba9ea6419e" fx:id="lblValidity" text="N/A" GridPane.columnIndex="1" GridPane.rowIndex="6" wrapText="true"/>
    </GridPane>

    <TableView styleClass="ux-inline-ba9ea6419e" fx:id="keystoreTable" prefHeight="150">
        <columns>
            <TableColumn fx:id="colAlias" text="Alias" prefWidth="120" />
            <TableColumn fx:id="colType" text="Type" prefWidth="90" />
            <TableColumn fx:id="colAlgorithm" text="Algorithm" prefWidth="80" />
            <TableColumn fx:id="colSubject" text="Subject / Info" prefWidth="250" />
            <TableColumn fx:id="colExpiration" text="Expiration" prefWidth="150" />
        </columns>
    </TableView>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label styleClass="ux-inline-ba9ea6419e" text="Convert to:" />
        <ComboBox styleClass="ux-inline-ba9ea6419e" fx:id="convertToCombo" prefWidth="180"/>
        <Button text="Convert" onAction="#handleConvert" styleClass="action-button ux-inline-ba9ea6419e" />
        <Region HBox.hgrow="ALWAYS" />
        <TextField styleClass="ux-inline-ba9ea6419e" fx:id="validationSecondaryInput" promptText="Secondary input for validation..." HBox.hgrow="ALWAYS"/>
        <Button text="Validate Pair/Chain" onAction="#handleValidate" styleClass="secondary-button ux-inline-ba9ea6419e" />
    </HBox>

    <Label styleClass="ux-inline-4524890664" text="Output"/>

    <TextArea styleClass="ux-inline-ea21460dc9" fx:id="workbenchOutputArea" prefHeight="150" wrapText="true" editable="false"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Send to Clipboard Shelf" onAction="#handleSendToShelf" styleClass="secondary-button ux-inline-ba9ea6419e" />
        <Button text="Copy to Clipboard" onAction="#handleCopyOutput" styleClass="secondary-button ux-inline-ba9ea6419e" />
    </HBox>

</VBox>
