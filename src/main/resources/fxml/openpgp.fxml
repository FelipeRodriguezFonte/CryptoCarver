<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cryptocarver.ui.OpenPgpController" spacing="10" styleClass="content-container-vbox">
    <Accordion styleClass="module-accordion">
        <panes>
            <TitledPane text="OpenPGP / GPG Laboratory" expanded="true">
                <VBox spacing="12" styleClass="module-pane-content">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="Check GnuPG…" onAction="#handleProbeGnuPg" styleClass="secondary-button"/>
                        <Button text="Run GnuPG Interop…" onAction="#handleRunGnuPgInterop" styleClass="secondary-button"/>
                        <Label fx:id="openPgpGnuPgStatusLabel" text="Optional external GnuPG not checked" styleClass="helper-text"/>
                    </HBox>

                    <Separator/>

                    <Label text="Key Generation" styleClass="form-label" style="-fx-font-weight: bold;"/>
                    <HBox spacing="10">
                        <TextField fx:id="openPgpUserIdField" promptText="User ID, e.g. Alice &lt;alice@example.test&gt;" HBox.hgrow="ALWAYS" styleClass="form-field"/>
                        <PasswordField fx:id="openPgpPassphraseField" promptText="Key passphrase" prefWidth="180" styleClass="form-field"/>
                        <Button text="Generate RSA Key Pair" onAction="#handleGenerateKeyPair" styleClass="action-button"/>
                    </HBox>

                    <GridPane hgap="15" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>

                        <VBox spacing="8" GridPane.columnIndex="0">
                            <Label text="Public key (ASCII armor)" styleClass="form-label"/>
                            <HBox spacing="8">
                                <Button text="Load…" onAction="#handleLoadPublicKey" styleClass="secondary-button"/>
                                <Button text="Save…" onAction="#handleSavePublicKey" styleClass="secondary-button"/>
                                <Button text="Inspect" onAction="#handleInspectPublicKey" styleClass="secondary-button"/>
                            </HBox>
                            <TextArea fx:id="openPgpPublicKeyArea" prefRowCount="4" wrapText="true" styleClass="monospace-field"/>
                        </VBox>

                        <VBox spacing="8" GridPane.columnIndex="1">
                            <Label text="Secret key (laboratory only)" styleClass="form-label"/>
                            <HBox spacing="8">
                                <Button text="Load…" onAction="#handleLoadSecretKey" styleClass="secondary-button"/>
                                <Button text="Save…" onAction="#handleSaveSecretKey" styleClass="secondary-button"/>
                                <Button text="Inspect" onAction="#handleInspectSecretKey" styleClass="secondary-button"/>
                                <Button text="Clear" onAction="#handleClearSecretMaterial" styleClass="danger-button"/>
                            </HBox>
                            <TextArea fx:id="openPgpSecretKeyArea" prefRowCount="4" wrapText="true" styleClass="monospace-field"/>
                        </VBox>
                    </GridPane>

                    <Separator/>

                    <Label text="Operations (Text / Armor)" styleClass="form-label" style="-fx-font-weight: bold;"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="Load input…" onAction="#handleLoadInput" styleClass="secondary-button"/>
                        <Label text="Text/ASCII armor only; 16 MiB limit" styleClass="helper-text"/>
                    </HBox>
                    <TextArea fx:id="openPgpInputArea" prefRowCount="4" wrapText="true" styleClass="monospace-field"/>

                    <HBox spacing="10">
                        <Button text="Encrypt" onAction="#handleEncrypt" styleClass="action-button,primary-action"/>
                        <Button text="Decrypt" onAction="#handleDecrypt" styleClass="action-button,primary-action"/>
                        <Button text="Sign Detached" onAction="#handleSignDetached" styleClass="action-button"/>
                        <Button text="Sign Attached" onAction="#handleSignAttached" styleClass="action-button"/>
                        <Button text="Clear-sign" onAction="#handleClearSign" styleClass="action-button"/>
                    </HBox>

                    <HBox spacing="10">
                        <Button text="Verify Detached" onAction="#handleVerifyDetached" styleClass="secondary-button"/>
                        <Button text="Verify Attached" onAction="#handleVerifyAttached" styleClass="secondary-button"/>
                        <Button text="Verify Clear-sign" onAction="#handleVerifyClearSigned" styleClass="secondary-button"/>
                        <Button text="Verify with GnuPG" onAction="#handleVerifyWithGnuPg" styleClass="secondary-button"/>
                        <Button text="Clear data" onAction="#handleClear" styleClass="secondary-button"/>
                    </HBox>

                    <Separator/>

                    <Label text="Binary File Operations (max. 16 MiB)" styleClass="form-label" style="-fx-font-weight: bold;"/>
                    <HBox spacing="10">
                        <Button text="Encrypt File…" onAction="#handleEncryptFile" styleClass="secondary-button"/>
                        <Button text="Decrypt File…" onAction="#handleDecryptFile" styleClass="secondary-button"/>
                        <Button text="Sign File…" onAction="#handleSignFileDetached" styleClass="secondary-button"/>
                        <Button text="Verify File…" onAction="#handleVerifyFileDetached" styleClass="secondary-button"/>
                    </HBox>

                    <Separator/>

                    <Label text="Detached signature (ASCII armor)" styleClass="form-label"/>
                    <HBox spacing="10">
                        <Button text="Load signature…" onAction="#handleLoadSignature" styleClass="secondary-button"/>
                        <Button text="Save signature…" onAction="#handleSaveSignature" styleClass="secondary-button"/>
                        <Button text="Inspect signature" onAction="#handleInspectDetachedSignature" styleClass="secondary-button"/>
                    </HBox>
                    <TextArea fx:id="openPgpSignatureArea" prefRowCount="3" wrapText="true" styleClass="monospace-field"/>

                    <Separator/>

                    <Label text="Output / Result" styleClass="form-label"/>
                    <HBox spacing="10">
                        <Button text="Save output…" onAction="#handleSaveOutput" styleClass="secondary-button"/>
                    </HBox>
                    <TextArea fx:id="openPgpOutputArea" editable="false" prefRowCount="5" wrapText="true" styleClass="result-area,monospace-field"/>
                </VBox>
            </TitledPane>
        </panes>
    </Accordion>
</VBox>
