<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<Accordion xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cryptocarver.ui.GenericController" fx:id="genericContainer" managed="false" visible="false" styleClass="module-accordion">
    <panes>
        <fx:include source="process_designer.fxml" />
        <!-- KEY & CERTIFICATE FORMAT WORKBENCH -->
        <TitledPane text="🛠 Key &amp; Certificate Format Workbench">
            <VBox spacing="12" styleClass="module-pane-content">
                <Label text="Inspect, convert and validate keys and certificates. Fully supports JWK, PEM, DER, OpenSSH and PKCS#12." wrapText="true" styleClass="helper-text"/>
                <fx:include fx:id="keyCertificateWorkbench" source="key_certificate_workbench.fxml" />
            </VBox>
        </TitledPane>

        <!-- HASHING -->
        <TitledPane text="🔐 Hashing" expanded="true">
            <VBox spacing="12" styleClass="module-pane-content">
                <HBox spacing="8" alignment="CENTER_LEFT" styleClass="form-group-box" style="-fx-margin: 0 0 10 0;">
                    <Label text="Apply Template:" styleClass="form-label"/>
                    <ComboBox fx:id="hashTemplateCombo" promptText="Select a template..." HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="form-field"/>
                    <Button text="Apply" onAction="#handleApplyHashTemplate" styleClass="action-button-primary" style="-fx-font-size: 11px; -fx-padding: 4 10;"/>
                    <MenuButton text="Manage Template" styleClass="secondary-button" style="-fx-font-size: 11px; -fx-padding: 4 10;">
                        <items>
                            <MenuItem text="Save Current as Personal Template..." onAction="#handleSaveHashTemplate"/>
                            <MenuItem text="Export Selected Template..." onAction="#handleExportHashTemplate"/>
                            <MenuItem text="Import Template File..." onAction="#handleImportHashTemplate"/>
                            <MenuItem text="Delete Selected Personal Template" onAction="#handleDeleteHashTemplate"/>
                        </items>
                    </MenuButton>
                    <Button text="Reset Defaults" onAction="#handleResetHashDefaults" styleClass="secondary-button" style="-fx-font-size: 11px; -fx-padding: 4 10;"/>
                </HBox>

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Algorithm:" styleClass="form-label"/>
                    <ComboBox fx:id="hashAlgorithmCombo" prefWidth="200" styleClass="form-field"/>
                </HBox>

                <Label text="Input:" styleClass="form-label"/>
                <TextArea fx:id="hashInputArea" prefRowCount="3" wrapText="true" styleClass="monospace-field"/>

                <Button text="Calculate Hash" onAction="#handleCalculateHash"
                        styleClass="action-button,primary-action" maxWidth="180"/>

                <Label text="Output:" styleClass="form-label"/>
                <TextArea fx:id="hashOutputArea" prefRowCount="2" editable="false" wrapText="true" styleClass="result-area,monospace-field"/>
            </VBox>
        </TitledPane>

        <!-- BATCH RUNNER -->
        <TitledPane text="📦 Batch Runner" expanded="false">
            <VBox spacing="12" styleClass="module-pane-content">
                <Label text="Runs safe, deterministic transformations. Input must contain an input column; no secret keys are accepted." wrapText="true" styleClass="helper-text"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Input:" styleClass="form-label"/>
                    <ComboBox fx:id="batchInputFormatCombo" prefWidth="90" styleClass="form-field"/>
                    <Label text="Operation:" styleClass="form-label"/>
                    <ComboBox fx:id="batchOperationCombo" HBox.hgrow="ALWAYS" styleClass="form-field"/>
                    <Label text="Src Col:" styleClass="form-label"/>
                    <TextField fx:id="batchColumnField" text="input" prefWidth="60" styleClass="form-field"/>
                    <Label text="Out Col:" styleClass="form-label"/>
                    <TextField fx:id="batchOutputColumnField" text="result" prefWidth="60" styleClass="form-field"/>
                </HBox>
                <VBox fx:id="batchCryptoConfigBox" managed="false" visible="false" spacing="8" style="-fx-padding: 8; -fx-border-color: #444; -fx-border-radius: 4;">
                    <GridPane hgap="10" vgap="9" styleClass="form-grid">
                        <columnConstraints>
                            <ColumnConstraints minWidth="80" prefWidth="80"/>
                            <ColumnConstraints minWidth="150" prefWidth="150"/>
                            <ColumnConstraints minWidth="60" prefWidth="60"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Algorithm:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                        <ComboBox fx:id="batchAlgorithmCombo" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="140" styleClass="form-field"/>

                        <Label text="Encoding:" GridPane.rowIndex="0" GridPane.columnIndex="2" styleClass="form-label"/>
                        <ComboBox fx:id="batchRecordEncodingCombo" GridPane.rowIndex="0" GridPane.columnIndex="3" prefWidth="120" styleClass="form-field"/>

                        <Label text="Key (Hex):" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                        <PasswordField fx:id="batchKeyField" promptText="32 bytes (only in memory)" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="3" styleClass="monospace-field,form-field" maxWidth="Infinity"/>

                        <Label text="IV/Nonce:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="batchIvNonceField" promptText="Hex (Req. for CBC)" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="monospace-field,form-field" maxWidth="Infinity"/>

                        <Label text="AAD:" GridPane.rowIndex="2" GridPane.columnIndex="2" styleClass="form-label"/>
                        <TextField fx:id="batchAadField" promptText="Hex (Optional for AEAD)" GridPane.rowIndex="2" GridPane.columnIndex="3" styleClass="monospace-field,form-field" maxWidth="Infinity"/>
                    </GridPane>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Charset:" styleClass="form-label"/>
                        <ComboBox fx:id="batchCharsetCombo" prefWidth="130" styleClass="form-field"/>
                        <CheckBox fx:id="batchStopOnErrorCheck" text="Stop on error" selected="true"/>
                        <CheckBox fx:id="batchCompactModeCheck" text="Compact records"/>
                    </HBox>
                </VBox>
                <TextArea fx:id="batchInputArea" prefRowCount="5" wrapText="false" styleClass="monospace-field" promptText="CSV: input&#10;hello&#10;or JSON Lines (.jsonl): {&quot;input&quot;:&quot;hello&quot;}&#10;{&quot;input&quot;:&quot;world&quot;}"/>
                <Label text="JSON Lines (.jsonl) uses one JSON object per line; it is not a single JSON array/document." wrapText="true" styleClass="helper-text"/>
                <HBox spacing="8">
                    <Button text="Load CSV / JSON Lines…" onAction="#handleBrowseBatchInput" styleClass="secondary-button"/>
                    <Button text="Run Batch" onAction="#handleRunBatch" styleClass="action-button,primary-action"/>
                    <Button text="Cancel" onAction="#handleCancelBatch" styleClass="secondary-button"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <ComboBox fx:id="batchExportFormatCombo" prefWidth="80" styleClass="form-field"/>
                    <Button text="Export Results…" onAction="#handleExportBatchResults" styleClass="secondary-button"/>
                </HBox>
                <ProgressBar fx:id="batchProgressBar" prefWidth="420" maxWidth="1.7976931348623157E308"/>
                <Label fx:id="batchStatusLabel" text="Ready" wrapText="true" styleClass="form-label"/>
                <TextArea fx:id="batchResultArea" prefRowCount="5" editable="false" wrapText="false" styleClass="result-area,monospace-field"/>
            </VBox>
        </TitledPane>

        <!-- ENCODING/CONVERSION -->
        <TitledPane text="🔄 File Conversion" expanded="false">
            <VBox spacing="12" styleClass="module-pane-content">
                <GridPane hgap="10" vgap="9" styleClass="form-grid">
                    <columnConstraints>
                        <ColumnConstraints minWidth="80" prefWidth="80"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Source:" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="form-label"/>
                    <HBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0" HBox.hgrow="ALWAYS">
                        <TextField fx:id="fileInputPathField" promptText="Input File Path" HBox.hgrow="ALWAYS" styleClass="form-field"/>
                        <Button text="..." onAction="#handleBrowseInputFile" style="-fx-min-width: 25px;"/>
                    </HBox>

                    <Label text="Target:" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="form-label"/>
                    <HBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1" HBox.hgrow="ALWAYS">
                        <TextField fx:id="fileOutputPathField" promptText="Output File Path" HBox.hgrow="ALWAYS" styleClass="form-field"/>
                        <Button text="..." onAction="#handleBrowseOutputFile" style="-fx-min-width: 25px;"/>
                    </HBox>

                    <Label text="Compare:" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="form-label"/>
                    <HBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="2" HBox.hgrow="ALWAYS">
                        <TextField fx:id="fileComparePathField" promptText="Second File Path" HBox.hgrow="ALWAYS" styleClass="form-field"/>
                        <Button text="..." onAction="#handleBrowseCompareFile" style="-fx-min-width: 25px;"/>
                    </HBox>

                    <Label text="Format:" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="form-label"/>
                    <HBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="3" alignment="CENTER_LEFT">
                        <ComboBox fx:id="fileInputFormatCombo" promptText="In" prefWidth="100" styleClass="form-field"/>
                        <Label text="->" styleClass="form-label"/>
                        <ComboBox fx:id="fileOutputFormatCombo" promptText="Out" prefWidth="100" styleClass="form-field"/>
                    </HBox>

                    <Label text="Encoding:" GridPane.columnIndex="0" GridPane.rowIndex="4" styleClass="form-label"/>
                    <ComboBox fx:id="fileEncodingCombo" prefWidth="150"
                              GridPane.columnIndex="1" GridPane.rowIndex="4" styleClass="form-field"/>
                </GridPane>

                <HBox spacing="8">
                    <Button text="Convert File" onAction="#handleConvertFile"
                            maxWidth="180" styleClass="action-button,primary-action"/>
                    <Button text="Compare Files (streaming)" onAction="#handleCompareFiles"
                            maxWidth="180" styleClass="secondary-button"/>
                    <Button text="Hash File SHA-256 (streaming)" onAction="#handleHashFileStreaming"
                            maxWidth="200" styleClass="secondary-button"/>
                    <Button text="Preview First 4 KiB" onAction="#handlePreviewFileStreaming"
                            maxWidth="180" styleClass="secondary-button"/>
                </HBox>

                <TextArea fx:id="fileResultArea" prefRowCount="2" editable="false"
                          wrapText="true" styleClass="result-area,monospace-field"/>
            </VBox>
        </TitledPane>

        <!-- MANUAL CONVERSION (NEW) -->
        <TitledPane text="🔤 Manual Conversion" expanded="false">
            <VBox spacing="12" styleClass="module-pane-content">
                 <HBox spacing="8" alignment="CENTER_LEFT" styleClass="form-group-box" style="-fx-margin: 0 0 10 0;">
                     <Label text="Apply Template:" styleClass="form-label"/>
                     <ComboBox fx:id="manualTemplateCombo" promptText="Select a template..." HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="form-field"/>
                     <Button text="Apply" onAction="#handleApplyManualTemplate" styleClass="action-button-primary" style="-fx-font-size: 11px; -fx-padding: 4 10;"/>
                     <MenuButton text="Manage Template" styleClass="secondary-button" style="-fx-font-size: 11px; -fx-padding: 4 10;">
                         <items>
                             <MenuItem text="Save Current as Personal Template..." onAction="#handleSaveManualTemplate"/>
                             <MenuItem text="Export Selected Template..." onAction="#handleExportManualTemplate"/>
                             <MenuItem text="Import Template File..." onAction="#handleImportManualTemplate"/>
                             <MenuItem text="Delete Selected Personal Template" onAction="#handleDeleteManualTemplate"/>
                         </items>
                     </MenuButton>
                     <Button text="Reset Defaults" onAction="#handleResetManualDefaults" styleClass="secondary-button" style="-fx-font-size: 11px; -fx-padding: 4 10;"/>
                 </HBox>

                 <HBox spacing="8" alignment="CENTER_LEFT">
                     <Label text="Input:" styleClass="form-label"/>
                     <ComboBox fx:id="manualInputFormatCombo" prefWidth="150" styleClass="form-field"/>
                 </HBox>
                 <TextArea fx:id="manualInputArea" prefRowCount="3" wrapText="true" styleClass="monospace-field"/>

                 <HBox spacing="8" alignment="CENTER_LEFT">
                     <CheckBox fx:id="ebcdicConversionCheck" text="Enable EBCDIC conversion"/>
                     <ComboBox fx:id="ebcdicDirectionCombo" prefWidth="190" disable="true" styleClass="form-field"/>
                     <Label text="Code page:" styleClass="form-label"/>
                     <ComboBox fx:id="ebcdicCodePageCombo" prefWidth="205" disable="true" styleClass="form-field"/>
                 </HBox>

                 <HBox spacing="8" alignment="CENTER_LEFT">
                     <Label text="Output:" styleClass="form-label"/>
                     <ComboBox fx:id="manualOutputFormatCombo" prefWidth="150" styleClass="form-field"/>
                 </HBox>

                 <HBox spacing="8">
                     <Button text="Convert Data" onAction="#handleManualConvert"
                             maxWidth="180" styleClass="action-button,primary-action"/>
                     <Button text="UTF-8 → Base64URL" onAction="#handleEncodeBase64Url" styleClass="secondary-button"/>
                     <Button text="Base64URL → UTF-8" onAction="#handleDecodeBase64Url" styleClass="secondary-button"/>
                     <Button text="UTF-8 → Base32" onAction="#handleEncodeBase32" styleClass="secondary-button"/>
                     <Button text="Base32 → UTF-8" onAction="#handleDecodeBase32" styleClass="secondary-button"/>
                 </HBox>
                 <HBox spacing="8" alignment="CENTER_LEFT">
                     <Label text="Endian word:" styleClass="form-label"/>
                     <ComboBox fx:id="endianWordSizeCombo" prefWidth="150" styleClass="form-field"/>
                     <Button text="Reverse byte order" onAction="#handleConvertEndian" styleClass="secondary-button"/>
                 </HBox>
                 <HBox spacing="8">
                     <Button text="UTF-8 → URL" onAction="#handleEncodeUrl" styleClass="secondary-button"/>
                     <Button text="URL → UTF-8" onAction="#handleDecodeUrl" styleClass="secondary-button"/>
                 </HBox>
                 <HBox spacing="8" alignment="CENTER_LEFT">
                     <Label text="Compression:" styleClass="form-label"/>
                     <ComboBox fx:id="compressionFormatCombo" prefWidth="120" styleClass="form-field"/>
                     <Button text="Compress" onAction="#handleCompressData" styleClass="secondary-button"/>
                     <Button text="Decompress" onAction="#handleDecompressData" styleClass="secondary-button"/>
                 </HBox>
                 <HBox spacing="8">
                     <Button text="Decimal → BCD" onAction="#handleEncodeBcd" styleClass="secondary-button"/>
                     <Button text="BCD → Decimal" onAction="#handleDecodeBcd" styleClass="secondary-button"/>
                     <Button text="Decimal → COMP-3" onAction="#handleEncodeComp3" styleClass="secondary-button"/>
                     <Button text="COMP-3 → Decimal" onAction="#handleDecodeComp3" styleClass="secondary-button"/>
                 </HBox>

                 <TextArea fx:id="manualOutputArea" prefRowCount="3" editable="false" wrapText="true" styleClass="result-area,monospace-field"/>
            </VBox>
        </TitledPane>

        <!-- COMPRESSED HEX / TWO-ROW HOST VIEW -->
        <fx:include fx:id="compressedHexPane" source="compressed_hex.fxml"/>

        <!-- UUID GENERATOR -->
        <TitledPane text="🆔 UUID Generator" expanded="false">
            <VBox spacing="12" styleClass="module-pane-content">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Generate random UUID (v4):" styleClass="form-label"/>
                    <TextField fx:id="uuidOutputField" editable="false" styleClass="monospace-field,form-field" prefWidth="350"/>
                    <Button text="Generate UUID" onAction="#handleGenerateUUID"
                            maxWidth="180" styleClass="action-button,primary-action"/>
                </HBox>
            </VBox>
        </TitledPane>

        <!-- RANDOM NUMBER GENERATOR -->
        <TitledPane text="🎲 Random Generator" expanded="false">
            <VBox spacing="12" styleClass="module-pane-content">
                <GridPane hgap="10" vgap="9" styleClass="form-grid">
                    <columnConstraints>
                        <ColumnConstraints minWidth="80" prefWidth="80"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Bytes:" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="form-label"/>
                    <TextField fx:id="randomBytesField" text="16" prefWidth="80"
                               GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="form-field"/>

                    <Label text="Format:" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="form-label"/>
                    <ComboBox fx:id="randomFormatCombo" prefWidth="150"
                              GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="form-field"/>
                </GridPane>

                <Button text="Generate Random" onAction="#handleGenerateRandom"
                        styleClass="action-button,primary-action" maxWidth="180"/>

                <Label text="Output:" styleClass="form-label"/>
                <TextArea fx:id="randomOutputArea" prefRowCount="3" editable="false" wrapText="true" styleClass="result-area,monospace-field"/>
            </VBox>
        </TitledPane>

        <!-- CHECK DIGITS -->
        <TitledPane text="✅ Check Digits" expanded="false">
            <VBox spacing="12" styleClass="module-pane-content">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Algorithm:" styleClass="form-label"/>
                    <ComboBox fx:id="checkDigitAlgorithmCombo" prefWidth="200" styleClass="form-field"/>
                </HBox>

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Input:" styleClass="form-label"/>
                    <TextField fx:id="checkDigitInput" promptText="Enter number" styleClass="form-field" prefWidth="300"/>
                </HBox>

                <HBox spacing="8">
                    <Button text="Calculate" onAction="#handleCalculateCheckDigit"
                            styleClass="action-button,primary-action"/>
                    <Button text="Validate" onAction="#handleValidateCheckDigit"
                            styleClass="secondary-button"/>
                </HBox>

                <Label text="Output / Validation:" styleClass="form-label"/>
                <TextField fx:id="checkDigitOutput" editable="false" styleClass="result-area,monospace-field"/>
            </VBox>
        </TitledPane>

        <!-- MODULAR ARITHMETIC -->
        <TitledPane text="🔢 Modular Arithmetic" expanded="false">
            <VBox spacing="12" styleClass="module-pane-content">
                <GridPane hgap="10" vgap="9" styleClass="form-grid">
                    <columnConstraints>
                        <ColumnConstraints minWidth="120" prefWidth="120"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Operation:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                    <ComboBox fx:id="modOperationCombo" prefWidth="200" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="form-field"/>

                    <Label text="Operand A (Hex):" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                    <TextField fx:id="modOperandAField" GridPane.rowIndex="1" GridPane.columnIndex="1" maxWidth="Infinity" styleClass="monospace-field,form-field"/>

                    <Label text="Operand B (Hex):" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
                    <TextField fx:id="modOperandBField" GridPane.rowIndex="2" GridPane.columnIndex="1" maxWidth="Infinity" styleClass="monospace-field,form-field"/>

                    <Label text="Modulus (Hex):" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="form-label"/>
                    <TextField fx:id="modModulusField" GridPane.rowIndex="3" GridPane.columnIndex="1" maxWidth="Infinity" styleClass="monospace-field,form-field"/>
                </GridPane>

                <Button text="Calculate" onAction="#handleModularCalculate"
                        maxWidth="180" styleClass="action-button,primary-action"/>

                <Label text="Result:" styleClass="form-label"/>
                <TextArea fx:id="modResultArea" prefRowCount="2" editable="false"
                          wrapText="true" styleClass="result-area,monospace-field"/>
            </VBox>
        </TitledPane>
    </panes>
</Accordion>
