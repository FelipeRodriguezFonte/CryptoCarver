<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="mainHistoryContainer" spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cryptocarver.ui.HistoryController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Header: split in rows so every action stays readable on ordinary window widths. -->
    <VBox spacing="7">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label styleClass="ux-inline-c7cf31c907" text="Recent Operations" />
            <Label styleClass="ux-inline-aaca1a5100" fx:id="historySummaryLabel" text="0 operations" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Values:" />
            <ComboBox fx:id="visibilityCombo" prefWidth="215.0">
                <tooltip>
                    <Tooltip text="Choose Unsafe lab to reveal all values. This also controls report and recipe export." />
                </tooltip>
            </ComboBox>
            <Label styleClass="ux-inline-d8d7ab2893" fx:id="unsafeVisibilityWarningLabel" text="⚠ Unsafe lab: sensitive values are visible" />
        </HBox>

        <FlowPane alignment="CENTER_LEFT" prefWrapLength="900.0" styleClass="responsive-action-bar">
            <Label text="Filter:" />
            <TextField fx:id="historyFilterField" prefWidth="220.0" promptText="Operation, date or property" />
            <Label text="Module:" />
            <ComboBox fx:id="historyModuleFilterCombo" prefWidth="145.0" promptText="All modules" />
            <Button styleClass="ux-inline-5d5d194412" onAction="#handleClearHistoryFilter" text="Clear filters" />
            <Button styleClass="ux-inline-b2a28a2c9c" fx:id="compareBtn" onAction="#handleCompareHistory" text="Compare 2" />
            <Button styleClass="ux-inline-f8ea22b522" onAction="#importOperationRecipe" text="Import Recipe" />
            <Button styleClass="ux-inline-6ab6128509" onAction="#handleClearHistory" text="Clear History" />
        </FlowPane>

        <FlowPane prefWrapLength="900.0" styleClass="responsive-action-bar">
            <Label styleClass="ux-inline-aaca1a5100" text="The latest operation is selected automatically. Select a different row to export it." />
            <Button styleClass="ux-inline-c2a64d8f72" fx:id="openHistoryDetailBtn" onAction="#openSelectedHistoryDetail" text="Open Selected Value">
                <tooltip>
                    <Tooltip text="Open the complete value of the selected detail in the expanded viewer." />
                </tooltip>
            </Button>
            <Button styleClass="ux-inline-282fb38d27" fx:id="addHistoryToShelfBtn" onAction="#handleAddSelectedHistoryToShelf" text="Add Output to Shelf">
                <tooltip>
                    <Tooltip text="Save only the published output of the selected operation; never reruns it." />
                </tooltip>
            </Button>
            <Button styleClass="ux-inline-f8ea22b522" fx:id="copyHistoryDetailBtn" onAction="#copySelectedHistoryDetail" text="Copy Selected Value" />
            <Button styleClass="ux-inline-7624a84ff8" fx:id="exportJsonRecordBtn" onAction="#exportSelectedHistoryRecord" text="Export JSON Record">
                <tooltip>
                    <Tooltip text="Export the selected execution, including its input/output according to the Values policy." />
                </tooltip>
            </Button>
            <Button styleClass="ux-inline-525f1e68d6" fx:id="exportVisibleJsonBtn" onAction="#exportVisibleHistoryRecords" text="Export Visible JSON">
                <tooltip>
                    <Tooltip text="Export every operation currently shown by the filters, according to the Values policy." />
                </tooltip>
            </Button>
            <Button styleClass="ux-inline-282fb38d27" fx:id="exportReportBtn" onAction="#exportSelectedHistoryReport" text="Export Markdown Report">
                <tooltip>
                    <Tooltip text="Export the selected operation as Markdown using the selected values policy." />
                </tooltip>
            </Button>
            <Button styleClass="ux-inline-f8ea22b522" fx:id="copyReportBtn" onAction="#copySelectedHistoryReport" text="Copy Markdown Report">
                <tooltip>
                    <Tooltip text="Copy a Markdown report using the selected values policy." />
                </tooltip>
            </Button>
            <Button styleClass="ux-inline-3a31050b85" fx:id="exportRecipeBtn" onAction="#exportSelectedHistoryRecipe" text="Export JSON Recipe">
                <tooltip>
                    <Tooltip text="Export the selected operation as a reusable JSON recipe." />
                </tooltip>
            </Button>
        </FlowPane>
    </VBox>

    <!-- Content SplitPane -->
    <SplitPane dividerPositions="0.6" orientation="VERTICAL" VBox.vgrow="ALWAYS">
        <items>
            <!-- Top/Left: History Table -->
            <TableView fx:id="historyTable">
                <columns>
                    <TableColumn fx:id="timeCol" text="Time" />
                    <TableColumn fx:id="opCol" text="Operation" />
                    <TableColumn fx:id="actionCol" text="Action" />
                </columns>
            </TableView>

            <!-- Bottom/Right: Details -->
            <VBox spacing="5">
                <Label styleClass="ux-inline-2ed34ee4bc" text="Operation Details" />
                <TableView fx:id="detailsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="nameCol" text="Property" />
                        <TableColumn fx:id="valCol" text="Value" />
                        <TableColumn fx:id="classCol" maxWidth="80.0" text="Class" />
                    </columns>
                </TableView>
            </VBox>
        </items>
    </SplitPane>
</VBox>
