<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.TextFlow?>
<?import com.cryptocarver.ui.NavigationRail?>
<?import com.cryptocarver.ui.SidePanel?>
<?import com.cryptocarver.ui.ResponsiveWorkspaceSplitPane?>
<?import com.cryptocarver.ui.ModuleHost?>
<?import com.cryptocarver.ui.NativeTextEditMenuItem?>
<?import com.cryptocarver.ui.NativeTextEditMenuItem?>

<StackPane fx:id="rootStackPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.cryptocarver.ui.ModernMainController">

<BorderPane fx:id="mainPane">

    <!-- Menu Bar -->
    <top>
        <VBox>
            <MenuBar fx:id="mainMenuBar" styleClass="main-menu-bar">
                <Menu fx:id="fileMenu" text="File">
                    <MenuItem fx:id="importKeyMenuItem" text="Import Key..." onAction="#handleImportKey" accelerator="Shortcut+O" />
                    <SeparatorMenuItem />
                    <MenuItem fx:id="exportScreenMenuItem" text="Export Screen Configuration..." onAction="#handleExportScreenConfiguration" />
                    <MenuItem fx:id="importScreenMenuItem" text="Import Screen Configuration..." onAction="#handleImportScreenConfiguration" />
                    <SeparatorMenuItem />
                    <MenuItem fx:id="saveSessionMenuItem" text="Save Session" onAction="#handleSaveSession" accelerator="Shortcut+S" />
                    <MenuItem fx:id="exportSessionTrailMenuItem" text="Export Session Trail..." onAction="#handleExportSessionTrail" />
                    <MenuItem fx:id="exportHistoryMenuItem" text="Export History..." onAction="#handleExportHistory" />
                    <SeparatorMenuItem />
                    <MenuItem fx:id="exitMenuItem" text="Exit" onAction="#handleExit" accelerator="Shortcut+Q" />
                </Menu>

                <Menu fx:id="editMenu" text="%menu.edit">
                    <NativeTextEditMenuItem text="%menu.undo" operation="UNDO" />
                    <NativeTextEditMenuItem text="%menu.redo" operation="REDO" />
                    <SeparatorMenuItem />
                    <NativeTextEditMenuItem text="%menu.cut" operation="CUT" />
                    <NativeTextEditMenuItem text="%menu.copy" operation="COPY" />
                    <NativeTextEditMenuItem text="%menu.paste" operation="PASTE" />
                    <NativeTextEditMenuItem text="%menu.selectAll" operation="SELECT_ALL" />
                    <SeparatorMenuItem />
                    <MenuItem fx:id="clearInputMenuItem" text="Clear Input" onAction="#handleClearInput" />
                    <MenuItem fx:id="clearOutputMenuItem" text="Clear Output" onAction="#handleClearOutput" accelerator="Shortcut+Shift+O" />
                    <MenuItem fx:id="copyOutputMenuItem" text="Copy Output" onAction="#handleCopyOutput" accelerator="Shortcut+Shift+C" />
                    <MenuItem fx:id="addToShelfMenuItem" text="Add Output to Clipboard Shelf" onAction="#handleAddCurrentOutputToShelf" />
                    <MenuItem fx:id="clipboardShelfMenuItem" text="Open Clipboard Shelf" onAction="#handleOpenClipboardShelf" accelerator="Shortcut+Shift+V" />
                </Menu>

                <Menu fx:id="viewMenu" text="View">
                    <MenuItem fx:id="quickStartMenuItem" text="Quick Start" onAction="#handleQuickStart" accelerator="Shortcut+Shift+H" />
                    <MenuItem fx:id="commandPaletteMenuItem" text="Command Palette..." onAction="#handleOpenCommandPalette" accelerator="Shortcut+K" />
                    <SeparatorMenuItem/>
                    <MenuItem fx:id="toggleSidePanelMenuItem" text="Toggle Side Panel" onAction="#handleToggleSidePanel" accelerator="Shortcut+B" />
                    <MenuItem fx:id="toggleInspectorMenuItem" text="Toggle Inspector" onAction="#handleToggleInspector" accelerator="Shortcut+I" />
                    <MenuItem fx:id="expandResultMenuItem" text="Expand Result" onAction="#handleOpenExpandedResultViewer" accelerator="Shortcut+Shift+E" />
                    <MenuItem fx:id="expandTableMenuItem" text="Expand Table" onAction="#handleOpenExpandedTableViewer" accelerator="Shortcut+Shift+T" />
                    <SeparatorMenuItem/>
                    <MenuItem fx:id="zoomInMenuItem" text="Zoom In (Font)" onAction="#handleIncreaseFontSize" accelerator="Shortcut+PLUS" />
                    <MenuItem fx:id="zoomOutMenuItem" text="Zoom Out (Font)" onAction="#handleDecreaseFontSize" accelerator="Shortcut+MINUS" />
                    <SeparatorMenuItem/>
                    <MenuItem fx:id="resetViewMenuItem" text="Reset to Defaults" onAction="#handleResetView"/>
                    <SeparatorMenuItem/>
                    <Menu fx:id="languageMenu" text="Language">
                        <fx:define><ToggleGroup fx:id="languagePreferenceGroup"/></fx:define>
                        <RadioMenuItem fx:id="languageSystemMenuItem" text="System" userData="SYSTEM" toggleGroup="$languagePreferenceGroup" onAction="#handleLanguageSystem"/>
                        <RadioMenuItem fx:id="languageEsMenuItem" text="Español" userData="ES" toggleGroup="$languagePreferenceGroup" onAction="#handleLanguageEs"/>
                        <RadioMenuItem fx:id="languageEnMenuItem" text="English" userData="EN" toggleGroup="$languagePreferenceGroup" onAction="#handleLanguageEn"/>
                    </Menu>
                    <Menu fx:id="appearanceMenu" text="Appearance">
                        <fx:define><ToggleGroup fx:id="themePreferenceGroup"/></fx:define>
                        <RadioMenuItem fx:id="themeSystemMenuItem" text="System" toggleGroup="$themePreferenceGroup" onAction="#handleThemeSystem"/>
                        <RadioMenuItem fx:id="themeLightMenuItem" text="Light" toggleGroup="$themePreferenceGroup" onAction="#handleThemeLight"/>
                        <RadioMenuItem fx:id="themeDarkMenuItem" text="Dark" toggleGroup="$themePreferenceGroup" onAction="#handleThemeDark"/>
                    </Menu>
                </Menu>

                <Menu fx:id="laboratoryMenu" text="%menu.laboratory" userData="laboratory">
                    <MenuItem fx:id="laboratoryQuickStartMenuItem" text="%menu.quickStart" onAction="#handleQuickStart" />
                </Menu>

                <Menu fx:id="toolsMenu" text="Tools">
                    <MenuItem fx:id="epochMenuItem" text="Epoch Converter" onAction="#handleEpochConverter" accelerator="Shortcut+T"/>
                    <MenuItem fx:id="jsonMenuItem" text="JSON Formatter" onAction="#handleJsonFormatter" accelerator="Shortcut+J"/>
                    <MenuItem fx:id="byteInspectorMenuItem" text="Byte Inspector" onAction="#handleByteInspector"/>
                    <SeparatorMenuItem/>
                    <MenuItem fx:id="clearKeyCacheMenuItem" text="Clear Lab Key Cache" onAction="#handleClearLabKeyCache"/>
                </Menu>

                <Menu fx:id="securityMenu" text="Security">
                    <fx:define>
                        <ToggleGroup fx:id="visibilityProfileGroup"/>
                    </fx:define>
                    <RadioMenuItem fx:id="visibilityFullLabMenuItem" text="%menu.visibility.full" toggleGroup="$visibilityProfileGroup" selected="true" onAction="#handleVisibilityFullLab" />
                    <RadioMenuItem fx:id="visibilityMaskedMenuItem" text="%menu.visibility.masked" toggleGroup="$visibilityProfileGroup" onAction="#handleVisibilityMasked" />
                    <RadioMenuItem fx:id="visibilityRedactedMenuItem" text="%menu.visibility.redacted" toggleGroup="$visibilityProfileGroup" onAction="#handleVisibilityRedacted" />
                </Menu>

                <Menu fx:id="helpMenu" text="Help">
                    <MenuItem fx:id="shortcutsMenuItem" text="Keyboard Shortcuts..." onAction="#handleShowKeyboardShortcuts" accelerator="F1" />
                    <SeparatorMenuItem />
                    <MenuItem fx:id="diagnosticsMenuItem" text="Diagnostics" onAction="#handleDiagnostics"/>
                    <MenuItem fx:id="aboutMenuItem" text="About" onAction="#handleAbout"/>
                </Menu>
            </MenuBar>

            <!-- Toolbar -->
            <HBox alignment="CENTER_LEFT" spacing="10" minHeight="44" prefHeight="44" maxHeight="44" styleClass="main-toolbar">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Button text="☰" onAction="#handleToggleSidePanel" styleClass="ghost-button" accessibleText="Toggle side panel"/>
                    <Button fx:id="toolbarSearchButton" text="Search operations" onAction="#handleOpenCommandPalette" styleClass="secondary-button"/>
                    <Button fx:id="toolbarSaveSessionButton" text="Save Session" onAction="#handleSaveSession" styleClass="link-button"/>
                </HBox>

                <!-- Format Flow Bar -->
                <HBox fx:id="formatFlowBar" alignment="CENTER" spacing="8" styleClass="format-flow-bar">
                    <Label fx:id="inputFormatLabel" text="Payload format:" styleClass="format-flow-label">
                        <tooltip>
                            <Tooltip text="Applies to the operation payload. Keys, IVs, salts, signatures and certificates have their own formats."/>
                        </tooltip>
                    </Label>
                    <ComboBox fx:id="inputFormatCombo" prefWidth="160" styleClass="format-combo"
                              accessibleText="Payload format selector"
                              accessibleHelp="Select the format for the operation payload.">
                        <tooltip>
                            <Tooltip text="Applies to the operation payload. Keys, IVs, salts, signatures and certificates have their own formats."/>
                        </tooltip>
                    </ComboBox>

                    <Label text="→" styleClass="format-flow-arrow"/>

                    <Label fx:id="contractOperationLabel" text="Operation" styleClass="format-flow-operation"/>

                    <Label text="→" styleClass="format-flow-arrow"/>

                    <Label fx:id="outputFormatLabel" text="Output:" styleClass="format-flow-label"/>
                    <ComboBox fx:id="outputFormatCombo" prefWidth="160" styleClass="format-combo"
                              accessibleText="Output format selector"
                              accessibleHelp="Select the format used to display the operation output."/>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Inspector" onAction="#handleToggleInspector" styleClass="ghost-button" accessibleText="Toggle inspector"/>
            </HBox>
        </VBox>
    </top>

    <!-- Main Content Area with Rail + SidePanel + Content + Inspector -->
    <center>
        <ResponsiveWorkspaceSplitPane fx:id="workspaceSplitPane" dividerPositions="0.22, 0.78">
            <items>
                <!-- Navigation tree: rail plus section tree. -->
                <HBox minWidth="200" styleClass="workspace-tree-pane">
                    <NavigationRail fx:id="navigationRail"/>
                    <SidePanel fx:id="sidePanel"/>
                </HBox>

                <!-- Main Content Area -->
                <VBox fx:id="mainContentArea" minWidth="560" styleClass="main-content-vbox">

                <!-- Content Header with Breadcrumbs & Favorite Star Toggle -->
                <HBox styleClass="content-header" alignment="CENTER_LEFT" spacing="10">
                    <HBox fx:id="breadcrumbContainer" alignment="CENTER_LEFT" spacing="4" styleClass="breadcrumb-container" HBox.hgrow="ALWAYS">
                        <Button fx:id="breadcrumbSectionBtn" text="Keys" styleClass="breadcrumb-button" onAction="#handleBreadcrumbSectionClick" accessibleText="Navigate to Section"/>
                        <Label text="›" styleClass="breadcrumb-separator" fx:id="breadcrumbSep1"/>
                        <Button fx:id="breadcrumbModuleBtn" text="Symmetric" styleClass="breadcrumb-button" onAction="#handleBreadcrumbModuleClick" accessibleText="Navigate to Module"/>
                        <Label text="›" styleClass="breadcrumb-separator" fx:id="breadcrumbSep2"/>
                        <Label fx:id="breadcrumbOperationLabel" text="Symmetric Ciphers" styleClass="breadcrumb-current"/>
                    </HBox>
                    <Label fx:id="contentTitleLabel" text="Symmetric Keys" styleClass="content-title-label" managed="false" visible="false"/>
                    <Label fx:id="contentSubtitleLabel" text="Key Derivation (KDF)" styleClass="content-subtitle-label" managed="false" visible="false"/>
                    <Button fx:id="favoriteToggleBtn" text="☆" onAction="#handleToggleFavorite" styleClass="favorite-toggle-button" accessibleText="Toggle Favorite for current operation"/>
                </HBox>

                <!-- Result Summary Bar (Compact header) -->
                <HBox fx:id="resultSummaryBar" spacing="12" alignment="CENTER_LEFT" managed="false" visible="false" styleClass="result-summary-bar">
                    <FlowPane hgap="10" vgap="4" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                        <Label fx:id="resultLastLabel" text="Last Result:" styleClass="result-summary-label"/>
                        <Label fx:id="resultOpLabel" text="N/A" styleClass="result-summary-value"/>
                        <Label fx:id="resultAlgorithmStaticLabel" text="Algorithm:" styleClass="result-summary-label"/>
                        <Label fx:id="resultAlgoLabel" text="N/A" styleClass="result-summary-value"/>
                        <Label fx:id="resultSizeLabel" text="In: 0B / Out: 0B" styleClass="result-summary-value"/>
                        <Label fx:id="resultFormatLabel" text="Not applicable" styleClass="result-summary-value"/>
                        <Label fx:id="resultStatusBadge" text="NEUTRAL" styleClass="result-status-neutral" accessibleText="Last operation result status: NEUTRAL"/>
                    </FlowPane>
                    <FlowPane prefWrapLength="400" hgap="6" vgap="6" alignment="CENTER_RIGHT" styleClass="responsive-action-bar">
                        <Button fx:id="resultSaveStepButton" text="Save Step" onAction="#handleSaveCurrentResultAsSessionStep" styleClass="secondary-button" accessibleText="Save the current result in the session trail"/>
                        <Button fx:id="resultExpandButton" text="Expand Result" onAction="#handleOpenExpandedResultViewer" styleClass="secondary-button" accessibleText="Expand result viewer"/>
                        <Button fx:id="resultShelfButton" text="Add to Shelf" onAction="#handleAddCurrentOutputToShelf" styleClass="secondary-button" accessibleText="Add current output to clipboard shelf"/>
                        <Button fx:id="resultCopyButton" text="Copy Output" onAction="#handleCopyOutput" styleClass="action-button-primary" accessibleText="Copy output to clipboard"/>
                    </FlowPane>
                </HBox>

                <!-- Inline Actionable Error Banner -->
                <HBox fx:id="errorBanner" spacing="12" alignment="CENTER_LEFT" managed="false" visible="false" focusTraversable="false" styleClass="inline-error-banner">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Label styleClass="ux-inline-da9c4cada5" text="⚠️" accessibleText=""/>
                            <Label fx:id="errorBannerTitle" text="Operation Failed" accessibleText="Operation Failed" accessibleHelp="Error message" styleClass="error-banner-title"/>
                        </HBox>
                        <Label fx:id="errorBannerRemedy" text="Check parameters and try again." accessibleText="Check parameters and try again." accessibleHelp="Recommended action" styleClass="error-banner-remedy" wrapText="true"/>
                    </VBox>
                    <HBox spacing="6" alignment="CENTER_RIGHT">
                        <Button fx:id="errorBannerGoToFieldBtn" text="Go to field" onAction="#handleErrorBannerGoToField" focusTraversable="true" accessibleText="Go to field" accessibleHelp="Move focus to the invalid field" styleClass="error-banner-btn-secondary" managed="false" visible="false"/>
                        <Button fx:id="errorBannerCopyDetailsBtn" text="Copy technical details" onAction="#handleErrorBannerCopyDetails" focusTraversable="true" accessibleText="Copy technical details" accessibleHelp="Copy redacted technical details" styleClass="error-banner-btn-secondary"/>
                        <Button fx:id="errorBannerCloseBtn" text="✕" onAction="#handleErrorBannerClose" focusTraversable="true" styleClass="error-banner-btn-close" accessibleText="Dismiss the validation message" accessibleHelp="Close the error and restore focus"/>
                    </HBox>
                </HBox>

                <!-- Guided Flow Panel (reusable) -->
                <HBox fx:id="guidedFlowPanel" spacing="15" alignment="CENTER_LEFT" managed="false" visible="false" styleClass="guided-flow-panel ux-inline-d8a3fb5a2c">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label styleClass="ux-inline-47484768be" fx:id="guideStepTitleLabel" text="Step 1: Choose data/input format"/>
                        <Label styleClass="ux-inline-b2d7ff5bea" fx:id="guideStepDescLabel" text="Configure the input source type and encoding on the format flow bar." wrapText="true"/>
                    </VBox>
                    <HBox spacing="8" alignment="CENTER_RIGHT">
                        <Button fx:id="guideBackBtn" text="Back" onAction="#handleGuideBack" styleClass="secondary-button ux-inline-401c00305b"/>
                        <Button fx:id="guideNextBtn" text="Next" onAction="#handleGuideNext" styleClass="action-button-primary ux-inline-401c00305b"/>
                        <Button fx:id="guideSkipBtn" text="Skip Guidance" onAction="#handleGuideSkip" styleClass="secondary-button ux-inline-401c00305b"/>
                        <Button fx:id="guideExitBtn" text="Exit" onAction="#handleGuideExit" styleClass="secondary-button ux-inline-401c00305b"/>
                    </HBox>
                </HBox>

                <!-- Execution Readiness Panel (reusable compact card) -->
                <HBox fx:id="readinessPanel" spacing="12" alignment="CENTER_LEFT" managed="false" visible="false" styleClass="readiness-panel ux-inline-4ca8ef014b">
                    <Label fx:id="readinessStatusBadge" text="✔ READY" styleClass="readiness-status-ready"/>
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label styleClass="ux-inline-d9f657c0dd" fx:id="readinessSummaryLabel" text="Execution Readiness Checklist"/>
                        <FlowPane fx:id="readinessChecksContainer" hgap="10" vgap="4"/>
                    </VBox>
                    <Button fx:id="readinessToggleDetailsBtn" text="Show Details" onAction="#handleToggleReadinessDetails" styleClass="secondary-button ux-inline-8e3aa95844"/>
                </HBox>

                <!-- Scrollable Content -->
                <ScrollPane fx:id="mainScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="content-scroll-pane">
                    <VBox fx:id="contentContainer" spacing="0" styleClass="content-container-vbox">

                        <!-- Quick Start Container -->
                        <VBox styleClass="ux-inline-8d20c1fddd" fx:id="quickStartContainer" managed="false" visible="false" spacing="20">
                            <VBox spacing="5">
                                <Label text="Laboratory Quick Start" styleClass="quick-start-title ux-inline-fb7f3b0802"/>
                                <Label text="Choose a guided workflow to easily configure standard cryptographic and data operations." styleClass="quick-start-description ux-inline-da9c4cada5"/>
                            </VBox>

                            <GridPane hgap="15" vgap="15">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50"/>
                                    <ColumnConstraints percentWidth="50"/>
                                </columnConstraints>

                                <!-- Card 1: Encrypt a message -->
                                <VBox styleClass="form-group-box" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="🔒 Encrypt a message" styleClass="form-group-title"/>
                                    <Label text="Secure data using symmetric keys (e.g. AES-256)." styleClass="helper-text" wrapText="true"/>
                                    <HBox styleClass="ux-inline-b5ef81bd0a" spacing="8" alignment="CENTER_LEFT">
                                        <Label styleClass="ux-inline-0ed0fa4650" text="Sensitivity:"/>
                                        <Label styleClass="ux-inline-c0bff2bb67" text="Medium (Key Material / Secrets)"/>
                                    </HBox>
                                    <Region styleClass="ux-inline-f82d03488b" VBox.vgrow="ALWAYS"/>
                                    <Button text="Start guided flow" onAction="#handleStartGuidedEncrypt" styleClass="action-button-primary ux-inline-7011792fac"/>
                                </VBox>

                                <!-- Card 2: Calculate a hash -->
                                <VBox styleClass="form-group-box" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="🔐 Calculate a hash" styleClass="form-group-title"/>
                                    <Label text="Generate a secure one-way hash (e.g. SHA-256)." styleClass="helper-text" wrapText="true"/>
                                    <HBox styleClass="ux-inline-b5ef81bd0a" spacing="8" alignment="CENTER_LEFT">
                                        <Label styleClass="ux-inline-0ed0fa4650" text="Sensitivity:"/>
                                        <Label styleClass="ux-inline-bed983efd1" text="Low (No secrets involved)"/>
                                    </HBox>
                                    <Region styleClass="ux-inline-f82d03488b" VBox.vgrow="ALWAYS"/>
                                    <Button text="Start guided flow" onAction="#handleStartGuidedHash" styleClass="action-button-primary ux-inline-7011792fac"/>
                                </VBox>

                                <!-- Card 3: Sign or verify data -->
                                <VBox styleClass="form-group-box" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <Label text="🖋 Sign or verify data" styleClass="form-group-title"/>
                                    <Label text="Generate asymmetric signatures or verify authenticity." styleClass="helper-text" wrapText="true"/>
                                    <HBox styleClass="ux-inline-b5ef81bd0a" spacing="8" alignment="CENTER_LEFT">
                                        <Label styleClass="ux-inline-0ed0fa4650" text="Sensitivity:"/>
                                        <Label styleClass="ux-inline-1ec5e1dd8f" text="High (Private signing keys)"/>
                                    </HBox>
                                    <Region styleClass="ux-inline-f82d03488b" VBox.vgrow="ALWAYS"/>
                                    <Button text="Start guided flow" onAction="#handleStartGuidedSign" styleClass="action-button-primary ux-inline-7011792fac"/>
                                </VBox>

                                <!-- Card 4: Inspect a certificate -->
                                <VBox styleClass="form-group-box" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <Label text="🔍 Inspect a certificate" styleClass="form-group-title"/>
                                    <Label text="Parse and validate public X.509 certificates." styleClass="helper-text" wrapText="true"/>
                                    <HBox styleClass="ux-inline-b5ef81bd0a" spacing="8" alignment="CENTER_LEFT">
                                        <Label styleClass="ux-inline-0ed0fa4650" text="Sensitivity:"/>
                                        <Label styleClass="ux-inline-bed983efd1" text="Low (Public data only)"/>
                                    </HBox>
                                    <Region styleClass="ux-inline-f82d03488b" VBox.vgrow="ALWAYS"/>
                                    <Button text="Start guided flow" onAction="#handleStartGuidedCert" styleClass="action-button-primary ux-inline-7011792fac"/>
                                </VBox>

                                <!-- Card 5: Convert encodings -->
                                <VBox styleClass="form-group-box" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                    <Label text="🔄 Convert encodings" styleClass="form-group-title"/>
                                    <Label text="Transform data formats (Base64, Hex, EBCDIC, etc.)." styleClass="helper-text" wrapText="true"/>
                                    <HBox styleClass="ux-inline-b5ef81bd0a" spacing="8" alignment="CENTER_LEFT">
                                        <Label styleClass="ux-inline-0ed0fa4650" text="Sensitivity:"/>
                                        <Label styleClass="ux-inline-bed983efd1" text="Low (No secrets)"/>
                                    </HBox>
                                    <Region styleClass="ux-inline-f82d03488b" VBox.vgrow="ALWAYS"/>
                                    <Button text="Start guided flow" onAction="#handleStartGuidedConvert" styleClass="action-button-primary ux-inline-7011792fac"/>
                                </VBox>
                            </GridPane>
                        </VBox>

                        <!-- PLACEHOLDER - Real content will be loaded dynamically -->
                        <Label fx:id="contentPlaceholderLabel" text="Select an operation from the side panel"
                               styleClass="placeholder-label"/>

                        <!-- This is where Symmetric Keys Accordion will be loaded -->
                        <!-- Saved Sessions Container -->
                        <ModuleHost fx:id="jose" resource="/fxml/jose.fxml" managed="false" visible="false" />
                        <ModuleHost fx:id="cose" resource="/fxml/cose.fxml" managed="false" visible="false" />
                        <ModuleHost fx:id="wallet" resource="/fxml/wallet.fxml" managed="false" visible="false" />


                        <VBox styleClass="ux-inline-8d20c1fddd" fx:id="savedSessionsContainer" managed="false" visible="false" spacing="15">
                            <!-- Header -->
                            <VBox spacing="5">
                                <Label styleClass="ux-inline-98d654c0fb" text="Saved Sessions"/>
                                <Label styleClass="ux-inline-0665f452ba" text="Restore your previous work sessions."/>
                            </VBox>

                            <!-- Sessions List -->
                            <VBox fx:id="savedSessionsList" spacing="10"/>
                        </VBox>

                        <!-- Keys Container -->
                        <ModuleHost fx:id="keysContainer" resource="/fxml/keys.fxml" managed="false" visible="false" />

                        <!-- Certificates Operations -->
                        <ModuleHost fx:id="certificatesContainer" resource="/fxml/certificates.fxml" managed="false" visible="false" />

                        <!-- CIPHER CONTENT -->
                        <ModuleHost fx:id="cipherContainer" resource="/fxml/cipher.fxml" managed="false" visible="false" />

                        <!-- Authentication Container -->
                        <ModuleHost fx:id="authenticationContainer" resource="/fxml/authentication.fxml" managed="false" visible="false" />

                        <!-- Payments Container -->
                        <ModuleHost fx:id="paymentsContainer" resource="/fxml/payments.fxml" managed="false" visible="false" />

                        <!-- EMV Container -->
                        <ModuleHost fx:id="emvContainer" resource="/fxml/emv.fxml" managed="false" visible="false" />

                        <!-- Generic Utilities Container -->
                        <!-- GENERIC CONTENT (Hashing, Encoding, etc) -->
                <ModuleHost fx:id="genericContainer" resource="/fxml/generic.fxml" managed="false" visible="false" />

                    <!-- Recent Operations / History -->
                    <ModuleHost fx:id="historyView" resource="/fxml/history.fxml" managed="false" visible="false" />
                    <ModuleHost fx:id="clipboardShelf" resource="/fxml/clipboard_shelf.fxml" managed="false" visible="false" />

                    <!-- Post-Quantum Cryptography Container -->
                    <ModuleHost fx:id="postQuantumContainer" resource="/fxml/pqc.fxml" managed="false" visible="false" />

                    <!-- XML Security Container -->
                    <ModuleHost fx:id="xmlSecurityContainer" resource="/fxml/xml_security.fxml" managed="false" visible="false" />

                    <!-- WSS Security Container -->
                    <ModuleHost fx:id="wssSecurityContainer" resource="/fxml/wss_security.fxml" managed="false" visible="false" />

                    <!-- Process Designer Container -->
                    <ModuleHost fx:id="processDesignerContainer" resource="/fxml/process_designer.fxml" managed="false" visible="false" />

                    </VBox>
                </ScrollPane>
            </VBox>

                <!-- Inspector Panel (right, collapsible) -->
                <VBox fx:id="inspectorPanel" minWidth="260" styleClass="inspector-panel">

                <!-- Inspector Header -->
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="inspector-header-bar">
                    <Label styleClass="ux-inline-8eb1b6eca4" fx:id="inspectorTitleLabel" text="Inspector"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button styleClass="ux-inline-ab6e31d870" fx:id="inspectorToggleButton" text="✕" onAction="#handleToggleInspector" accessibleText="Close the Inspector panel"/>
                </HBox>

                <!-- Compact session actions; operation details already live in History. -->
                <HBox spacing="6" alignment="CENTER_LEFT" styleClass="inspector-section-header">
                    <Label fx:id="inspectorSessionTrailTitle" text="Session log" styleClass="inspector-section-title"/>
                    <Label styleClass="ux-inline-cb001c4862" fx:id="sessionTrailCountLabel" text="0"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button styleClass="ux-inline-7c4e63cc14" fx:id="inspectorAddSessionStepButton" text="Add" onAction="#handleSaveCurrentResultAsSessionStep" disable="true" accessibleText="Add the current operation to the session log"/>
                    <Button styleClass="ux-inline-7c4e63cc14" fx:id="inspectorExportSessionTrailButton" text="Export" onAction="#handleExportSessionTrail" disable="true" accessibleText="Export the session log as text"/>
                </HBox>

                <ScrollPane styleClass="ux-inline-062b25176d" fitToWidth="true" VBox.vgrow="ALWAYS">
                    <VBox spacing="0">

                        <!-- Input/Output Section -->
                        <VBox styleClass="ux-inline-e3394729d2" spacing="8">
                            <VBox spacing="2" styleClass="inspector-detail-stack">
                                <Label fx:id="inspectorInputBytesTitle" text="Input Bytes:" styleClass="inspector-label-small"/>
                                <Label fx:id="inputBytesLabel" text="0" styleClass="inspector-value"/>
                            </VBox>
                            <VBox spacing="2" styleClass="inspector-detail-stack">
                                <Label fx:id="inspectorOutputBytesTitle" text="Output Bytes:" styleClass="inspector-label-small"/>
                                <Label fx:id="outputBytesLabel" text="0" styleClass="inspector-value"/>
                            </VBox>

                            <Separator styleClass="separator-horizontal"/>

                            <VBox spacing="4">
                                <Label fx:id="inspectorAlgorithmTitle" text="Algorithm:" styleClass="inspector-label-small"/>
                                <Label styleClass="ux-inline-689e8d50bc" fx:id="operationLabel" text="No result yet"/>
                            </VBox>

                             <Separator styleClass="separator-horizontal"/>

                             <!-- Dynamic Details -->
                             <VBox fx:id="inspectorDetailsContainer" spacing="4">
                                 <!-- Details will be added here programmatically -->
                             </VBox>
                        </VBox>

                        <!-- Security Tips Section -->
                        <HBox styleClass="inspector-section-header">
                            <Label fx:id="inspectorSecurityTipsTitle" text="Security Tips" styleClass="inspector-section-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label styleClass="ux-inline-7917b6784a" text="&lt;"/>
                        </HBox>

                        <VBox styleClass="ux-inline-e3394729d2" fx:id="securityTipBox" managed="false" visible="false">
                            <VBox styleClass="warning-box" spacing="5">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label styleClass="ux-inline-496ad89056" text="⚠️"/>
                                    <Label fx:id="inspectorWarningTitle" text="Warning" styleClass="warning-title"/>
                                </HBox>
                                <Label fx:id="securityTipLabel" text="" wrapText="true" styleClass="warning-text"/>
                            </VBox>
                        </VBox>

                    </VBox>
                </ScrollPane>
                </VBox>
            </items>
        </ResponsiveWorkspaceSplitPane>
    </center>

    <!-- Status Bar -->
    <bottom>
        <HBox styleClass="status-bar" spacing="10" alignment="CENTER_LEFT" minHeight="26" prefHeight="26" maxHeight="26">
            <Label fx:id="statusLabel" text="Ready" styleClass="status-label-main"/>
            <HBox fx:id="asyncProgressBox" visible="false" managed="false" alignment="CENTER_LEFT" spacing="8" styleClass="async-progress-box">
                <ProgressIndicator fx:id="asyncProgressSpinner" prefWidth="16" prefHeight="16" styleClass="async-progress-spinner"/>
