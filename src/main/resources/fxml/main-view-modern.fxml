                <Label fx:id="asyncProgressLabel" text="Working..." styleClass="async-progress-label"/>
                <Button fx:id="asyncCancelBtn" text="Cancel" onAction="#handleCancelAsyncOperation" styleClass="async-cancel-button"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="statusVisibilityButton" text="Full visibility" onAction="#handleOpenSecurityMenu" styleClass="status-context-button"/>
            <Label fx:id="statusLanguageLabel" text="Language: System" styleClass="status-label-info"/>
        </HBox>
    </bottom>

</BorderPane>

    <!-- Command Palette Overlay -->
