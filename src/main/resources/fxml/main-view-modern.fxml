<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.TextFlow?>
<?import com.cryptocarver.ui.NavigationRail?>
<?import com.cryptocarver.ui.SidePanel?>

<BorderPane fx:id="mainPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cryptocarver.ui.ModernMainController">

    <!-- Menu Bar -->
    <top>
        <VBox>
            <MenuBar fx:id="mainMenuBar" styleClass="main-menu-bar">
                <Menu text="File">
                    <MenuItem text="Import Key..." onAction="#handleImportKey" accelerator="Ctrl+O" />
                    <SeparatorMenuItem />
                    <MenuItem text="Export Screen Configuration..." onAction="#handleExportScreenConfiguration" />
                    <MenuItem text="Import Screen Configuration..." onAction="#handleImportScreenConfiguration" />
                    <SeparatorMenuItem />
                    <MenuItem text="Save Session" onAction="#handleSaveSession" accelerator="Ctrl+S" />
                    <MenuItem text="Export History..." onAction="#handleExportHistory" />
                    <SeparatorMenuItem />
                    <MenuItem text="Exit" onAction="#handleExit" accelerator="Ctrl+Q" />
                </Menu>

                <Menu text="Edit">
                    <MenuItem text="Clear Input" onAction="#handleClearInput" accelerator="Ctrl+Shift+I" />
                    <MenuItem text="Clear Output" onAction="#handleClearOutput" accelerator="Ctrl+Shift+O" />
                    <MenuItem text="Copy Output" onAction="#handleCopyOutput" accelerator="Ctrl+C" />
                    <MenuItem text="Add Output to Clipboard Shelf" onAction="#handleAddCurrentOutputToShelf" />
                </Menu>

                <Menu text="View">
                    <MenuItem text="Toggle Side Panel" onAction="#handleToggleSidePanel" accelerator="Ctrl+B" />
                    <MenuItem text="Toggle Inspector" onAction="#handleToggleInspector" accelerator="Ctrl+I" />
                    <MenuItem text="Expand Result" onAction="#handleOpenExpandedResultViewer" accelerator="Ctrl+Shift+E" />
                    <MenuItem text="Expand Table" onAction="#handleOpenExpandedTableViewer" accelerator="Ctrl+Shift+T" />
                    <SeparatorMenuItem/>
                    <MenuItem text="Zoom In (Font)" onAction="#handleIncreaseFontSize" accelerator="Ctrl+PLUS" />
                    <MenuItem text="Zoom Out (Font)" onAction="#handleDecreaseFontSize" accelerator="Ctrl+MINUS" />
                    <SeparatorMenuItem/>
                    <MenuItem text="Reset to Defaults" onAction="#handleResetView"/>
                </Menu>

                <Menu text="Security">
                    <fx:define>
                        <ToggleGroup fx:id="visibilityProfileGroup"/>
                    </fx:define>
                    <RadioMenuItem text="Visibility: FULL_LAB (Debug/Learning)" toggleGroup="$visibilityProfileGroup" selected="true" onAction="#handleVisibilityFullLab" />
                    <RadioMenuItem text="Visibility: MASKED (Classroom/Demo)" toggleGroup="$visibilityProfileGroup" onAction="#handleVisibilityMasked" />
                    <RadioMenuItem text="Visibility: REDACTED (Strict/Production)" toggleGroup="$visibilityProfileGroup" onAction="#handleVisibilityRedacted" />
                </Menu>

                <Menu text="Tools">
                    <MenuItem text="Epoch Converter" onAction="#handleEpochConverter" accelerator="Ctrl+T"/>
                    <MenuItem text="JSON Formatter" onAction="#handleJsonFormatter" accelerator="Ctrl+J"/>
                    <MenuItem text="Byte Inspector" onAction="#handleByteInspector"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Clear Lab Key Cache" onAction="#handleClearLabKeyCache"/>
                </Menu>

                <Menu text="Help">
                    <MenuItem text="Diagnostics" onAction="#handleDiagnostics"/>
                    <MenuItem text="About" onAction="#handleAbout"/>
                </Menu>
            </MenuBar>

            <!-- Toolbar -->
            <FlowPane styleClass="main-toolbar">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Button text="Save Session" onAction="#handleSaveSession" styleClass="link-button"/>
                    <Button text="Clear" onAction="#handleClearInput" styleClass="link-button"/>
                </HBox>

                <!-- Format Flow Bar -->
                <HBox fx:id="formatFlowBar" alignment="CENTER" spacing="8" styleClass="format-flow-bar">
                    <Label text="Input:" styleClass="format-flow-label"/>
                    <ComboBox fx:id="inputFormatCombo" prefWidth="120" styleClass="format-combo"/>

                    <Label text="→" styleClass="format-flow-arrow"/>

                    <Label fx:id="contractOperationLabel" text="Operation" styleClass="format-flow-operation"/>

                    <Label text="→" styleClass="format-flow-arrow"/>

                    <Label text="Output:" styleClass="format-flow-label"/>
                    <ComboBox fx:id="outputFormatCombo" prefWidth="120" styleClass="format-combo"/>
                </HBox>

                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Button text="Expand Result" onAction="#handleOpenExpandedResultViewer" styleClass="link-button"/>
                    <Button text="Add to Shelf" onAction="#handleAddCurrentOutputToShelf" styleClass="link-button"/>
                    <Button text="Copy Output" onAction="#handleCopyOutput" styleClass="link-button"/>
                </HBox>
            </FlowPane>
        </VBox>
    </top>

    <!-- Main Content Area with Rail + SidePanel + Content + Inspector -->
    <center>
        <HBox>
            <!-- Navigation Rail (left, 48px) -->
            <NavigationRail fx:id="navigationRail"/>

            <!-- Side Panel (280px, collapsible) -->
            <SidePanel fx:id="sidePanel"/>

            <!-- Main Content Area -->
            <VBox fx:id="mainContentArea" HBox.hgrow="ALWAYS" styleClass="main-content-vbox">

                <!-- Content Header -->
                <HBox styleClass="content-header">
                    <Label fx:id="contentTitleLabel" text="Symmetric Keys" styleClass="content-title-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="contentSubtitleLabel" text="Key Derivation (KDF)" styleClass="content-subtitle-label"/>
                </HBox>

                <!-- Result Summary Bar (Compact header) -->
                <HBox fx:id="resultSummaryBar" spacing="12" alignment="CENTER_LEFT" managed="false" visible="false" styleClass="result-summary-bar">
                    <Label text="Last Result:" style="-fx-font-weight: bold; -fx-text-fill: -color-text-muted; -fx-font-size: 12px;"/>
                    <Label fx:id="resultOpLabel" text="N/A" style="-fx-font-weight: bold; -fx-text-fill: -color-primary-dark; -fx-font-size: 12px;"/>
                    <Separator orientation="VERTICAL"/>
                    <Label text="Algo:" style="-fx-text-fill: -color-text-muted; -fx-font-size: 11px;"/>
                    <Label fx:id="resultAlgoLabel" text="N/A" style="-fx-font-weight: bold; -fx-text-fill: -color-text-primary; -fx-font-size: 11px;"/>
                    <Separator orientation="VERTICAL"/>
                    <Label text="Sizes:" style="-fx-text-fill: -color-text-muted; -fx-font-size: 11px;"/>
                    <Label fx:id="resultSizeLabel" text="In: 0B / Out: 0B" style="-fx-text-fill: -color-text-primary; -fx-font-size: 11px;"/>
                    <Separator orientation="VERTICAL"/>
                    <Label text="Format:" style="-fx-text-fill: -color-text-muted; -fx-font-size: 11px;"/>
                    <Label fx:id="resultFormatLabel" text="HEX" style="-fx-text-fill: -color-text-primary; -fx-font-size: 11px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="resultStatusBadge" text="SUCCESS"
                           style="-fx-background-color: #def7ec; -fx-text-fill: #03543f; -fx-font-weight: bold; -fx-font-size: 10px; -fx-padding: 3 8; -fx-background-radius: 10;"/>
                    <HBox spacing="6" alignment="CENTER_RIGHT">
                        <Button text="Expand" onAction="#handleOpenExpandedResultViewer" styleClass="secondary-button" style="-fx-font-size: 10px; -fx-padding: 3 8;"/>
                        <Button text="Add to Shelf" onAction="#handleAddCurrentOutputToShelf" styleClass="secondary-button" style="-fx-font-size: 10px; -fx-padding: 3 8;"/>
                        <Button text="Copy" onAction="#handleCopyOutput" styleClass="action-button-primary" style="-fx-font-size: 10px; -fx-padding: 3 8;"/>
                    </HBox>
                </HBox>

                <!-- Guided Flow Panel (reusable) -->
                <HBox fx:id="guidedFlowPanel" spacing="15" alignment="CENTER_LEFT" managed="false" visible="false" styleClass="guided-flow-panel" style="-fx-background-color: #1e293b; -fx-padding: 10 15; -fx-background-radius: 8; -fx-margin: 5 0;">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="guideStepTitleLabel" text="Step 1: Choose data/input format" style="-fx-font-weight: bold; -fx-text-fill: #60a5fa; -fx-font-size: 13px;"/>
                        <Label fx:id="guideStepDescLabel" text="Configure the input source type and encoding on the format flow bar." style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;" wrapText="true"/>
                    </VBox>
                    <HBox spacing="8" alignment="CENTER_RIGHT">
                        <Button fx:id="guideBackBtn" text="Back" onAction="#handleGuideBack" styleClass="secondary-button" style="-fx-font-size: 11px; -fx-padding: 4 10;"/>
                        <Button fx:id="guideNextBtn" text="Next" onAction="#handleGuideNext" styleClass="action-button-primary" style="-fx-font-size: 11px; -fx-padding: 4 10;"/>
                        <Button text="Skip Guidance" onAction="#handleGuideSkip" styleClass="secondary-button" style="-fx-font-size: 11px; -fx-padding: 4 10;"/>
                        <Button text="Exit" onAction="#handleGuideExit" styleClass="secondary-button" style="-fx-font-size: 11px; -fx-padding: 4 10;"/>
                    </HBox>
                </HBox>

                <!-- Scrollable Content -->
                <ScrollPane fx:id="mainScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="content-scroll-pane">
                    <VBox fx:id="contentContainer" spacing="0" styleClass="content-container-vbox">

                        <!-- Quick Start Container -->
                        <VBox fx:id="quickStartContainer" managed="false" visible="false" spacing="20" style="-fx-padding: 20;">
                            <VBox spacing="5">
                                <Label text="Laboratory Quick Start" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: -color-primary-dark;"/>
                                <Label text="Choose a guided workflow to easily configure standard cryptographic and data operations." style="-fx-text-fill: -color-text-muted; -fx-font-size: 13px;"/>
                            </VBox>

                            <GridPane hgap="15" vgap="15">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50"/>
                                    <ColumnConstraints percentWidth="50"/>
                                </columnConstraints>

                                <!-- Card 1: Encrypt a message -->
                                <VBox styleClass="form-group-box" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="🔒 Encrypt a message" styleClass="form-group-title"/>
                                    <Label text="Secure data using symmetric keys (e.g. AES-256)." styleClass="helper-text" wrapText="true"/>
                                    <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding: 5 0 0 0;">
                                        <Label text="Sensitivity:" style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
                                        <Label text="Medium (Key Material / Secrets)" style="-fx-text-fill: #b54708; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                    </HBox>
                                    <Region VBox.vgrow="ALWAYS" style="-fx-min-height: 10px;"/>
                                    <Button text="Start guided flow" onAction="#handleStartGuidedEncrypt" styleClass="action-button-primary" style="-fx-font-size: 12px;"/>
                                </VBox>

                                <!-- Card 2: Calculate a hash -->
                                <VBox styleClass="form-group-box" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="🔐 Calculate a hash" styleClass="form-group-title"/>
                                    <Label text="Generate a secure one-way hash (e.g. SHA-256)." styleClass="helper-text" wrapText="true"/>
                                    <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding: 5 0 0 0;">
                                        <Label text="Sensitivity:" style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
                                        <Label text="Low (No secrets involved)" style="-fx-text-fill: #027a48; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                    </HBox>
                                    <Region VBox.vgrow="ALWAYS" style="-fx-min-height: 10px;"/>
                                    <Button text="Start guided flow" onAction="#handleStartGuidedHash" styleClass="action-button-primary" style="-fx-font-size: 12px;"/>
                                </VBox>

                                <!-- Card 3: Sign or verify data -->
                                <VBox styleClass="form-group-box" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <Label text="🖋 Sign or verify data" styleClass="form-group-title"/>
                                    <Label text="Generate asymmetric signatures or verify authenticity." styleClass="helper-text" wrapText="true"/>
                                    <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding: 5 0 0 0;">
                                        <Label text="Sensitivity:" style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
                                        <Label text="High (Private signing keys)" style="-fx-text-fill: #b42318; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                    </HBox>
                                    <Region VBox.vgrow="ALWAYS" style="-fx-min-height: 10px;"/>
                                    <Button text="Start guided flow" onAction="#handleStartGuidedSign" styleClass="action-button-primary" style="-fx-font-size: 12px;"/>
                                </VBox>

                                <!-- Card 4: Inspect a certificate -->
                                <VBox styleClass="form-group-box" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <Label text="🔍 Inspect a certificate" styleClass="form-group-title"/>
                                    <Label text="Parse and validate public X.509 certificates." styleClass="helper-text" wrapText="true"/>
                                    <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding: 5 0 0 0;">
                                        <Label text="Sensitivity:" style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
                                        <Label text="Low (Public data only)" style="-fx-text-fill: #027a48; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                    </HBox>
                                    <Region VBox.vgrow="ALWAYS" style="-fx-min-height: 10px;"/>
                                    <Button text="Start guided flow" onAction="#handleStartGuidedCert" styleClass="action-button-primary" style="-fx-font-size: 12px;"/>
                                </VBox>

                                <!-- Card 5: Convert encodings -->
                                <VBox styleClass="form-group-box" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                    <Label text="🔄 Convert encodings" styleClass="form-group-title"/>
                                    <Label text="Transform data formats (Base64, Hex, EBCDIC, etc.)." styleClass="helper-text" wrapText="true"/>
                                    <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding: 5 0 0 0;">
                                        <Label text="Sensitivity:" style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
                                        <Label text="Low (No secrets)" style="-fx-text-fill: #027a48; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                    </HBox>
                                    <Region VBox.vgrow="ALWAYS" style="-fx-min-height: 10px;"/>
                                    <Button text="Start guided flow" onAction="#handleStartGuidedConvert" styleClass="action-button-primary" style="-fx-font-size: 12px;"/>
                                </VBox>
                            </GridPane>
                        </VBox>

                        <!-- PLACEHOLDER - Real content will be loaded dynamically -->
                        <Label fx:id="contentPlaceholderLabel" text="Select an operation from the side panel"
                               styleClass="placeholder-label"/>

                        <!-- This is where Symmetric Keys Accordion will be loaded -->
                        <!-- Saved Sessions Container -->
                        <!-- JOSE CONTAINER -->                        <fx:include fx:id="jose" source="jose.fxml"/>


                        <VBox fx:id="savedSessionsContainer" managed="false" visible="false" spacing="15" style="-fx-padding: 20;">
                            <!-- Header -->
                            <VBox spacing="5">
                                <Label text="Saved Sessions" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #e2e8f0;"/>
                                <Label text="Restore your previous work sessions." style="-fx-text-fill: #a0aec0; -fx-font-size: 13px;"/>
                            </VBox>

                            <!-- Sessions List -->
                            <VBox fx:id="savedSessionsList" spacing="10"/>
                        </VBox>

                        <!-- Keys Container -->
                        <fx:include fx:id="keysContainer" source="keys.fxml"/>

                        <!-- Certificates Operations -->
                        <fx:include fx:id="certificatesContainer" source="certificates.fxml"/>

                        <!-- CIPHER CONTENT -->
                        <fx:include fx:id="cipherContainer" source="cipher.fxml"/>

                        <!-- Authentication Container -->
                        <fx:include fx:id="authenticationContainer" source="authentication.fxml"/>

                        <!-- Payments Container -->
                        <fx:include fx:id="paymentsContainer" source="payments.fxml"/>

                        <!-- EMV Container -->
                        <fx:include fx:id="emvContainer" source="emv.fxml"/>

                        <!-- Generic Utilities Container -->
                        <!-- GENERIC CONTENT (Hashing, Encoding, etc) -->
                <fx:include fx:id="genericContainer" source="generic.fxml" />

                    <!-- Recent Operations / History -->
                    <fx:include fx:id="historyView" source="history.fxml" />
                    <fx:include fx:id="clipboardShelf" source="clipboard_shelf.fxml" />

                    <!-- Post-Quantum Cryptography Container -->
                    <fx:include source="pqc.fxml" fx:id="postQuantumContainer" />

                    <!-- XML Security Container -->
                    <fx:include source="xml_security.fxml" fx:id="xmlSecurityContainer" />

                    <!-- WSS Security Container -->
                    <fx:include source="wss_security.fxml" fx:id="wssSecurityContainer" />

                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- Inspector Panel (right, collapsible) -->
            <VBox fx:id="inspectorPanel" minWidth="280" maxWidth="280" styleClass="inspector-panel">

                <!-- Inspector Header -->
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="inspector-header-bar">
                    <Label text="Inspector" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="✕" onAction="#handleToggleInspector" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;"/>
                </HBox>

                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent;">
                    <VBox spacing="0">

                        <!-- Input/Output Section -->
                        <VBox spacing="8" style="-fx-padding: 12;">
                            <GridPane hgap="10" vgap="5">
                                <Label text="Input Bytes:" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="inspector-label-small"/>
                                <Label fx:id="inputBytesLabel" text="0" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="inspector-value"/>

                                <Label text="Output Bytes:" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="inspector-label-small"/>
                                <Label fx:id="outputBytesLabel" text="32" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="inspector-value"/>

                                <columnConstraints>
                                    <ColumnConstraints minWidth="100"/>
                                    <ColumnConstraints hgrow="ALWAYS" halignment="RIGHT"/>
                                </columnConstraints>
                            </GridPane>

                            <Separator styleClass="separator-horizontal"/>

                            <VBox spacing="4">
                                <Label text="Algorithm:" styleClass="inspector-label-small"/>
                                <Label fx:id="operationLabel" text="HKDF-SHA256" style="-fx-font-weight: bold;"/>
                            </VBox>

                             <Separator styleClass="separator-horizontal"/>

                             <!-- Dynamic Details -->
                             <VBox fx:id="inspectorDetailsContainer" spacing="4">
                                 <!-- Details will be added here programmatically -->
                             </VBox>
                        </VBox>

                        <!-- Security Tips Section -->
                        <HBox styleClass="inspector-section-header">
                            <Label text="Security Tips" styleClass="inspector-section-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="&lt;" style="-fx-text-fill: white; -fx-font-size: 10px;"/>
                        </HBox>

                        <VBox style="-fx-padding: 12;">
                            <VBox styleClass="warning-box" spacing="5">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="⚠️" style="-fx-font-size: 16px;"/>
                                    <Label text="Warning" styleClass="warning-title"/>
                                </HBox>
                                <Label fx:id="securityTipLabel" text="No salt provided, HKDF is less secure! Consider using a random salt."
                                       wrapText="true" styleClass="warning-text"/>
                            </VBox>
                        </VBox>

                        <!-- History Section -->
                        <HBox styleClass="inspector-section-header">
                            <Label text="History" styleClass="inspector-section-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Export JSON" onAction="#handleExportHistory" style="-fx-font-size: 10px; -fx-padding: 2 6; -fx-background-color: transparent; -fx-text-fill: #81c784; -fx-cursor: hand;">
                                <tooltip><Tooltip text="Export the complete operation history as JSON"/></tooltip>
                            </Button>
                            <Button text="Clear" onAction="#handleClearHistory" style="-fx-font-size: 10px; -fx-padding: 2 6; -fx-background-color: transparent; -fx-text-fill: #90caf9; -fx-cursor: hand;"/>
                        </HBox>

                        <VBox fx:id="historyContainer" spacing="4" style="-fx-padding: 8;">
                            <!-- Example Items -->
                            <HBox styleClass="history-item" spacing="8" alignment="CENTER_LEFT">
                                <Label text="🕒"/>
                                <VBox>
                                    <Label text="HKDF SHA256 32B" style="-fx-font-weight: bold; -fx-font-size: 11px;"/>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Reopen" style="-fx-font-size: 10px; -fx-padding: 2 6;"/>
                            </HBox>

                            <HBox styleClass="history-item" spacing="8" alignment="CENTER_LEFT">
                                <Label text="🕒"/>
                                <VBox>
                                    <Label text="AES-GCM Encrypt" style="-fx-font-weight: bold; -fx-font-size: 11px;"/>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Rerun" style="-fx-font-size: 10px; -fx-padding: 2 6;"/>
                            </HBox>
                        </VBox>

                    </VBox>
                </ScrollPane>
            </VBox>

        </HBox>
    </center>

    <!-- Status Bar -->
    <bottom>
        <HBox styleClass="status-bar" spacing="10">
            <Label fx:id="statusLabel" text="Ready" styleClass="status-label-main"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Java 21 | JavaFX 21 | BouncyCastle" styleClass="status-label-info"/>
        </HBox>
    </bottom>

</BorderPane>
