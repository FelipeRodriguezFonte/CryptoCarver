<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cryptocarver.ui.AsicController" spacing="10" styleClass="content-container-vbox">
    <Accordion styleClass="module-accordion">
        <panes>
            <TitledPane text="ASiC Containers" expanded="true">
                <VBox spacing="12" styleClass="module-pane-content">
                    <Label text="ASiC-S laboratory — one payload plus detached CAdES-BES signature" styleClass="helper-text"/>
                    <Label text="Creates a bounded ASiC-S ZIP container. Inspection checks the mimetype and detached signature; it does not establish certificate trust, revocation or LTV." wrapText="true" styleClass="helper-text" style="-fx-text-fill: #9a3412;"/>

                    <GridPane hgap="10" vgap="9" styleClass="form-grid">
                        <columnConstraints>
                            <ColumnConstraints minWidth="120" prefWidth="120"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Input File:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                        <HBox spacing="10" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <TextField fx:id="asicInputPathField" promptText="Payload file or ASiC-S container path" HBox.hgrow="ALWAYS" styleClass="form-field"/>
                            <Button text="Choose input…" onAction="#handleChooseInput" styleClass="secondary-button"/>
                        </HBox>

                        <Label text="Output File:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                        <HBox spacing="10" GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <TextField fx:id="asicOutputPathField" promptText="New .asics output path (for create)" HBox.hgrow="ALWAYS" styleClass="form-field"/>
                            <Button text="Choose output…" onAction="#handleChooseOutput" styleClass="secondary-button"/>
                        </HBox>
                    </GridPane>

                    <Label text="Signing Key Source:" styleClass="form-label"/>
                    <HBox spacing="12">
                        <RadioButton fx:id="asicSourceLocalRadio" text="Local PKCS#12" selected="true" onAction="#handleSourceChanged">
                            <toggleGroup><ToggleGroup fx:id="asicSourceToggleGroup"/></toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="asicSourcePkcs11Radio" text="PKCS#11 Token" toggleGroup="$asicSourceToggleGroup" onAction="#handleSourceChanged"/>
                    </HBox>

                    <HBox fx:id="asicLocalKeyBox" spacing="10">
                        <TextField fx:id="asicPkcs12PathField" promptText="PKCS#12 signing key (for create)" HBox.hgrow="ALWAYS" styleClass="form-field"/>
                        <Button text="Choose key…" onAction="#handleChoosePkcs12" styleClass="secondary-button"/>
                        <PasswordField fx:id="asicPasswordField" promptText="PKCS#12 password" prefWidth="180" styleClass="form-field"/>
                    </HBox>

                    <HBox fx:id="asicPkcs11Box" spacing="10" visible="false" managed="false">
                        <ComboBox fx:id="asicPkcs11AliasCombo" promptText="Token signing alias" HBox.hgrow="ALWAYS" styleClass="form-field"/>
                        <Button text="Load Token Keys" onAction="#handleLoadTokenKeys" styleClass="secondary-button"/>
                    </HBox>

                    <HBox spacing="12">
                        <Button text="Create ASiC-S" onAction="#handleCreate" styleClass="action-button,primary-action"/>
                        <Button text="Inspect / Verify" onAction="#handleInspect" styleClass="secondary-button"/>
                    </HBox>

                    <Separator/>

                    <Label text="Experimental ASiC-E / CAdES — multiple payloads plus a SHA-256 manifest" wrapText="true" styleClass="form-label" style="-fx-text-fill: #9a3412;"/>

                    <HBox spacing="10">
                        <TextField fx:id="asicEPayloadsField" editable="false" promptText="No ASiC-E payload files selected" HBox.hgrow="ALWAYS" styleClass="form-field"/>
                        <Button text="Choose payloads…" onAction="#handleChooseAsicEPayloads" styleClass="secondary-button"/>
                        <Button text="Create ASiC-E" onAction="#handleCreateE" styleClass="action-button"/>
                    </HBox>

                    <HBox spacing="10">
                        <TextField fx:id="asicTrustStorePathField" promptText="Optional local truststore (.p12/.pfx or .jks)" HBox.hgrow="ALWAYS" styleClass="form-field"/>
                        <Button text="Choose truststore…" onAction="#handleChooseTrustStore" styleClass="secondary-button"/>
                        <PasswordField fx:id="asicTrustStorePasswordField" promptText="Truststore password" prefWidth="160" styleClass="form-field"/>
                    </HBox>

                    <TextArea fx:id="asicResultArea" editable="false" prefRowCount="6" wrapText="true" styleClass="result-area,monospace-field" promptText="ASiC result will appear here..."/>
                </VBox>
            </TitledPane>
        </panes>
    </Accordion>
</VBox>
