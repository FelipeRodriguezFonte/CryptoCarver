                                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                                        <Label styleClass="ux-inline-67f73931d9" text="K:" />
                                        <TextField fx:id="authMacKeyK" promptText="First 8 bytes (hex)" />
                                    </VBox>
                                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                                        <Label styleClass="ux-inline-67f73931d9" text="K':" />
                                        <TextField fx:id="authMacKeyKPrime" promptText="Second 8 bytes (hex)" />
                                    </VBox>
                                </HBox>
                                <Label styleClass="ux-inline-4148c7206f" text="Leave empty to use MAC Key field above. If filled, K||K' will be concatenated automatically."/>
                            </VBox>

                            <Separator styleClass="ux-inline-94e215a536" />

                            <Label styleClass="ux-inline-0ed0fa4650" text="Truncation:" />
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <ComboBox fx:id="authMacTruncationCombo" prefWidth="100" />
                                <Label styleClass="ux-inline-39414733db" text="bytes (0 = full MAC)"/>
                            </HBox>

                            <Separator styleClass="ux-inline-94e215a536" />

                            <Button text="Generate MAC" maxWidth="Infinity" styleClass="action-button" onAction="#handleGenerateMAC" />

                            <Separator styleClass="ux-inline-94e215a536" />

                            <Label styleClass="ux-inline-0ed0fa4650" text="Verification:" />
                            <Label styleClass="ux-inline-ab4da656fa" text="MAC value (paste here for verification):"/>
                            <TextField fx:id="authMacVerifyField" promptText="Paste MAC here (format: toolbar Output Format)" />

                            <Button text="Verify MAC" maxWidth="Infinity" styleClass="action-button" onAction="#handleVerifyMAC" />

                            <Separator styleClass="ux-inline-94e215a536" />

                            <Label styleClass="ux-inline-e1524613e9" text="ℹ️  Generate: data in Input → MAC in Output"/>
                            <Label styleClass="ux-inline-e1524613e9" text="ℹ️  Verify: MAC above, data in Input → result popup"/>
