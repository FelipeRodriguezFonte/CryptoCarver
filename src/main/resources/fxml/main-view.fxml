<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="mainPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cryptocarver.ui.MainController">

    <!-- Menu Bar -->
    <top>
        <VBox>
            <MenuBar styleClass="main-menu-bar">
                <Menu text="File">
                    <MenuItem text="New" accelerator="Ctrl+N" />
                    <MenuItem text="Open..." accelerator="Ctrl+O" />
                    <MenuItem text="Save..." accelerator="Ctrl+S" />
                    <SeparatorMenuItem />
                    <MenuItem text="Exit" onAction="#handleExit" accelerator="Ctrl+Q" />
                </Menu>

                <Menu text="Edit">
                    <MenuItem text="Clear Input" onAction="#handleClearInput" accelerator="Ctrl+Shift+I" />
                    <MenuItem text="Clear Output" onAction="#handleClearOutput" accelerator="Ctrl+Shift+O" />
                    <MenuItem text="Copy Output" onAction="#handleCopyOutput" accelerator="Ctrl+C" />
                </Menu>

                <Menu text="View">
                    <Menu text="Theme">
                        <RadioMenuItem fx:id="themeLightItem" text="Light (Default)" selected="true" onAction="#handleThemeLight"/>
                        <RadioMenuItem fx:id="themeDarkItem" text="Dark" onAction="#handleThemeDark"/>
                        <RadioMenuItem fx:id="themeHighContrastItem" text="High Contrast" onAction="#handleThemeHighContrast"/>
                        <RadioMenuItem fx:id="themeSolarizedItem" text="Solarized Dark" onAction="#handleThemeSolarized"/>
                        <RadioMenuItem fx:id="themeDraculaItem" text="Dracula" onAction="#handleThemeDracula"/>
                    </Menu>
                    <Menu text="Font Size">
                        <RadioMenuItem fx:id="fontSmallItem" text="Small (11px)" onAction="#handleFontSmall">
                            <toggleGroup>
                                <ToggleGroup fx:id="fontSizeToggleGroup"/>
                            </toggleGroup>
                        </RadioMenuItem>
                        <RadioMenuItem fx:id="fontMediumItem" text="Medium (13px)" selected="true" onAction="#handleFontMedium" toggleGroup="$fontSizeToggleGroup"/>
                        <RadioMenuItem fx:id="fontLargeItem" text="Large (15px)" onAction="#handleFontLarge" toggleGroup="$fontSizeToggleGroup"/>
                        <RadioMenuItem fx:id="fontExtraLargeItem" text="Extra Large (18px)" onAction="#handleFontExtraLarge" toggleGroup="$fontSizeToggleGroup"/>
                    </Menu>
                    <SeparatorMenuItem/>
                    <MenuItem text="Reset to Defaults" onAction="#handleResetView"/>
                </Menu>

                <Menu text="Tools">
                    <MenuItem text="KeyStore Manager..." />
                    <MenuItem text="Import Key..." />
                    <MenuItem text="Export Key..." />
                    <SeparatorMenuItem />
                    <MenuItem text="Preferences..." />
                </Menu>

                <Menu text="Help">
                    <MenuItem text="Documentation" />
                    <MenuItem text="Cipher Reference" />
                    <SeparatorMenuItem />
                    <MenuItem text="About" onAction="#handleAbout" />
                </Menu>
            </MenuBar>

            <!-- Toolbar -->
            <ToolBar>
                <Button text="Clear" onAction="#handleClearInput" />
                <Separator orientation="VERTICAL" />
                <Label text="Input Format:" />
                <ComboBox fx:id="inputFormatCombo" prefWidth="120" />
                <Separator orientation="VERTICAL" />
                <Label text="Output Format:" />
                <ComboBox fx:id="outputFormatCombo" prefWidth="120" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="Copy Output" onAction="#handleCopyOutput" />
            </ToolBar>
        </VBox>
    </top>

    <!-- Main Content -->
    <center>
        <StackPane fx:id="centerStack">

            <!-- Generic/Cipher Content (Input/Output) -->
            <SplitPane fx:id="genericCenterPane" dividerPositions="0.7" orientation="VERTICAL">

                <!-- Input Section -->
                <VBox spacing="5">
                    <padding>
                        <Insets top="10" right="10" bottom="5" left="10" />
                    </padding>
                    <Label styleClass="ux-inline-99c054f9a3" text="Input Data" />
                    <TextArea fx:id="inputArea" VBox.vgrow="ALWAYS" wrapText="true" />
                </VBox>

                <!-- Output Section -->
                <VBox spacing="5">
                    <padding>
                        <Insets top="5" right="10" bottom="10" left="10" />
                    </padding>
                    <Label styleClass="ux-inline-99c054f9a3" text="Output" />
                    <TextArea fx:id="outputArea" VBox.vgrow="ALWAYS" wrapText="true" editable="false" />
                </VBox>

            </SplitPane>

            <!-- Keys Tab Content (Own Layout) -->
            <!-- Keys Tab Content (TabPane for different key types) -->
            <TabPane fx:id="keysCenterPane" tabClosingPolicy="UNAVAILABLE" visible="false" managed="false">

                <!-- Symmetric Keys Tab - REDESIGNED WITH ACCORDION -->
                <Tab text="Symmetric Keys" closable="false">
                    <ScrollPane fitToWidth="true" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER">
                        <VBox styleClass="ux-inline-1684f00703" spacing="5" prefWidth="1200">

                            <Accordion>
                                <panes>
                                    <!-- KEY GENERATION -->
                                    <TitledPane text="🔑 Key Generation" expanded="true">
                                    <VBox styleClass="ux-inline-66ce195191" spacing="4">
                                        <GridPane hgap="6" vgap="4">
                                            <columnConstraints>
                                                <ColumnConstraints minWidth="70" prefWidth="70"/>
                                                <ColumnConstraints minWidth="180" prefWidth="220"/>
                                                <ColumnConstraints hgrow="ALWAYS"/>
                                            </columnConstraints>

                                            <Label styleClass="ux-inline-ba9ea6419e" text="Type:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                            <ComboBox styleClass="ux-inline-ba9ea6419e" fx:id="keyTypeCombo" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="200"/>

                                            <CheckBox styleClass="ux-inline-ab4da656fa" fx:id="forceOddParityCheck" text="Force Odd Parity (DES/3DES)"
                                                      selected="true" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                                        </GridPane>

                                        <Button text="Generate Key" onAction="#handleGenerateKey"
                                                styleClass="action-button ux-inline-ba9ea6419e" maxWidth="150"/>

                                        <!-- LARGE result area to fill space -->
                                        <TextArea styleClass="ux-inline-ea21460dc9" fx:id="generatedKeyField" prefHeight="280" editable="false" wrapText="true"
                                                  promptText="Generated key will appear here..."/>
                                    </VBox>
                                </TitledPane>

                                <!-- KEY VALIDATION -->
                                <TitledPane text="✓ Validation &amp; KCV">
                                    <VBox styleClass="ux-inline-66ce195191" spacing="4">
                                        <!-- Input como TextField (1 línea) -->
                                        <TextField styleClass="ux-inline-ea21460dc9" fx:id="keyInputField" promptText="Enter key in hexadecimal..."/>

                                        <Button text="Validate &amp; Calculate KCVs" onAction="#handleValidateKey"
                                                styleClass="action-button ux-inline-ba9ea6419e" maxWidth="180"/>

                                        <!-- LARGE result area -->
                                        <TextArea styleClass="ux-inline-ea21460dc9" fx:id="validationResultArea" prefHeight="260" editable="false" wrapText="true"
                                                  promptText="Validation results will appear here..."
                                                  managed="false" visible="false"/>
                                    </VBox>
                                </TitledPane>

                                <!-- KEY SHARING -->
                                <TitledPane text="🔀 Key Sharing (XOR Split/Combine)">
                                    <VBox styleClass="ux-inline-1684f00703" spacing="6">
                                        <TabPane tabClosingPolicy="UNAVAILABLE">
                                            <Tab text="Split Key">
                                                <VBox styleClass="ux-inline-1684f00703" spacing="6">
                                                    <TextArea styleClass="ux-inline-00bdf36a65" fx:id="keyToSplitField" prefHeight="35" wrapText="true"
                                                              promptText="Enter key to split..."/>

                                                    <HBox spacing="8" alignment="CENTER_LEFT">
                                                        <Label text="Parts:"/>
                                                        <ComboBox fx:id="numComponentsCombo" prefWidth="80"/>
                                                        <Button text="Split Key" onAction="#handleSplitKey"
                                                                styleClass="action-button"/>
                                                    </HBox>
                                                </VBox>
                                            </Tab>

                                            <Tab text="Combine Components">
                                                <VBox styleClass="ux-inline-1684f00703" spacing="6">
                                                    <GridPane hgap="8" vgap="4">
                                                        <columnConstraints>
                                                            <ColumnConstraints minWidth="90" prefWidth="90"/>
                                                            <ColumnConstraints hgrow="ALWAYS"/>
                                                        </columnConstraints>

                                                        <Label text="Component 1:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                                        <TextField styleClass="ux-inline-ea21460dc9" fx:id="component1Field" promptText="Required"
                                                                  GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                                        <Label text="Component 2:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                                        <TextField styleClass="ux-inline-ea21460dc9" fx:id="component2Field" promptText="Required"
                                                                  GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                                        <Label text="Component 3:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                                        <TextField styleClass="ux-inline-ea21460dc9" fx:id="component3Field" promptText="Optional"
                                                                  GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                                        <Label text="Component 4:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                                        <TextField styleClass="ux-inline-ea21460dc9" fx:id="component4Field" promptText="Optional"
                                                                  GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                                                        <Label text="Component 5:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                                                        <TextField styleClass="ux-inline-ea21460dc9" fx:id="component5Field" promptText="Optional"
                                                                  GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                                                    </GridPane>

                                                    <Button text="Combine Components" onAction="#handleCombineComponents"
                                                            styleClass="action-button" maxWidth="200"/>
                                                </VBox>
                                            </Tab>
                                        </TabPane>

                                        <TextArea styleClass="ux-inline-00bdf36a65" fx:id="componentResultsArea" prefHeight="100" editable="false" wrapText="true"
                                                  promptText="Results will appear here..."
                                                  managed="false" visible="false"/>
                                    </VBox>
                                </TitledPane>

                                <!-- KEY DERIVATION -->
                                <TitledPane text="🔐 Key Derivation (KDF)">
                                    <VBox styleClass="ux-inline-66ce195191" spacing="4">
                                        <!-- Compact controls in GridPane -->
                                        <GridPane hgap="6" vgap="4">
                                            <columnConstraints>
                                                <ColumnConstraints minWidth="90" prefWidth="90"/>
                                                <ColumnConstraints minWidth="140" prefWidth="160"/>
                                                <ColumnConstraints minWidth="70" prefWidth="75"/>
                                                <ColumnConstraints hgrow="ALWAYS"/>
                                            </columnConstraints>

                                            <Label styleClass="ux-inline-ba9ea6419e" text="Algorithm:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                            <ComboBox styleClass="ux-inline-ba9ea6419e" fx:id="kdfAlgorithmCombo" GridPane.rowIndex="0" GridPane.columnIndex="1"
                                                     GridPane.columnSpan="3" prefWidth="180"/>

                                            <Label styleClass="ux-inline-ba9ea6419e" text="Input Format:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                            <ComboBox styleClass="ux-inline-ba9ea6419e" fx:id="kdfInputFormatCombo" GridPane.rowIndex="1" GridPane.columnIndex="1"
                                                     prefWidth="90"/>

                                            <Label styleClass="ux-inline-ba9ea6419e" text="Iterations:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                                            <TextField styleClass="ux-inline-ba9ea6419e" fx:id="kdfIterationsField" text="10000" GridPane.rowIndex="1" GridPane.columnIndex="3"
                                                      prefWidth="60"/>

                                            <Label styleClass="ux-inline-ba9ea6419e" text="Output:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                            <HBox spacing="3" GridPane.rowIndex="2" GridPane.columnIndex="1">
                                                <TextField styleClass="ux-inline-ba9ea6419e" fx:id="kdfOutputLengthField" text="32" prefWidth="50"/>
                                                <Label styleClass="ux-inline-ab4da656fa" text="bytes"/>
                                            </HBox>
                                        </GridPane>

                                        <!-- Input material - small -->
                                        <TextField styleClass="ux-inline-ea21460dc9" fx:id="kdfInputField" promptText="Input key material..."/>

                                        <!-- Salt and Info in HBox -->
                                        <HBox spacing="4">
                                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                                <HBox spacing="3" alignment="CENTER_LEFT">
                                                    <Label styleClass="ux-inline-ab4da656fa" text="Salt:"/>
                                                    <ComboBox styleClass="ux-inline-ab4da656fa" fx:id="kdfSaltFormatCombo" prefWidth="70"/>
                                                </HBox>
                                                <TextField styleClass="ux-inline-ab4da656fa" fx:id="kdfSaltField" promptText="Optional"/>
                                            </VBox>

                                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                                <HBox spacing="3" alignment="CENTER_LEFT">
                                                    <Label styleClass="ux-inline-ab4da656fa" text="Info:"/>
                                                    <ComboBox styleClass="ux-inline-ab4da656fa" fx:id="kdfInfoFormatCombo" prefWidth="70"/>
                                                </HBox>
                                                <TextField styleClass="ux-inline-ab4da656fa" fx:id="kdfInfoField" promptText="HKDF only"/>
                                            </VBox>
                                        </HBox>

                                        <Button text="Derive Key" onAction="#handleDeriveKey"
                                                styleClass="action-button ux-inline-ba9ea6419e" maxWidth="150"/>

                                        <!-- LARGE result area to fill available space -->
                                        <TextArea styleClass="ux-inline-ea21460dc9" fx:id="kdfResultArea" prefHeight="250" editable="false" wrapText="true"
                                                  promptText="Derived key will appear here..."
                                                  managed="false" visible="false"/>
                                    </VBox>
                                </TitledPane>
                                </panes>
                            </Accordion>

                        </VBox>
                    </ScrollPane>
                </Tab>

                <!-- RSA Tab -->
                <Tab text="RSA" closable="false">
                    <ScrollPane fitToWidth="true">
                        <VBox styleClass="ux-inline-8d20c1fddd" spacing="15">
                            <Label styleClass="ux-inline-b0efc8b395" text="RSA Key Generation"/>

                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Key Size:"/>
                                <ComboBox fx:id="rsaKeySizeCombo" prefWidth="120"/>
                                <Button styleClass="ux-inline-1f5cdbf1b1" text="Generate RSA Key Pair" onAction="#handleGenerateRSA"/>
                            </HBox>

                            <Separator/>

                            <SplitPane dividerPositions="0.5" VBox.vgrow="ALWAYS" orientation="HORIZONTAL">
                                <VBox spacing="5">
                                    <Label styleClass="ux-inline-689e8d50bc" text="Public Key"/>
                                    <TextArea styleClass="ux-inline-ea21460dc9" fx:id="rsaPublicKeyArea" wrapText="true" editable="false"
                                              VBox.vgrow="ALWAYS" prefHeight="500"/>
                                </VBox>
                                <VBox spacing="5">
                                    <Label styleClass="ux-inline-689e8d50bc" text="Private Key"/>
                                    <TextArea styleClass="ux-inline-ea21460dc9" fx:id="rsaPrivateKeyArea" wrapText="true" editable="false"
                                              VBox.vgrow="ALWAYS" prefHeight="500"/>
                                </VBox>
                            </SplitPane>

                            <Label text="⚠️  RSA keys > 4096 bits may take several seconds to generate"
                                   styleClass="ux-inline-4821211dc5"/>
                        </VBox>
                    </ScrollPane>
                </Tab>

                <!-- DSA Tab -->
                <Tab text="DSA" closable="false">
                    <ScrollPane fitToWidth="true">
                        <VBox styleClass="ux-inline-8d20c1fddd" spacing="15">
                            <Label styleClass="ux-inline-b0efc8b395" text="DSA Key Generation"/>

                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Key Size (L/N):"/>
                                <ComboBox fx:id="dsaKeySizeCombo" prefWidth="120"/>
                                <Button styleClass="ux-inline-1f5cdbf1b1" text="Generate DSA Key Pair" onAction="#handleGenerateDSA"/>
                            </HBox>

                            <Separator/>

                            <SplitPane dividerPositions="0.5" VBox.vgrow="ALWAYS" orientation="HORIZONTAL">
                                <VBox spacing="5">
                                    <Label styleClass="ux-inline-689e8d50bc" text="Public Key"/>
                                    <TextArea styleClass="ux-inline-ea21460dc9" fx:id="dsaPublicKeyArea" wrapText="true" editable="false"
                                              VBox.vgrow="ALWAYS" prefHeight="500"/>
                                </VBox>
                                <VBox spacing="5">
                                    <Label styleClass="ux-inline-689e8d50bc" text="Private Key"/>
                                    <TextArea styleClass="ux-inline-ea21460dc9" fx:id="dsaPrivateKeyArea" wrapText="true" editable="false"
                                              VBox.vgrow="ALWAYS" prefHeight="500"/>
                                </VBox>
                            </SplitPane>
                        </VBox>
                    </ScrollPane>
                </Tab>

                <!-- ECDSA F(p) Tab -->
                <Tab text="ECDSA F(p)" closable="false">
                    <ScrollPane fitToWidth="true">
                        <VBox styleClass="ux-inline-8d20c1fddd" spacing="15">
                            <Label styleClass="ux-inline-b0efc8b395" text="ECDSA F(p) - Elliptic Curve over Prime Field"/>

                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Named Curve:"/>
                                <ComboBox fx:id="ecdsaFpCurveCombo" prefWidth="150"/>
                                <Button styleClass="ux-inline-1f5cdbf1b1" text="Generate ECDSA F(p) Key Pair" onAction="#handleGenerateECDSAFp"/>
                            </HBox>

                            <Separator/>

                            <SplitPane dividerPositions="0.5" VBox.vgrow="ALWAYS" orientation="HORIZONTAL">
                                <VBox spacing="5">
                                    <Label styleClass="ux-inline-689e8d50bc" text="Public Key"/>
                                    <TextArea styleClass="ux-inline-ea21460dc9" fx:id="ecdsaFpPublicKeyArea" wrapText="true" editable="false"
                                              VBox.vgrow="ALWAYS" prefHeight="500"/>
                                </VBox>
                                <VBox spacing="5">
                                    <Label styleClass="ux-inline-689e8d50bc" text="Private Key"/>
                                    <TextArea styleClass="ux-inline-ea21460dc9" fx:id="ecdsaFpPrivateKeyArea" wrapText="true" editable="false"
                                              VBox.vgrow="ALWAYS" prefHeight="500"/>
                                </VBox>
                            </SplitPane>
                        </VBox>
                    </ScrollPane>
                </Tab>

                <!-- Ed25519 Tab -->
                <Tab text="Ed25519" closable="false">
                    <ScrollPane fitToWidth="true">
                        <VBox styleClass="ux-inline-8d20c1fddd" spacing="15">
                            <Label styleClass="ux-inline-b0efc8b395" text="Ed25519 - Modern Elliptic Curve Signature"/>

                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Ed25519 (255-bit curve, fast signatures)"/>
                                <Button styleClass="ux-inline-40ff3e0e66" text="Generate Ed25519 Key Pair" onAction="#handleGenerateEd25519"/>
                            </HBox>

                            <Separator/>

                            <SplitPane dividerPositions="0.5" VBox.vgrow="ALWAYS" orientation="HORIZONTAL">
                                <VBox spacing="5">
                                    <Label styleClass="ux-inline-689e8d50bc" text="Public Key"/>
                                    <TextArea styleClass="ux-inline-ea21460dc9" fx:id="ed25519PublicKeyArea" wrapText="true" editable="false"
                                              VBox.vgrow="ALWAYS" prefHeight="500"/>
                                </VBox>
                                <VBox spacing="5">
                                    <Label styleClass="ux-inline-689e8d50bc" text="Private Key"/>
                                    <TextArea styleClass="ux-inline-ea21460dc9" fx:id="ed25519PrivateKeyArea" wrapText="true" editable="false"
                                              VBox.vgrow="ALWAYS" prefHeight="500"/>
                                </VBox>
                            </SplitPane>
                        </VBox>
                    </ScrollPane>
                </Tab>


                <!-- Certificates Tab -->
                <Tab text="Certificates" closable="false">
                    <ScrollPane fitToWidth="true">
                        <VBox styleClass="ux-inline-8d20c1fddd" spacing="15">
                            <Label styleClass="ux-inline-b0efc8b395" text="X.509 Self-Signed Certificate Generator"/>

                            <GridPane hgap="10" vgap="8">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="30"/>
                                    <ColumnConstraints percentWidth="70"/>
                                </columnConstraints>

                                <Label text="Common Name (CN):" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="certCNField" promptText="localhost"
                                          GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                <Label text="Organization (O):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="certOrgField" promptText="Crypto Org"
                                          GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                <Label text="Organizational Unit (OU):" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <TextField fx:id="certOUField" promptText="Cybersecurity"
                                          GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                <Label text="Locality (L):" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                <TextField fx:id="certLocalityField" promptText="Madrid"
                                          GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                                <Label text="State (ST):" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                                <TextField fx:id="certStateField" promptText="Madrid"
                                          GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                                <Label text="Country (C):" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                                <TextField fx:id="certCountryField" promptText="ES" maxWidth="60"
                                          GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                                <Label text="Email (optional):" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                                <TextField fx:id="certEmailField" promptText="user@example.com"
                                          GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                                <Separator GridPane.rowIndex="7" GridPane.columnSpan="2"/>

                                <Label text="Validity (days):" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                                <TextField fx:id="certValidityField" text="365" maxWidth="100"
                                          GridPane.rowIndex="8" GridPane.columnIndex="1"/>

                                <Label text="Key Type:" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
                                <ComboBox fx:id="certKeyTypeCombo" prefWidth="150"
                                         GridPane.rowIndex="9" GridPane.columnIndex="1"/>

                                <Label text="Signature Algorithm:" GridPane.rowIndex="10" GridPane.columnIndex="0"/>
                                <ComboBox fx:id="certSignAlgoCombo" prefWidth="200"
                                         GridPane.rowIndex="10" GridPane.columnIndex="1"/>
                            </GridPane>

                            <Button styleClass="ux-inline-85d759bae1" text="Generate Self-Signed Certificate" onAction="#handleGenerateCertificate"
                                    prefWidth="300"/>

                            <Separator/>

                            <Label styleClass="ux-inline-689e8d50bc" text="Certificate Output (PEM + Private Key)"/>
                            <TextArea styleClass="ux-inline-e258d05449" fx:id="certOutputArea" wrapText="true" editable="false"
                                      VBox.vgrow="ALWAYS" prefHeight="400"/>

                            <Label styleClass="ux-inline-5410ad7098" text="⚠️  WARNING: Self-signed certificates are NOT suitable for production use"/>
                        </VBox>
                    </ScrollPane>
                </Tab>

                <!-- TR-31 Key Block Tab -->
                <Tab text="TR-31 Key Block" closable="false">
                    <HBox spacing="0">
                        <!-- LEFT PANEL: Controls -->
                        <ScrollPane fitToWidth="true" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER"
                                    prefWidth="500" minWidth="450" HBox.hgrow="NEVER">
                            <VBox styleClass="ux-inline-8d20c1fddd" spacing="20">

                                <!-- TR-31 EXPORT (WRAP) -->
                                <Label styleClass="ux-inline-9523af0b3b" text="TR-31 EXPORT (WRAP KEY)"/>
                                <VBox spacing="10">
                                    <Label styleClass="ux-inline-da9c4cada5" text="KBPK (Key Block Protection Key):"/>
                                    <TextField styleClass="ux-inline-98b1fbacfd" fx:id="tr31KbpkExportField" promptText="KBPK in hex (16 or 32 bytes)"/>

                                    <Label styleClass="ux-inline-da9c4cada5" text="Key to Wrap:"/>
                                    <TextField styleClass="ux-inline-98b1fbacfd" fx:id="tr31KeyToWrapField" promptText="Key in hex"/>

                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label styleClass="ux-inline-da9c4cada5" text="Version ID:" minWidth="100"/>
                                        <ComboBox styleClass="ux-inline-da9c4cada5" fx:id="tr31VersionCombo" prefWidth="200"/>
                                    </HBox>

                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label styleClass="ux-inline-da9c4cada5" text="Key Usage:" minWidth="100"/>
                                        <ComboBox styleClass="ux-inline-da9c4cada5" fx:id="tr31UsageCombo" prefWidth="200"/>
                                    </HBox>

                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label styleClass="ux-inline-da9c4cada5" text="Algorithm:" minWidth="100"/>
                                        <ComboBox styleClass="ux-inline-da9c4cada5" fx:id="tr31AlgorithmCombo" prefWidth="200"/>
                                    </HBox>

                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label styleClass="ux-inline-da9c4cada5" text="Mode of Use:" minWidth="100"/>
                                        <ComboBox styleClass="ux-inline-da9c4cada5" fx:id="tr31ModeCombo" prefWidth="200"/>
                                    </HBox>

                                    <HBox spacing="10" alignment="CENTER_LEFT">
