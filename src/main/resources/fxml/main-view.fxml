                        </VBox>

                        <Separator />

                        <Label styleClass="ux-inline-689e8d50bc" text="MESSAGE AUTHENTICATION CODES (MAC)" />
                        <VBox spacing="5" styleClass="operation-group">
                            <Label styleClass="ux-inline-0ed0fa4650" text="MAC Algorithm:" />
                            <ComboBox fx:id="authMacAlgorithmCombo" promptText="Select MAC algorithm" maxWidth="Infinity" />

                            <Separator styleClass="ux-inline-94e215a536" />

                            <Label styleClass="ux-inline-0ed0fa4650" text="MAC Key (Hex):" />
                            <TextField fx:id="authMacKeyField" promptText="Enter MAC key in hexadecimal" />
                            <Label styleClass="ux-inline-39414733db" fx:id="authMacKeyInfoLabel" text="Key size depends on algorithm"/>

                            <Separator styleClass="ux-inline-94e215a536" />

                            <VBox styleClass="ux-inline-94e215a536" spacing="8">
                                <Label styleClass="ux-inline-0ed0fa4650" text="Key Components (Optional - for ANSI X9.19):" />
