<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cryptocarver.ui.AuthenticationController"
      managed="false" visible="false" spacing="14" styleClass="content-container-vbox,authentication-module">
    <VBox spacing="12" styleClass="module-pane-content">
        <Label text="1. Data to authenticate" styleClass="form-label" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
        <Label text="Enter the message used to generate or verify the signature/MAC."
               styleClass="helper-text"/>
        <TextArea fx:id="authInputArea" prefHeight="120" wrapText="true"
                  promptText="Enter the message to authenticate..."
                  styleClass="monospace-field" VBox.vgrow="ALWAYS"/>
    </VBox>

    <Accordion styleClass="module-accordion">
        <panes>
            <TitledPane text="🔏 Digital Signatures" expanded="true">
                <VBox spacing="12" styleClass="module-pane-content">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Algorithm:" styleClass="form-label"/>
                        <ComboBox fx:id="signatureAlgorithmCombo" prefWidth="250" styleClass="form-field"/>
                    </HBox>
                    <Separator/>
                    <Label text="Keys (PEM format):" styleClass="form-label"/>
                    <TabPane tabClosingPolicy="UNAVAILABLE" prefHeight="220">
                        <Tab text="Private Key">
                            <VBox spacing="8" styleClass="module-pane-content">
                                <TextArea fx:id="signaturePrivateKeyArea" promptText="Paste Private Key PEM here..."
                                          wrapText="true" styleClass="monospace-field" VBox.vgrow="ALWAYS"/>
                                <Button text="Load Private Key..." onAction="#handleLoadSignPrivateKey"
                                        styleClass="secondary-button" maxWidth="Infinity"/>
                            </VBox>
                        </Tab>
                        <Tab text="Public Key">
                            <VBox spacing="8" styleClass="module-pane-content">
                                <TextArea fx:id="signaturePublicKeyArea" promptText="Paste Public Key PEM here..."
                                          wrapText="true" styleClass="monospace-field" VBox.vgrow="ALWAYS"/>
                                <Button text="Load Public Key..." onAction="#handleLoadSignPublicKey"
                                        styleClass="secondary-button" maxWidth="Infinity"/>
                            </VBox>
                        </Tab>
                    </TabPane>
                    <Label fx:id="signatureKeyStatusLabel" text="Ready to sign/verify"
                           styleClass="helper-text"/>
                    <Separator/>
                    <Button text="Sign" onAction="#handleSign"
                            styleClass="action-button,primary-action" maxWidth="200"/>
                    <Separator/>
                    <Label text="Verify Signature:" styleClass="form-label"/>
                    <TextField fx:id="signatureVerifyField"
                               promptText="Paste signature to verify (Format must match 'Output Format' selection)"
                               styleClass="form-field" maxWidth="Infinity"/>
                    <Button text="Verify Signature" onAction="#handleVerify"
                            styleClass="action-button,primary-action" maxWidth="200"/>
                    <Label text="ℹ️ Sign: data in Input → signature in Output"
                           styleClass="helper-text"/>
                </VBox>
            </TitledPane>

            <TitledPane text="🔐 Message Authentication Codes (MAC)">
                <VBox spacing="12" styleClass="module-pane-content">
                    <Label text="2. MAC configuration" styleClass="form-label" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <HBox spacing="12" alignment="BOTTOM_LEFT">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Algorithm" styleClass="form-label"/>
                            <ComboBox fx:id="authMacAlgorithmCombo" maxWidth="Infinity" styleClass="form-field"/>
                        </VBox>
                        <VBox spacing="4" prefWidth="190">
                            <Label text="Output length" styleClass="form-label"/>
                            <ComboBox fx:id="authMacTruncationCombo" maxWidth="Infinity" styleClass="form-field"/>
                        </VBox>
                    </HBox>
                    <Label fx:id="authMacAlgorithmInfoLabel" wrapText="true" styleClass="helper-text"/>
                    <Label fx:id="authMacWarningLabel" wrapText="true" managed="false" visible="false"
                           styleClass="helper-text" style="-fx-text-fill: #c0392b; -fx-font-weight: bold;"/>
                    <VBox spacing="10" styleClass="module-pane-content" style="-fx-background-color: #f7f9fb; -fx-border-color: #d7dee5; -fx-border-radius: 4;">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Key material" styleClass="form-label"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <ComboBox fx:id="macKeySourceCombo" prefWidth="180" styleClass="form-field"/>
                            <Button text="Save key to Lab" onAction="#handleSaveMacKeyToHsm"
                                    styleClass="secondary-button"/>
                        </HBox>
                        <StackPane>
                            <TextField fx:id="authMacKeyField" promptText="Enter MAC key in hexadecimal"
                                       styleClass="monospace-field,form-field" maxWidth="Infinity"/>
                            <ComboBox fx:id="macHsmKeyCombo" maxWidth="Infinity" visible="false"
                                      managed="false" styleClass="form-field"/>
                        </StackPane>
                        <Label fx:id="authMacKeyInfoLabel" text="Key size depends on algorithm"
                               styleClass="helper-text"/>
                        <VBox fx:id="authMacNonceGroup" spacing="6" managed="false" visible="false">
                            <Label text="GMAC nonce / IV (hexadecimal)" styleClass="form-label"/>
                            <TextField fx:id="authMacNonceField" promptText="12 unique bytes, e.g. 00112233445566778899AABB"
                                       styleClass="monospace-field,form-field" maxWidth="Infinity"/>
                        </VBox>
                    </VBox>
                    <GridPane hgap="12" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>
                        <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Generate" styleClass="form-label"/>
                            <Button text="Generate MAC" onAction="#handleGenerateMAC"
                                    styleClass="action-button,primary-action" maxWidth="Infinity"/>
                            <Label text="Writes the MAC to Result below." styleClass="helper-text"/>
                        </VBox>
                        <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Verify an existing MAC" styleClass="form-label"/>
                            <HBox spacing="6">
                                <TextField fx:id="authMacVerifyField" promptText="Paste the expected MAC"
                                           styleClass="monospace-field,form-field"
                                           HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Button text="Verify" onAction="#handleVerifyMAC"
                                        styleClass="secondary-button" minWidth="90"/>
                            </HBox>
                            <Label text="Uses the same message, algorithm, key and output length."
                                   styleClass="helper-text"/>
                        </VBox>
                    </GridPane>
                </VBox>
            </TitledPane>
        </panes>
    </Accordion>

    <VBox spacing="8" styleClass="module-pane-content">
        <Label text="3. Result" styleClass="form-label" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
        <TextArea fx:id="authOutputArea" prefHeight="130" editable="false" wrapText="true"
                  promptText="The generated value or verification result will appear here."
                  styleClass="result-area,monospace-field"/>
    </VBox>
</VBox>
