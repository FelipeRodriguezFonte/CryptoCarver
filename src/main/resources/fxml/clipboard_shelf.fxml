<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox fx:id="clipboardShelfRoot" spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cryptocarver.ui.ClipboardShelfController"
      VBox.vgrow="ALWAYS"
      stylesheets="@../css/styles.css">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Clipboard Shelf / Laboratory Notebook" styleClass="header-label"/>
    <Label text="Stores, tags, annotates and compares results generated or copied during this session." wrapText="true" styleClass="description-label"/>

    <FlowPane hgap="10" vgap="8" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Search label, operation, tag, note..." prefWidth="220"/>
        <ComboBox fx:id="pinnedFilterCombo" promptText="All (Pinned &amp; Unpinned)" prefWidth="150"/>
        <ComboBox fx:id="sourceFilterCombo" promptText="All Operations" prefWidth="150"/>
        <ComboBox fx:id="formatFilterCombo" promptText="Any Format" prefWidth="120"/>
        <ComboBox fx:id="classFilterCombo" promptText="Any Classification" prefWidth="140"/>
        <Label fx:id="itemCountLabel" text="0 / 100 items" style="-fx-text-fill: #7f8c8d;"/>
        <Button text="Open Copy Window" onAction="#handleOpenClipboardWindow"/>
        <Button text="Clear Shelf" onAction="#handleClearShelf" styleClass="button, danger-button"/>
    </FlowPane>

    <SplitPane orientation="VERTICAL" VBox.vgrow="ALWAYS" dividerPositions="0.6">
        <TableView fx:id="shelfTable" VBox.vgrow="ALWAYS">
            <placeholder>
                <Label text="No saved laboratory results yet" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="pinCol" text="📌" prefWidth="35"/>
                <TableColumn fx:id="dateCol" text="Time" prefWidth="100"/>
                <TableColumn fx:id="labelCol" text="Label" prefWidth="140"/>
                <TableColumn fx:id="sourceCol" text="Source" prefWidth="130"/>
                <TableColumn fx:id="algCol" text="Algorithm" prefWidth="90"/>
                <TableColumn fx:id="formatCol" text="Format" prefWidth="75"/>
                <TableColumn fx:id="classCol" text="Class" prefWidth="75"/>
                <TableColumn fx:id="tagsCol" text="Tags" prefWidth="110"/>
                <TableColumn fx:id="previewCol" text="Preview" prefWidth="250"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <FlowPane prefWrapLength="950" hgap="8" vgap="8" styleClass="responsive-action-bar">
                <Label text="Entry Details" style="-fx-font-weight: bold;"/>
                <Label fx:id="warningLabel" text="⚠️ Contains sensitive data" style="-fx-text-fill: #e67e22;" visible="false"/>
                <Button fx:id="pinBtn" text="Pin" onAction="#handleTogglePin" disable="true"/>
                <Button fx:id="editTagsNoteBtn" text="Edit Note &amp; Tags" onAction="#handleEditTagsNote" disable="true"/>
                <Button fx:id="compareBtn" text="Compare..." onAction="#handleCompare" disable="true"/>
                <MenuButton fx:id="useInMenu" text="Use in..." disable="true">
                    <!-- Items populated dynamically -->
                </MenuButton>
                <Button fx:id="copyBtn" text="Copy" onAction="#handleCopy" disable="true"/>
                <Button fx:id="expandBtn" text="Open Expanded" onAction="#handleOpenExpanded" disable="true"/>
                <Button fx:id="renameBtn" text="Rename" onAction="#handleRename" disable="true"/>
                <Button fx:id="deleteBtn" text="Delete" onAction="#handleDelete" disable="true" styleClass="button, danger-button"/>
            </FlowPane>
            <TextArea fx:id="detailsArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS" style="-fx-font-family: monospace;"/>
        </VBox>
    </SplitPane>
</VBox>
